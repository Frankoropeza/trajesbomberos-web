---
import { responsive, SIZES } from '@lib/img';
// PostLayout (artículo del blog).
// Jerarquía canónica: BaseLayout → PageLayout → PostLayout, la
// misma que ProductLayout. Estructura: hero → franja →
// [artículo + sidebar sticky] → relacionados → CTA de cierre.
// El JSON-LD de Article NO se emite aquí: se arma y se pasa a
// PageLayout, que lo entrega a BaseLayout (regla B3, emisor único).
import { render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PostCard from '@components/PostCard.astro';
import BlogSidebar from '@components/BlogSidebar.astro';
import EnlaceDirectorio from '@components/directorio/EnlaceDirectorio.astro';
import { SITE, WA_MESSAGES, blogCategoria } from '@config/site';
import { familiaPorSlug } from '@lib/familias';
import { PRESET_CONTACTO } from '@lib/cta-presets';
import { waUrl } from '@lib/wa';
import { HERO_GENERICO } from '@lib/imagenes';
import {
  type Post,
  postUrl,
  categoriaUrl,
  categoriaNombre,
  relatedPosts,
  getPosts,
  readingTime,
  wordCount,
} from '@lib/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
// Guías de compra institucional que cierran con el directorio de estaciones (B2B).
const ENLACE_DIRECTORIO_POSTS = new Set(['licitacion-trajes-bomberos-expediente', 'equipar-bomberos-voluntarios-compra-por-pieza', 'equipo-de-bombero-completo', 'cuanto-cuesta-un-traje-de-bombero', 'vida-util-traje-bombero-nfpa-1850', 'nfpa-1970-que-cambio']);
const d = post.data;

const { Content, headings } = await render(post);
const path = postUrl(post);
const url = new URL(path, SITE.url).href;
const lectura = readingTime(post.body);
const palabras = wordCount(post.body);
const cat = blogCategoria(d.categoria);
// Enlazado interno: el sidebar («Más guías de {categoría}») y el
// módulo final («Artículos relacionados», 4 fichas) no repiten
// guías. `relacionadosSidebar` conserva el relleno de 3 que ya
// recibía el sidebar; `enSidebar` replica su regla (misma
// categoría primero, luego ese relleno, máximo 4) y el módulo
// final toma las 4 siguientes del ranking de `relatedPosts`.
// DECISIÓN DE FRANK (2026-09-29): el módulo final son 4 fichas en
// una fila de 4 (como TileGrid del index). No volver a 3 por fila.
const ranking = await relatedPosts(post, Number.POSITIVE_INFINITY);
const relacionadosSidebar = ranking.slice(0, 3);
const mismaCategoria = (await getPosts()).filter(
  (p) => p.id !== post.id && p.data.categoria === d.categoria,
);
const enSidebar = new Set(
  [...new Set([...mismaCategoria, ...relacionadosSidebar].map((p) => p.id))].slice(0, 4),
);
const relacionados = [
  ...ranking.filter((p) => !enSidebar.has(p.id)),
  ...ranking.filter((p) => enSidebar.has(p.id)),
].slice(0, 4); // una fila de 4 que no repite lo del sidebar
const waMsg = WA_MESSAGES.articulo(d.title);

// Franja de secciones del artículo: los h2 reales (sin fuentes ni FAQ),
// recortados en palabra completa para que quepan en una línea.
const corto = (t: string, max = 32) => (t.length <= max ? t : `${t.slice(0, t.lastIndexOf(' ', max))}…`);
const menuItems = [
  ...headings
    .filter((heading) => heading.depth === 2 && !/^(fuentes|preguntas frecuentes)/i.test(heading.text))
    .slice(0, 3)
    .map((heading) => ({ label: corto(heading.text), href: `#${heading.slug}` })),
  ...(relacionados.length > 0 ? [{ label: 'Guías relacionadas de trajes', href: '#relacionados' }] : []),
];

// Datos duros del hero: si el artículo no los declara, se arma
// uno con categoría y tiempo de lectura. Blog atemporal: ninguna
// fecha visible ni en schema (decisión de Frank, 2026-09-29).
const heroMeta = d.meta.length
  ? d.meta
  : [categoriaNombre(d.categoria), `${lectura} min de lectura`];

const article = {
  headline: d.title,
  description: d.description,
  url,
  section: categoriaNombre(d.categoria),
  keywords: d.keywords,
  wordCount: palabras,
  image: new URL(d.imagen ?? HERO_GENERICO.src, SITE.url).href,
};
---
<PageLayout
  pageType="articulo"
  path={path}
  title={d.seoTitle}
  description={d.description}
  keywords={d.keywords}
  menuItems={menuItems}
  crumbLabel={d.title}
  parent={{ name: 'Blog técnico de bomberos', href: '/blog/' }}
  eyebrow={d.eyebrow ?? `Blog · ${categoriaNombre(d.categoria)}`}
  h1={d.title}
  h1Accent={d.titleAccent}
  lead={d.lead}
  descRight={d.descRight}
  meta={heroMeta}
  article={article}
  heroImage={d.imagen ? { src: d.imagen, alt: d.imagenAlt ?? '' } : HERO_GENERICO}
  ogImage={`/images/og/blog-${post.id}.jpg`}
  footerCta={{ title: PRESET_CONTACTO.title, text: PRESET_CONTACTO.text, secondary: { label: 'Blog técnico de trajes para bomberos', href: '/blog/' } }}
>
  <div class="reading-progress-global" aria-hidden="true"><span data-reading-progress-global></span></div>
  <div class="section">
    <div class="container layout-grid layout-grid--post">
      <div class="layout-main">
        <article id="articulo" class="post">
          <!-- Ficha del artículo: categoría, lectura y quién responde por esto (sin fechas: blog atemporal) -->
          <div class="post__bar">
            <a class="post__cat" href={categoriaUrl(d.categoria)}>{categoriaNombre(d.categoria)}</a>
            <span class="post__dot" aria-hidden="true">·</span>
            <span class="post__dato">{lectura} min de lectura</span>
            <span class="post__dot" aria-hidden="true">·</span>
            <span class="post__dato">{d.autor}</span>
          </div>

          {d.imagen && (
            <figure class="post__cover">
              <img src={d.imagen} {...responsive(d.imagen, SIZES.cover)} alt={d.imagenAlt ?? ''} width="1600" height="686" fetchpriority="high" decoding="async" />
              {d.imagenAlt && <figcaption>{d.imagenAlt}</figcaption>}
            </figure>
          )}

          <div class="prose">
            <Content />
          </div>

          {ENLACE_DIRECTORIO_POSTS.has(post.id) && <EnlaceDirectorio />}

          <!-- Cierre del artículo: a dónde va el lector que ya leyó
               (duda → WhatsApp) y quién responde por el contenido. -->
          <div class="post__fin">
          <div class="post__cierre">
            <p class="post__cierre-t">¿Te quedó una duda sobre lo que acabas de leer?</p>
            <p class="post__cierre-p">
              Escríbenos y te la contestamos con la ficha técnica en la mano. Si tu compra es por
              licitación, pide el expediente completo desde el primer mensaje.
            </p>
            <div class="post__cierre-cta">
              <a class="btn btn--wa" href={waUrl(waMsg)} target="_blank" rel="noopener nofollow">
                Preguntar por equipo para bomberos en WhatsApp
              </a>
              {d.familia && (
                <a class="btn btn--ghost" href={`/trajes/${d.familia}/`}>Cotizar {familiaPorSlug(d.familia)?.nombreWa.toLowerCase() ?? 'trajes para bomberos'}</a>
              )}
            </div>
          </div>
          <aside class="post__author" aria-label="Autoría">
            <p class="post__author-name">Equipo técnico LORICA</p>
            <p>Especialistas en trajes y equipo para bomberos con más de 35 años de experiencia y presencia en los 32 estados.</p>
            <p>Cada guía se contrasta con la norma citada y con la ficha técnica del fabricante.</p>
            <a href="/empresa/">Empresa de trajes para bomberos →</a>
          </aside>
          </div>
        </article>
      </div>

      <BlogSidebar
        variant="articulo"
        headings={headings}
        currentId={post.id}
        currentCategoria={d.categoria}
        post={post}
        relatedPosts={relacionadosSidebar}
        waMessage={waMsg}
      />
    </div>
  </div>

  {relacionados.length > 0 && (
    <section class="section section--alt" id="relacionados">
      <div class="container">
        <SectionHeading clave="relacionados"
          eyebrow="Seguir leyendo"
          title="Artículos relacionados"
          description={cat ? cat.desc : undefined}
        />
        <div class="related-grid" data-post-grid>
          {relacionados.map((p, i) => (
            <PostCard
              href={postUrl(p)}
              title={p.data.title}
              resumen={p.data.resumen}
              categoria={p.data.categoria}
              lectura={readingTime(p.body)}
              image={p.data.imagen}
              imageAlt={p.data.imagenAlt}
              destacado={p.data.destacado}
              ancla={p.data.ancla}
              index={i}
            />
          ))}
        </div>
        <p class="volver"><a href="/blog/">← Blog técnico de trajes para bomberos</a></p>
      </div>
    </section>
  )}

</PageLayout>

<style>
  /* Homologado con las páginas L2/L3 (familias, piezas): contenedor
     a todo el ancho, columna principal + sidebar de 280px al borde.
     Para que el texto no se lea a 1000px, el cuerpo se arma como el
     resto del sitio: cada H2 a la izquierda (con numeración tipo
     eyebrow) y su contenido a la derecha, con medida de lectura.
     La consulta mide el <article> (contenedor «post»). */
  .layout-grid--post :global(.prose),
  .post__cierre { max-width: none; }
  .post { min-width: 0; container: post / inline-size; }

  @container post (min-width: 760px) {
    .post :global(.prose) {
      display: grid;
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.5fr);
      column-gap: clamp(2rem, 4vw, 4.5rem);
      counter-reset: sec;
    }
    .post :global(.prose > *) { grid-column: 2; }
    /* Introducción (lo que va antes del primer H2): a todo el ancho, como lead */
    .post :global(.prose > :not(h2):not(h2 ~ *)) {
      grid-column: 1 / -1;
      max-width: 80ch;
      font-size: var(--fs-lead);
      color: var(--color-dark);
    }
    .post :global(.prose > h2) {
      grid-column: 1;
      position: relative;
      align-self: start;
      margin: 4.6rem 0 0;
      padding: 0;
      border: 0;
      counter-increment: sec;
      text-wrap: balance;
    }
    /* Separador de sección a todo el ancho del artículo */
    .post :global(.prose > h2::after) {
      content: '';
      position: absolute;
      top: -2.2rem;
      left: 0;
      width: 100cqw;
      border-top: var(--border);
    }
    .post :global(.prose > h2 + *) { margin-top: 4.6rem; }
    .post :global(.prose > h2:first-child),
    .post :global(.prose > h2:first-child + *) { margin-top: 0; }
    .post :global(.prose > h2:first-child::after) { display: none; }
  }
  /* Número de sección con el lenguaje del eyebrow (raya roja + versalitas) */
  .post :global(.prose > h2::before) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    content: 'Sección ' counter(sec, decimal-leading-zero);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
    padding-left: calc(26px + 0.6rem);
    background: linear-gradient(var(--color-primary), var(--color-primary)) left center / 26px 3px no-repeat;
  }
  .post :global(.prose) { counter-reset: sec; }
  .post :global(.prose > h2) { counter-increment: sec; }

  .post__fin {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 4vw, 3.6rem);
  }
  @container post (min-width: 760px) {
    .post__fin { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: stretch; }
  }
  .reading-progress-global { position: fixed; z-index: 40; top: 0; left: 0; width: 100%; height: 3px; background: transparent; }
  .reading-progress-global span { display: block; width: 0; height: 100%; background: var(--color-primary); }

  .post__bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding-bottom: 1.1rem;
    border-bottom: var(--border);
    font-size: 0.78rem;
    color: var(--color-gray);
    font-weight: 600;
  }
  .post__cat {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.75rem;
  }
  .post__cat:hover { text-decoration: underline; }
  .post__dot { color: var(--color-gray-light); }

  .post__cierre {
    margin: 0;
    padding: clamp(1.5rem, 2.4vw, 2.2rem);
    background: var(--color-light);
    border: var(--border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
  }
  .post__cover { margin: 0 0 2rem; }
  .post__cover img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border: var(--border); border-radius: var(--radius-lg); }
  .post__cover figcaption { margin-top: 0.55rem; color: var(--color-gray); font-size: 0.8rem; line-height: 1.45; }
  .post__cierre-t { margin: 0 0 0.4rem; font-weight: 800; font-size: 1.05rem; }
  .post__cierre-p { margin: 0 0 1.2rem; color: var(--color-gray); font-size: 0.92rem; }
  .post__cierre-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .post__author { margin: 0; padding: 1.25rem 1.35rem; border: var(--border); border-left: 3px solid var(--color-primary); border-radius: var(--radius-lg); background: var(--color-white); color: var(--color-gray); font-size: var(--fs-sm); line-height: 1.55; }
  .post__author p { margin: 0.35rem 0; }
  .post__author-name { color: var(--color-dark); font-weight: 800; }
  .post__author a { display: inline-block; margin-top: 0.35rem; color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .related-grid { display: grid; grid-template-columns: 1fr; gap: var(--gap-grid); }
  /* Relacionados: 4 fichas en fila de 4 (decisión de Frank 2026-09-29),
     mismos cortes que TileGrid del index. El listado del blog sigue en 3. */
  @media (min-width: 640px) { .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .related-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .volver { margin: 2.2rem 0 0; }
  .volver a { font-weight: 800; text-decoration: none; }
  .volver a:hover { text-decoration: underline; }
</style>

<script>
  const articleForProgress = document.getElementById('articulo');
  const reduceProgressMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (articleForProgress && !reduceProgressMotion) {
    const globalBar = document.querySelector<HTMLElement>('[data-reading-progress-global]');
    let pending = false;
    const updateProgress = () => {
      pending = false;
      const rect = articleForProgress.getBoundingClientRect();
      const range = Math.max(1, articleForProgress.offsetHeight - window.innerHeight * 0.45);
      const percent = Math.min(100, Math.max(0, (-rect.top + window.innerHeight * 0.2) / range * 100));
      if (globalBar) globalBar.style.width = `${percent}%`;
    };
    const requestProgress = () => { if (!pending) { pending = true; requestAnimationFrame(updateProgress); } };
    window.addEventListener('scroll', requestProgress, { passive: true });
    window.addEventListener('resize', requestProgress, { passive: true });
    requestProgress();
  }
</script>
