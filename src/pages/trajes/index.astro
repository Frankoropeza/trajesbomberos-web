---
// L2 · /trajes/ — plantilla CategoriaL2 (ver src/components/l2/CategoriaL2.astro).
// Texto: src/content/categorias/trajes.md. Módulos «a fondo»: texto e imágenes de
// FAMILIAS + escena de HERO_POR_FAMILIA; puntos y leyendas del .md.
import { getEntry, render } from 'astro:content';
import CategoriaL2 from '@components/l2/CategoriaL2.astro';
import { SITE, WA_MESSAGES } from '@config/site';
import { tilesFamilias, tileConjunto, ctaFamilia } from '@lib/catalogo/tiles';
import { MODELOS, urlModelo } from '@lib/catalogo/modelos';
import { FAMILIAS } from '@lib/familias';
import { heroDeFamilia } from '@lib/imagenes';
import { waUrl } from '@lib/wa';
import { spotlightDeModulo, filaModelo, guiasL2 } from '@lib/l2';

const entrada = await getEntry('categorias', 'trajes');
if (!entrada) throw new Error('Falta la entrada de contenido categorias/trajes.');
const { Content } = await render(entrada);
const d = entrada.data;
const tiles = [...tilesFamilias(), tileConjunto(tilesFamilias().length + 1)];
const modelos = MODELOS.filter((m) => m.seccion === 'trajes');
const NOMBRE_COTIZAR: Record<string, string> = { extricacion: 'Trajes de extricación', hazmat: 'Trajes Hazmat' };
const spotlights = FAMILIAS.map((f, index) => {
  const modulo = d.modulos.find((m) => m.slug === f.slug);
  if (!modulo) throw new Error(`Falta contenido para la familia ${f.slug}.`);
  const escena = heroDeFamilia(f.slug);
  const [producto1, producto2] = f.images;
  const nombre = NOMBRE_COTIZAR[f.slug] ?? f.nombreWa;
  return spotlightDeModulo(modulo, index, {
    eyebrow: f.eyebrow,
    titulo: f.title,
    parrafos: [f.description],
    cta: { label: ctaFamilia(f.slug), href: `/trajes/${f.slug}/` },
    wa: { label: `Cotizar ${nombre.replace(/^Trajes/, 'trajes')}`, href: waUrl(WA_MESSAGES.categoria(nombre)) },
    imagenes: [escena, producto1, producto2],
  });
});
const columnas = ['modelo', 'familia', 'capa', 'barreras', 'norma', 'estatus'] as const;
const filasModelos = modelos.map((modelo) => filaModelo(modelo, columnas));
const directoryItems = [
  ...tilesFamilias().map((tile) => ({ name: tile.titulo, url: `${SITE.url}${tile.href}` })),
  ...modelos.map((m) => ({ name: `${m.marca} ${m.nombre}`, url: `${SITE.url}${urlModelo(m)}` })),
];
const guias = await guiasL2(d);
---
<CategoriaL2 {d} {tiles} {spotlights} {modelos} {filasModelos} {directoryItems} {guias}><Content /></CategoriaL2>
