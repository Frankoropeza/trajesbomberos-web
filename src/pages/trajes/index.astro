---
// L2 · /trajes/ — primera categoría homologada con la home (L1), 2026-09-29.
// Plantilla L2: hero sólido → franja de secciones → tipos (TileGrid) → cómo elegir
// (L2Guia + cuerpo Markdown con H3/H4) → familias a fondo (CategorySpotlight, H3) →
// banda de foto → modelos (ModelosGrid) → comparativas (RiskGuide ×2) → FAQ con
// formulario de WhatsApp → guías del blog (4 fichas) → QuoteCTA → footer.
// Texto editorial: src/content/categorias/trajes.md (esquema estricto). Datos de
// catálogo (familias, modelos, estatus normativo): sus fuentes en src/lib/.
import { getEntry, render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TileGrid from '@components/home/TileGrid.astro';
import TileCard from '@components/home/TileCard.astro';
import CategorySpotlight from '@components/home/CategorySpotlight.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import RiskGuide from '@components/RiskGuide.astro';
import PhotoBand from '@components/PhotoBand.astro';
import ModelosGrid from '@components/ModelosGrid.astro';
import PostCard from '@components/PostCard.astro';
import QuoteCTA from '@components/home/QuoteCTA.astro';
import L2Guia from '@components/l2/L2Guia.astro';
import { PRESET_CONTACTO } from '@lib/cta-presets';
import { SITE, WA_MESSAGES } from '@config/site';
import { tilesFamilias, tileConjunto, ctaFamilia, estadoModelo } from '@lib/catalogo/tiles';
import { MODELOS, urlModelo } from '@lib/catalogo/modelos';
import { FAMILIAS } from '@lib/familias';
import { heroDeFamilia } from '@lib/imagenes';
import { dimensiones } from '@lib/img';
import { waUrl } from '@lib/wa';
import { guiasParaRuta, postUrl, readingTime } from '@lib/blog';
import type { SpotProps } from '@lib/spotlights/types';

const entrada = await getEntry('categorias', 'trajes');
if (!entrada) throw new Error('Falta la entrada de contenido categorias/trajes.');
const { Content } = await render(entrada);
const d = entrada.data;
const modelos = MODELOS.filter((m) => m.seccion === 'trajes');
const guias = await guiasParaRuta(d.ruta, 4);
const menuItems = [
  { label: 'Tipos de traje de bombero', href: '#tipos' },
  { label: 'Cómo elegir un traje', href: '#elegir' },
  { label: 'Familias a fondo', href: '#familias' },
  { label: 'Modelos de trajes de bombero', href: '#modelos' },
  { label: 'Comparativa de trajes', href: '#comparar' },
  { label: 'Preguntas sobre trajes', href: '#faq' },
  { label: 'Guías de trajes para bomberos', href: '#guias' },
];
const directoryItems = [
  ...tilesFamilias().map((tile) => ({ name: tile.titulo, url: `${SITE.url}${tile.href}` })),
  ...modelos.map((m) => ({ name: `${m.marca} ${m.nombre}`, url: `${SITE.url}${urlModelo(m)}` })),
];
const familiaSlug: Record<string, string> = {
  Estructural: 'estructural', Brigadista: 'brigadista', Forestal: 'forestal', Aproximación: 'aproximacion',
  Entrada: 'entrada', Extricación: 'extricacion', Hazmat: 'hazmat',
};
const familiaRows = d.comparativaFamilias.filas.map(([familia, ...celdas]) => [
  { texto: familia, href: `/trajes/${familiaSlug[familia]}/` },
  ...celdas,
]);
// Familias a fondo: mismo módulo spotlight que la home (CategorySpotlight), con H3
// porque cuelga del H2 de la sección. Texto de FAMILIAS (SSoT de L1/L2/L3), escena de
// HERO_POR_FAMILIA y puntos/leyendas del .md de la categoría.
const medidas = (src: string) => dimensiones(src) ?? { width: 1000, height: 1250 };
// Nombre de la familia en botón y mensaje de WhatsApp cuando `nombreWa` no dice «trajes».
const NOMBRE_COTIZAR: Record<string, string> = { extricacion: 'Trajes de extricación', hazmat: 'Trajes Hazmat' };
const spotlights: SpotProps[] = FAMILIAS.map((f, index) => {
  const x = d.familias.find((familia) => familia.slug === f.slug);
  if (!x) throw new Error(`Falta contenido para la familia ${f.slug}.`);
  const escena = heroDeFamilia(f.slug);
  const [producto1, producto2] = f.images;
  return {
    id: `familia-${f.slug}`,
    numero: String(index + 1).padStart(2, '0'),
    eyebrow: f.eyebrow,
    titulo: f.title,
    parrafos: [f.description],
    puntos: x.puntos,
    cta: { label: ctaFamilia(f.slug), href: `/trajes/${f.slug}/` },
    wa: {
      label: `Cotizar ${(NOMBRE_COTIZAR[f.slug] ?? f.nombreWa).replace(/^Trajes/, 'trajes')}`,
      href: waUrl(WA_MESSAGES.categoria(NOMBRE_COTIZAR[f.slug] ?? f.nombreWa)),
    },
    imagenes: [
      { ...escena, ...medidas(escena.src), caption: x.leyendas[0] },
      { ...producto1, ...medidas(producto1.src), caption: x.leyendas[1], pos: 'center 18%' },
      { ...producto2, ...medidas(producto2.src), caption: x.leyendas[2], pos: 'center 18%' },
    ],
    nivel: 3,
  };
});

const pendiente = 'Se confirma al cotizar';
const modeloRows = modelos.map((m) => {
  const familia = FAMILIAS.find((f) => f.slug === m.familia);
  return [
    { texto: `${m.marca} ${m.nombre}`, href: urlModelo(m) },
    familia?.nombreWa ?? pendiente,
    m.capaExterior ?? m.material ?? pendiente,
    m.barreras ?? pendiente,
    m.norma ?? pendiente,
    estadoModelo(m).label,
  ];
});
---
<PageLayout
  pageType="directorio"
  path={d.ruta}
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  menuItems={menuItems}
  crumbLabel={d.crumb}
  eyebrow={d.hero.eyebrow}
  h1={d.hero.h1}
  h1Accent={d.hero.h1Accent}
  lead={d.hero.lead}
  descRight={d.hero.descRight}
  meta={d.hero.meta}
  faqs={d.faqs}
  directoryItems={directoryItems}
  collection={{ name: `${d.hero.h1} ${d.hero.h1Accent ?? ''}`.trim(), description: d.seo.description, url: d.ruta }}
  footerCta={{ title: PRESET_CONTACTO.title, text: PRESET_CONTACTO.text, secondary: { label: 'Blog técnico de trajes para bomberos', href: '/blog/' } }}
>
  <section class="section" id="tipos"><div class="container">
    <SectionHeading eyebrow={d.secciones.tipos.eyebrow} title={d.secciones.tipos.titulo} duo={d.secciones.tipos.duo} />
    <TileGrid>{[...tilesFamilias(), tileConjunto(tilesFamilias().length + 1)].map((tile) => <TileCard {...tile} />)}</TileGrid>
  </div></section>
  <section class="section section--alt" id="elegir"><div class="container">
    <SectionHeading eyebrow={d.secciones.elegir.eyebrow} title={d.secciones.elegir.titulo} duo={d.secciones.elegir.duo} />
    <L2Guia conjunto={d.conjunto}><Content /></L2Guia>
  </div></section>
  <section class="section" id="familias"><div class="container">
    <SectionHeading eyebrow={d.secciones.familias.eyebrow} title={d.secciones.familias.titulo} duo={d.secciones.familias.duo} />
    {spotlights.map((spot) => <CategorySpotlight {...spot} />)}
  </div></section>
  <PhotoBand src={d.fotoBanda.src} alt={d.fotoBanda.alt} width={d.fotoBanda.width} heightPx={d.fotoBanda.height} caption={d.fotoBanda.caption} />
  <section class="section" id="modelos"><div class="container">
    <SectionHeading eyebrow={d.secciones.modelos.eyebrow} title={d.secciones.modelos.titulo} duo={d.secciones.modelos.duo} /><ModelosGrid />
  </div></section>
  <section class="section section--alt" id="comparar"><div class="container">
    <SectionHeading eyebrow={d.secciones.comparar.eyebrow} title={d.secciones.comparar.titulo} duo={d.secciones.comparar.duo} />
    <div class="comparison-block"><h3>{d.comparativaFamilias.titulo}</h3><RiskGuide columns={d.comparativaFamilias.columnas} rows={familiaRows} note={d.comparativaFamilias.nota} caption={d.comparativaFamilias.caption} ariaLabel={d.comparativaFamilias.caption} sinCta /></div>
    <div class="comparison-block comparison-block--modelos"><h3>{d.comparativaModelos.titulo}</h3><RiskGuide columns={['Modelo', 'Familia', 'Capa exterior o material', 'Barreras', 'Norma de referencia declarada', 'Estatus normativo']} rows={modeloRows} note={d.comparativaModelos.nota} caption={d.comparativaModelos.caption} ariaLabel={d.comparativaModelos.caption} ctaLabel={d.comparativaModelos.wa.label} waMensaje={d.comparativaModelos.wa.mensaje} /></div>
  </div></section>
  <section class="section" id="faq"><div class="container">
    <SectionHeading eyebrow={d.secciones.faq.eyebrow} title={d.secciones.faq.titulo} duo={d.secciones.faq.duo} /><FAQWithContact items={d.faqs} asunto={d.contacto.asunto} boton={d.contacto.boton} />
  </div></section>
  <section class="section section--alt" id="guias"><div class="container">
    <SectionHeading eyebrow={d.secciones.guias.eyebrow} title={d.secciones.guias.titulo} duo={d.secciones.guias.duo} />
    <div class="grid-cards grid-cards--4">{guias.map((a, index) => <PostCard href={postUrl(a)} title={a.data.title} resumen={a.data.resumen} categoria={a.data.categoria} lectura={readingTime(a.body)} image={a.data.imagen} imageAlt={a.data.imagenAlt} destacado={a.data.destacado} ancla={a.data.ancla} {index} />)}</div>
    <p class="blog-cta"><a href="/blog/">Blog técnico de trajes para bomberos: todas las guías →</a></p>
  </div></section>
  <QuoteCTA id="cotizar" titulo={d.cotizar.titulo} boton={d.cotizar.boton} mensaje={d.cotizar.mensaje} />
</PageLayout>
<style>
  /* Mismo ritmo que CategorySpotlights de la home: separador entre módulos. */
  #familias :global(.spot + .spot) {
    margin-top: var(--section-y);
    padding-top: var(--section-y);
    border-top: var(--border);
  }
  .comparison-block h3 { margin: 0 0 1rem; font-family: var(--font-display); font-size: 1.3rem; }
  .comparison-block--modelos { margin-top: 3rem; }
  /* Enlace de cierre del blog: idéntico a la home. */
  .blog-cta { margin: 2.2rem 0 0; }
  .blog-cta a { font-weight: 800; text-decoration: none; font-size: 1.02rem; }
  .blog-cta a:hover { text-decoration: underline; }
</style>
