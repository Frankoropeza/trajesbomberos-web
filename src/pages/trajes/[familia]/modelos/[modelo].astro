---
import type { GetStaticPaths } from 'astro';
import ModeloFicha from '@components/ModeloFicha.astro';
import { MODELOS, modelosDeFamilia } from '@lib/catalogo/modelos';
import { FAMILIAS } from '@lib/familias';
import { heroDeFamilia } from '@lib/imagenes';
import type { Seccion } from '@lib/catalogo/types';

export const getStaticPaths = (() => MODELOS.filter((modelo) => modelo.familia).map((modelo) => ({ params: { familia: modelo.familia!, modelo: modelo.id } }))) satisfies GetStaticPaths;
const { familia: familiaSlug, modelo: modeloId } = Astro.params;
const familia = FAMILIAS.find((item) => item.slug === familiaSlug);
const entry = modelosDeFamilia(familiaSlug!).find((item) => item.id === modeloId);
if (!familia || !entry) throw new Error('Modelo no encontrado');
const seccion: Seccion = { slug: 'trajes', nombre: 'Trajes' };
const path = `/trajes/${familia.slug}/modelos/${entry.id}/`;
---
<ModeloFicha {seccion} entry={entry} kind="modelo" {path} parent={[{ name: 'Trajes', href: '/trajes/' }, { name: familia.nombreWa, href: `/trajes/${familia.slug}/` }]} heroImage={heroDeFamilia(familia.slug)} />
