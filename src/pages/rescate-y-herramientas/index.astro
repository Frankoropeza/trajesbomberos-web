---
// L2 · /rescate-y-herramientas/ — plantilla CategoriaL2 (ver src/components/l2/CategoriaL2.astro).
// Texto completo, incluidos los módulos «a fondo»: src/content/categorias/rescate-y-herramientas.md.
// Cards: índice de categorías de la home (lib/catalogo/categorias.ts); modelos: MODELOS de sus secciones.
import { getEntry, render } from 'astro:content';
import CategoriaL2 from '@components/l2/CategoriaL2.astro';
import { MODELOS, urlModelo } from '@lib/catalogo/modelos';
import { SITE } from '@config/site';
import { SECCIONES_RH, spotlightDeModulo, filaModelo, guiasL2, modelosPorId } from '@lib/l2';
import { tilesCategorias } from '@lib/catalogo/categorias';

const entrada = await getEntry('categorias', 'rescate-y-herramientas');
if (!entrada) throw new Error('Falta la entrada de contenido categorias/rescate-y-herramientas.');
const { Content } = await render(entrada);
const d = entrada.data;
const tiles = tilesCategorias(SECCIONES_RH.map((slug) => `/${slug}/`), 'RH-');
const spotlights = d.modulos.map((modulo, index) => spotlightDeModulo(modulo, index));
const todos = SECCIONES_RH.flatMap((seccion) => MODELOS.filter((modelo) => modelo.seccion === seccion));
const columnas = ['modelo', 'seccion', 'tipo', 'material', 'norma', 'estatus'] as const;
// Grid: modelosDestacados del .md si existen; tabla e ItemList: todos los modelos.
const modelos = d.modelosDestacados ? modelosPorId(d.modelosDestacados) : todos;
const filasModelos = todos.map((modelo) => filaModelo(modelo, columnas));
const directoryItems = [
  ...tiles.map((tile) => ({ name: tile.titulo, url: `${SITE.url}${tile.href}` })),
  ...todos.map((modelo) => ({ name: `${modelo.marca} ${modelo.nombre}`, url: `${SITE.url}${urlModelo(modelo)}` })),
];
const guias = await guiasL2(d);
---
<CategoriaL2 {d} {tiles} {spotlights} {modelos} {filasModelos} {directoryItems} {guias}><Content /></CategoriaL2>
