---
import { getEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import BlogSidebar from '@components/BlogSidebar.astro';
import { CONTACT, EMPRESA } from '@config/site';
import { HERO_GENERICO } from '@lib/imagenes';

const legal = await getEntry('legal', 'terminos-y-condiciones');
if (!legal) throw new Error('No se encontraron los términos y condiciones.');

const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
}[character] ?? character));
const responsable = EMPRESA.razonSocial ?? EMPRESA.nombreComercial;
const email = escapeHtml(CONTACT.email);
const domicilio = EMPRESA.domicilio
  ? `<p>Domicilio del responsable: ${escapeHtml(EMPRESA.domicilio)}.</p>`
  : '';
const body = (legal.rendered?.html ?? '')
  .replace('<p>{{DOMICILIO}}</p>', domicilio)
  .replaceAll('{{RESPONSABLE}}', escapeHtml(responsable))
  .replaceAll('{{EMAIL}}', `<a href="mailto:${email}">${email}</a>`);
const actualizado = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(legal.data.actualizado);
const headings = [...body.matchAll(/<h2 id="([^"]+)">([\s\S]*?)<\/h2>/g)].map(([, slug, text]) => ({ depth: 2, slug, text: text.replace(/<[^>]+>/g, '') }));
---

<PageLayout
  pageType="generic"
  path="/terminos-y-condiciones/"
  title="Términos y condiciones | LORICA"
  description={legal.data.description}
  crumbLabel={legal.data.title}
  eyebrow="Legal"
  h1={legal.data.title}
  lead={legal.data.description}
  descRight={[`Última actualización: ${actualizado}.`, `Si tienes dudas sobre este documento escríbenos a ${CONTACT.email}.`]}
  heroImage={HERO_GENERICO}
>
  <div class="section">
    <div class="container layout-grid legal-layout"><article class="prose legal-prose" set:html={body} /><BlogSidebar variant="legal" headings={headings} tocTitle="Contenido de los términos" /></div>
  </div>
</PageLayout>

<style>
  .legal-prose { max-width: 74ch; }
  @media (max-width: 1024px) { .legal-layout { grid-template-columns: 1fr; } }
</style>
