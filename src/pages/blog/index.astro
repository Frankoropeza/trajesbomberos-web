---
// L2 · Índice del blog: /blog/ (página 1 de la paginación).
// Hero canónico → destacado a lo ancho → retícula de 3 junto al
// sidebar, paginada de 9 en 9 (las páginas ≥ 2 viven en
// /blog/pagina/[n].astro). Blog atemporal: ninguna fecha visible.
// El ItemList lo emite ESTA página (regla B3), nunca las tarjetas.
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PostCard from '@components/PostCard.astro';
import BlogListado from '@components/blog/BlogListado.astro';
import BlogSidebar from '@components/BlogSidebar.astro';
import CTABanner from '@components/CTABanner.astro';
import { PRESET_CONTACTO } from '@lib/cta-presets';
import { SITE, BLOG_CATEGORIES } from '@config/site';
import { getPosts, paginar, postUrl, categoriaUrl, readingTime } from '@lib/blog';

const path = '/blog/';
const todos = await getPosts();
const destacado = todos.find((post) => post.data.destacado) ?? todos[0];
const listado = todos.filter((post) => post.id !== destacado?.id);
const pagina = paginar(listado, 1);
const menuItems = [
  { label: 'Empieza por aquí', href: '#destacado' },
  { label: 'Artículos sobre trajes para bomberos', href: '#articulos' },
  ...BLOG_CATEGORIES.slice(0, 2).map((cat) => ({ label: cat.nombre, href: categoriaUrl(cat.slug) })),
  { label: 'Trajes para bomberos', href: '/trajes/' },
];
const title = 'Blog de trajes para bomberos | guías | México';
const description =
  'Blog de trajes para bomberos: cómo especificar, qué exige la norma NFPA 1970, comparativas entre familias, vida útil del equipo y expediente para licitación.';
const directoryItems = [destacado, ...pagina.posts]
  .filter(Boolean)
  .map((post) => ({ name: post.data.title, url: new URL(postUrl(post), SITE.url).href }));
---

<PageLayout
  pageType="directorio"
  path={path}
  title={title}
  description={description}
  keywords={['blog de trajes para bomberos', 'guías técnicas', 'México']}
  menuItems={menuItems}
  crumbLabel="Blog"
  eyebrow="Conocimiento técnico, no relleno"
  h1="Blog de trajes para bomberos"
  h1Accent="y equipo contra incendios"
  lead="Lo que preguntan por teléfono todos los días, explicado con el criterio con el que se especifica una requisición: normas, comparativas, vida útil y compra pública."
  meta={[
    `${todos.length} artículos publicados`,
    'Escrito por gente del ramo',
    'Sin copiar fichas de fabricante',
    'Actualizado con norma vigente',
  ]}
  descRight={[
    'No escribimos para llenar el sitio. Cada artículo sale de una llamada real: un comprador que no sabe si necesita estructural o brigadista, un área de compras que recibió tres ofertas que no se pueden comparar, un jefe de estación al que le retiraron equipo por fecha de fabricación.',
    'Todo lo que leas aquí lo puedes contrastar con la norma citada y con la ficha técnica del fabricante. Si algo no nos consta, lo decimos. Y si tu caso no encaja con lo que está escrito, escríbenos: preferimos perder una venta que venderte el traje equivocado.',
  ]}
  directoryItems={directoryItems}
>
  {destacado && (
    <section class="section section--tight" id="destacado">
      <div class="container">
        <SectionHeading
          eyebrow="Empieza por aquí"
          title="El artículo que más nos piden"
          description="Si es tu primera compra de equipo de protección contra incendios, este es el punto de partida."
        />
        <PostCard
          href={postUrl(destacado)}
          title={destacado.data.title}
          resumen={destacado.data.resumen}
          categoria={destacado.data.categoria}
          lectura={readingTime(destacado.body)}
          image={destacado.data.imagen}
          imageAlt={destacado.data.imagenAlt}
          ancla={destacado.data.ancla}
          destacado={true}
          wide={true}
        />
      </div>
    </section>
  )}
  <div class="section section--alt" id="articulos">
    <div class="container layout-grid">
      <div class="layout-main">
        <SectionHeading
          eyebrow="Guías técnicas"
          title="Artículos sobre trajes para bomberos y equipo contra incendios"
          description="Cinco categorías: cómo especificar, normas y certificación, comparativas entre familias, vida útil y servicio, y compras y licitación."
        />
        <BlogListado
          posts={pagina.posts}
          todos={todos}
          total={todos.length}
          pagina={pagina.pagina}
          totalPaginas={pagina.totalPaginas}
          base={path}
          ask
        />
      </div>
      <BlogSidebar
        variant="indice"
        visiblePostIds={[destacado?.id, ...pagina.posts.map((post) => post.id)].filter(Boolean)}
      />
    </div>
  </div>
  <CTABanner variant="dark" {...PRESET_CONTACTO} />
</PageLayout>
