---
// L2 · Categoría del blog: /blog/categoria/{slug}/ (página 1).
// Misma vista que el índice (BlogListado) filtrada por tema, con la
// guía de la categoría debajo. Si pasa de 9 artículos, las páginas
// ≥ 2 viven en [categoria]/pagina/[n].astro.
import type { GetStaticPaths } from 'astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import BlogListado from '@components/blog/BlogListado.astro';
import BlogSidebar from '@components/BlogSidebar.astro';
import CTABanner from '@components/CTABanner.astro';
import { PRESET_CONTACTO } from '@lib/cta-presets';
import { SITE, BLOG_CATEGORIES } from '@config/site';
import { getPosts, getPostsByCategoria, paginar, postUrl, categoriaUrl } from '@lib/blog';

export const getStaticPaths = (() =>
  BLOG_CATEGORIES.map((cat) => ({
    params: { categoria: cat.slug },
    props: { cat },
  }))) satisfies GetStaticPaths;
const { cat } = Astro.props;
const todos = await getPosts();
const categoriaPosts = await getPostsByCategoria(cat.slug);
const pagina = paginar(categoriaPosts, 1);
const path = categoriaUrl(cat.slug);
const directoryItems = pagina.posts.map((post) => ({
  name: post.data.title,
  url: new URL(postUrl(post), SITE.url).href,
}));
const menuItems = [
  { label: 'Artículos sobre trajes para bomberos', href: '#articulos' },
  ...BLOG_CATEGORIES.filter((item) => item.slug !== cat.slug)
    .slice(0, 3)
    .map((item) => ({ label: item.nombre, href: categoriaUrl(item.slug) })),
  { label: 'Blog de trajes para bomberos', href: '/blog/' },
];
---

<PageLayout
  pageType="directorio"
  path={path}
  title={cat.seoTitle}
  description={cat.seoDescription}
  keywords={cat.keywords}
  menuItems={menuItems}
  crumbLabel={cat.nombre}
  parent={{ name: 'Blog', href: '/blog/' }}
  eyebrow={`Blog · ${cat.nombre}`}
  h1={cat.h1}
  lead={cat.lead}
  meta={[
    `${pagina.total} ${pagina.total === 1 ? 'artículo' : 'artículos'}`,
    'Norma vigente citada',
    'Español de México',
    'Sin relleno',
  ]}
  descRight={[
    cat.desc,
    'Si después de leer sigues con la duda, escríbenos: contestamos con la ficha técnica en la mano y te decimos con franqueza si lo que necesitas es otra cosa.',
  ]}
  directoryItems={directoryItems}
>
  <div class="section section--alt" id="articulos">
    <div class="container layout-grid">
      <div class="layout-main">
        <SectionHeading eyebrow={cat.nombre} title={`Artículos de ${cat.nombre.toLowerCase()}`} />
        <BlogListado
          posts={pagina.posts}
          todos={todos}
          total={pagina.total}
          pagina={pagina.pagina}
          totalPaginas={pagina.totalPaginas}
          base={path}
          actualCategoria={cat.slug}
        />
        {cat.guia && (
          <section class="cat-guia" aria-labelledby="cat-guia-t">
            <h2 id="cat-guia-t">{cat.guia.titulo}</h2>
            {cat.guia.parrafos.map((texto) => (
              <p>{texto}</p>
            ))}
            <ul class="cat-guia__links">
              {cat.guia.enlaces.map((enlace) => (
                <li>
                  <a href={enlace.href}>{enlace.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p class="volver">
          <a href="/blog/">← Blog de trajes para bomberos</a>
        </p>
      </div>
      <BlogSidebar variant="categoria" visiblePostIds={pagina.posts.map((post) => post.id)} />
    </div>
  </div>
  <CTABanner variant="dark" {...PRESET_CONTACTO} />
</PageLayout>

<style>
  .cat-guia {
    margin-top: clamp(2.2rem, 3.5vw, 3.2rem);
    padding-top: clamp(1.8rem, 3vw, 2.6rem);
    border-top: var(--border);
    max-width: 72ch;
  }
  .cat-guia h2 {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
  }
  .cat-guia p {
    margin: 0 0 1rem;
    color: var(--color-gray);
    line-height: 1.7;
  }
  .cat-guia__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cat-guia__links a {
    display: inline-block;
    padding: 0.45rem 0.8rem;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-dark);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }
  .cat-guia__links a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .volver {
    margin: 2.2rem 0 0;
  }
  .volver a {
    font-weight: 800;
    text-decoration: none;
  }
  .volver a:hover {
    text-decoration: underline;
  }
</style>
