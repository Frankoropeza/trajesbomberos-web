---
// L2 · Índice del blog, páginas ≥ 2: /blog/pagina/N/
// Misma vista que /blog/ sin el destacado. 9 artículos por página
// (ver paginar() en @lib/blog). Canónica propia e indexable.
// El ItemList lo emite ESTA página con SUS artículos (regla B3).
import type { GetStaticPaths } from 'astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import BlogListado from '@components/blog/BlogListado.astro';
import BlogSidebar from '@components/BlogSidebar.astro';
import { PRESET_CONTACTO } from '@lib/cta-presets';
import { SITE, BLOG_CATEGORIES } from '@config/site';
import { getPosts, paginar, postUrl, categoriaUrl, paginaUrl, seoPagina } from '@lib/blog';

export const getStaticPaths = (async () => {
  const todos = await getPosts();
  const destacado = todos.find((post) => post.data.destacado) ?? todos[0];
  const listado = todos.filter((post) => post.id !== destacado?.id);
  const total = paginar(listado, 1).totalPaginas;
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { n: String(i + 2) } }));
}) satisfies GetStaticPaths;

const n = Number(Astro.params.n);
const todos = await getPosts();
const destacado = todos.find((post) => post.data.destacado) ?? todos[0];
const listado = todos.filter((post) => post.id !== destacado?.id);
const pagina = paginar(listado, n);
const path = paginaUrl('/blog/', pagina.pagina);
const seo = seoPagina(
  'Blog de trajes para bomberos: guías de compra y normas',
  'Blog de trajes para bomberos: cómo especificar, qué exige la norma NFPA 1970, comparativas entre familias, vida útil del equipo y expediente para licitación.',
  pagina.pagina,
);
const directoryItems = pagina.posts.map((post) => ({
  name: post.data.title,
  url: new URL(postUrl(post), SITE.url).href,
}));
const menuItems = [
  { label: 'Artículos sobre trajes para bomberos', href: '#articulos' },
  ...BLOG_CATEGORIES.slice(0, 3).map((cat) => ({ label: cat.nombre, href: categoriaUrl(cat.slug) })),
  { label: 'Trajes para bomberos', href: '/trajes/' },
];
---

<PageLayout
  pageType="directorio"
  path={path}
  title={seo.title}
  description={seo.description}
  keywords={['blog de trajes para bomberos', 'guías técnicas', 'México']}
  menuItems={menuItems}
  crumbLabel={`Página ${pagina.pagina}`}
  parent={{ name: 'Blog técnico de trajes para bomberos', href: '/blog/' }}
  eyebrow="Conocimiento técnico, no relleno"
  h1="Blog de trajes para bomberos"
  h1Accent={`· página ${pagina.pagina}`}
  lead="Guías técnicas para especificar, comparar y cotizar equipo de protección contra incendio."
  meta={[
    `${todos.length} artículos publicados`,
    'Escrito por gente del ramo',
    'Sin copiar fichas de fabricante',
    'Actualizado con norma vigente',
  ]}
  descRight={[
    'No escribimos para llenar el sitio. Cada artículo sale de una llamada real: un comprador que no sabe si necesita estructural o brigadista, un área de compras que recibió tres ofertas que no se pueden comparar, un jefe de estación al que le retiraron equipo por fecha de fabricación.',
    'Todo lo que leas aquí lo puedes contrastar con la norma citada y con la ficha técnica del fabricante. Si algo no nos consta, lo decimos. Y si tu caso no encaja con lo que está escrito, escríbenos: preferimos perder una venta que venderte el traje equivocado.',
  ]}
  directoryItems={directoryItems}
  footerCta={{ title: PRESET_CONTACTO.title, text: PRESET_CONTACTO.text, secondary: { label: 'Familias de trajes para bomberos', href: '/trajes/' } }}
>
  <div class="section section--alt" id="articulos">
    <div class="container layout-grid">
      <div class="layout-main">
        <SectionHeading
          eyebrow={`Página ${pagina.pagina}`}
          title="Artículos sobre trajes para bomberos"
          description="Guías técnicas ordenadas para compras, cuerpos de bomberos y brigadas industriales."
        />
        <BlogListado
          posts={pagina.posts}
          todos={todos}
          total={todos.length}
          pagina={pagina.pagina}
          totalPaginas={pagina.totalPaginas}
          base="/blog/"
          ask
        />
      </div>
      <BlogSidebar variant="indice" visiblePostIds={pagina.posts.map((post) => post.id)} />
    </div>
  </div>
</PageLayout>
