---
// L2 · Directorio nacional de estaciones de bomberos (hub).
// Estructura homologada con la home y /trajes/: PageLayout (migas +
// Hero sólido + SectionMenu) → secciones con SectionHeading «duo»
// (eyebrow + título izquierda, 2 párrafos derecha) → cards de 4 por
// fila con borde rojo, código, subenlaces y botón con palabra clave.
// Orden: aviso 911 → índice por región → 32 cards de estado → cifras →
// cómo se arma → equipo para corporaciones → FAQ → CTA.
// Reglas: cero datos inventados (todo sale de lib/directorio), sin
// fechas, sin precios, botones con palabra clave.
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TileGrid from '@components/home/TileGrid.astro';
import TileCard from '@components/home/TileCard.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import EstadoCard from '@components/directorio/EstadoCard.astro';
import Aviso911 from '@components/directorio/Aviso911.astro';
import RegionesIndex from '@components/directorio/RegionesIndex.astro';
import CifrasDirectorio from '@components/directorio/CifrasDirectorio.astro';
import BotonesConteo from '@components/directorio/BotonesConteo.astro';
import { tilesEquipo } from '@lib/directorio-equipo';
import type { CtaPreset } from '@lib/cta-presets';
import { waUrl } from '@lib/wa';
import { LEYES_PC, rutaLeyPC } from '@lib/leyes-proteccion-civil';
import { SITE, CONTACT, WA_MESSAGES } from '@config/site';
import {
  BASE_DIRECTORIO,
  REGIONES,
  RESUMEN_ESTADOS,
  RESUMEN_NACIONAL as N,
  rutaEstado,
  enEstado,
  pct,
  nf,
  MUNICIPIOS_PAGINA, rutaMunicipio, ENTIDADES as ENT_CIUDADES,
  deEstado,
} from '@lib/directorio';

const path = BASE_DIRECTORIO;

// Regla de las 3 keywords
// Metas (tanda de metas 2026-09-29): sin «| México» ni pipes. Ahrefs MX: «estación de bomberos» 800.
// Ángulo B2B (decisión de Frank 2026-09-29): corporaciones, equipamiento y licitaciones.
const keywords = ['estaciones de bomberos', 'directorio de bomberos', 'cuerpos de bomberos'] as const;
const title = 'Estaciones de bomberos: directorio nacional por estado';
const description = `${nf(N.total)} estaciones de bomberos en los 32 estados: quién opera cada una, teléfono oficial, ubicación y equipo para corporaciones con factura CFDI 4.0.`;
const REVISION = 'septiembre de 2026';

const menuItems = [
  { label: 'Índice por región', href: '#estados' },
  { label: 'Directorio por estado', href: '#directorio' },
  { label: 'Ciudades', href: '#ciudades' },
  ...(LEYES_PC.length ? [{ label: 'Normativa', href: '#normativa' }] : []),
  { label: 'Cifras', href: '#cifras' },
  { label: 'Cómo verificamos', href: '#metodologia' },
  { label: 'Equipo para bomberos', href: '#equipo' },
  { label: 'Preguntas', href: '#faq' },
];

const estadosAZ = [...RESUMEN_ESTADOS].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const regionNombre = (slug: string) => REGIONES.find((r) => r.slug === slug)?.nombre ?? '';

const municipal = N.porTipo.find(([t]) => t === 'Municipal')?.[1] ?? 0;
const WA_CORRECCION = 'Hola, quiero reportar una corrección o una estación nueva para el directorio de estaciones de bomberos.';

// Módulo de cómo se arma el directorio (proceso real, sin promesas)
const metodo = [
  { t: 'Cada base cuenta por separado', d: 'La central, cada subestación y las estaciones de aeropuerto, PEMEX o industria aparecen por separado, porque cada una tiene su domicilio y su personal.' },
  { t: 'Teléfono solo si es oficial', d: 'Los números vienen de portales de gobierno, directorios de protección civil y canales de las propias corporaciones. Los de directorios comerciales no se publican.' },
  { t: 'Ubicación exacta o aproximada', d: 'Cuando solo conocemos la colonia o la localidad, la ubicación se marca como aproximada y el mapa busca por nombre y domicilio.' },
  { t: 'Revisión periódica', d: 'Revisamos enlaces, teléfonos y fuentes en los 32 estados. Si una estación cambió de domicilio o de teléfono, escríbenos con el dato oficial.' },
];

// Equipo para corporaciones: familias con demanda municipal + conjunto completo
const equipo = tilesEquipo(['estructural', 'forestal', 'extricacion']);

const faqs = [
  {
    q: '¿Cuántas estaciones de bomberos hay en México?',
    a: `No hay un censo nacional público de estaciones de bomberos. Tenemos localizadas ${nf(N.total)} en los 32 estados y ${nf(N.municipios)} municipios y alcaldías, cada una verificada con una fuente oficial, y la cifra crece con cada revisión.`,
  },
  {
    q: '¿A qué número llamo en una emergencia?',
    a: 'Al 911, el número único de emergencias en todo México: la central canaliza la llamada a la estación de bomberos que corresponde. Los teléfonos que publicamos son de cada corporación y sirven para gestiones como capacitación, dictámenes o donativos, no para reportar un incendio.',
  },
  {
    q: '¿Quién opera las estaciones de bomberos en México?',
    a: `La mayoría son municipales: ${nf(municipal)} de las ${nf(N.total)} estaciones localizadas (${pct(municipal, N.total)}) dependen del ayuntamiento, casi siempre dentro de la coordinación de protección civil. El resto son estatales, de aeropuerto, de patronatos de bomberos voluntarios, de PEMEX, de CFE o brigadas industriales.`,
  },
  {
    q: '¿Cómo verifican los datos de cada estación?',
    a: 'Cada dato se contrasta con una fuente oficial: portales de gobiernos estatales y municipales, directorios de protección civil, los canales de las corporaciones y el DENUE del INEGI para la ubicación. Si un teléfono no aparece en una fuente oficial, no lo publicamos.',
  },
  {
    q: '¿Cómo reporto un error o agrego una estación?',
    a: `Escríbenos por WhatsApp al ${CONTACT.telefono} con el nombre de la estación, el dato correcto y la fuente (página oficial, publicación de la corporación o fotografía de la fachada). Revisamos la fuente antes de actualizar la información.`,
  },
  {
    q: '¿Venden equipo para cuerpos de bomberos municipales?',
    a: 'Sí. Cotizamos trajes estructurales, forestales y de rescate, cascos, botas, guantes, monjas y equipo de respiración autónoma para corporaciones municipales y estatales, con ficha técnica por partida, expediente para licitación y factura CFDI 4.0. Sin compra mínima.',
  },
];

// Schema: ItemList con las 32 páginas de estado + CollectionPage
const directoryItems = RESUMEN_ESTADOS.map((e) => ({
  name: `Estaciones de bomberos ${enEstado(e)}`,
  url: `${SITE.url}${rutaEstado(e.slug)}`,
}));
const collection = {
  name: 'Directorio de estaciones de bomberos en México',
  description,
  url: `${SITE.url}${path}`,
};

const cta: CtaPreset = {
  title: '¿Tu corporación está renovando equipo?',
  text: 'LORICA cotiza para cuerpos de bomberos municipales y estatales de los 32 estados con ficha técnica por partida, expediente para licitación y factura CFDI 4.0. Sin compra mínima.',
  buttons: [
    { label: 'Cotizar equipo por WhatsApp', href: waUrl(WA_MESSAGES.licitacion), icon: 'wa', primary: true, external: true },
    { label: CONTACT.telefono, href: `tel:${CONTACT.telefonoHref}`, icon: 'phone' },
    { label: 'Trajes para bomberos', href: '/trajes/', icon: 'catalog' },
  ],
};
---
<PageLayout
  footerCta={{ title: cta.title, text: cta.text, secondary: { label: 'Trajes para bomberos por familia', href: '/trajes/' } }}
  pageType="directorio"
  path={path}
  ogImage={'/images/og/dir-mexico.jpg'}
  title={title}
  description={description}
  keywords={keywords}
  menuItems={menuItems}
  crumbLabel="Estaciones de bomberos"
  eyebrow="Directorio nacional de bomberos"
  h1="Estaciones de bomberos"
  h1Accent="en México"
  lead={`Tenemos localizadas ${nf(N.total)} estaciones de bomberos en los 32 estados, organizadas por estado y municipio. De cada una sabrás quién la opera, su domicilio, su teléfono oficial cuando existe y su ubicación.`}
  meta={[`${nf(N.total)} estaciones`, '32 estados', `${nf(N.municipios)} municipios y alcaldías`, `Revisión: ${REVISION}`]}
  descRight={[]}
  faqs={faqs}
  directoryItems={directoryItems}
  collection={collection}
>
  <Aviso911 />

  <!-- 1 · Índice de los 32 estados agrupado por región (2 filas de 4) -->
  <section class="section" id="estados">
    <div class="container">
      <SectionHeading
        eyebrow="Índice por región"
        title="Estaciones de bomberos por estado y por región"
        duo={[
          'Las 32 entidades están agrupadas en siete regiones para que ubiques rápido tu zona, del Noroeste y la península de Baja California a la península de Yucatán, pasando por el Bajío, el Centro y el Pacífico Sur.',
          'El número junto a cada estado es el total de estaciones que tenemos localizadas. La cobertura crece con cada revisión: si falta una estación de tu municipio, escríbenos con el dato oficial.',
        ]}
      />
      <RegionesIndex />
    </div>
  </section>

  <!-- 2 · Directorio completo: 32 cards de estado en orden alfabético (8 filas de 4) -->
  <section class="section section--alt" id="directorio">
    <div class="container">
      <SectionHeading
        eyebrow="Directorio por estado"
        title="Bomberos en los 32 estados de México"
        duo={[
          'Cada tarjeta resume un estado: cuántas estaciones tiene, en cuántos municipios y qué corporaciones las operan, con acceso directo a los municipios con más estaciones.',
          'Dentro de cada estado encontrarás las estaciones por municipio, con domicilio, teléfono oficial cuando existe y ubicación en el mapa.',
        ]}
      />
      <TileGrid>
        {estadosAZ.map((e) => <EstadoCard e={e} regionNombre={regionNombre(e.region)} />)}
      </TileGrid>
    </div>
  </section>

  <!-- 2b · Ciudades con página propia (fase 2) -->
  <section class="section" id="ciudades">
    <div class="container">
      <SectionHeading
        eyebrow="Ciudades con más estaciones"
        title="Estaciones de bomberos por ciudad"
        duo={[
          `Las ${MUNICIPIOS_PAGINA.length} ciudades con más estaciones de bomberos, y las capitales con dos o más, tienen su propia página: quién opera cada estación, su teléfono oficial y el equipo que corresponde a sus riesgos.`,
          'El resto de los municipios aparece dentro de la página de su estado, agrupado con sus estaciones.',
        ]}
      />
      <BotonesConteo
        cols={4}
        label="Ciudades con página de estaciones de bomberos"
        items={[...MUNICIPIOS_PAGINA].sort((a, b) => b.estaciones.length - a.estaciones.length || a.comun.localeCompare(b.comun, 'es')).map((m) => ({
          label: `${m.comun}, ${ENT_CIUDADES.find((x) => x.slug === m.estado)!.nombre}`,
          href: rutaMunicipio(m.estado, m.slug),
          n: m.estaciones.length,
          title: `Bomberos en ${m.comun}`,
        }))}
      />
      {LEYES_PC.length > 0 && (
        <div class="normativa" id="normativa">
          <SectionHeading
            eyebrow="Normativa de protección civil"
            title="Ley de Protección Civil por estado"
            duo={[
              `Resumimos la ley de protección civil vigente de ${LEYES_PC.length === 32 ? 'los 32 estados' : `${LEYES_PC.length} estados`}: qué exige a empresas, inmuebles y brigadas, con el artículo y el enlace al texto oficial de cada congreso.`,
              'Sirve para preparar el programa interno, integrar la brigada y definir su equipo de protección antes de una verificación.',
            ]}
          />
          <ul class="normativa__grid">
            {LEYES_PC.map((l) => {
              const ent = ENT_CIUDADES.find((x) => x.slug === l.slug)!;
              return <li><a href={rutaLeyPC(l.slug)}>Ley de Protección Civil {deEstado(ent)}</a></li>;
            })}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- 3 · Cifras del directorio -->
  <section class="section section--alt" id="cifras">
    <div class="container">
      <SectionHeading
        eyebrow="Cifras del directorio"
        title="Quién opera las estaciones de bomberos en México"
        duo={[
          `${pct(municipal, N.total)} de las estaciones son municipales: en México el servicio de bomberos es, sobre todo, responsabilidad del ayuntamiento, que lo presta desde protección civil o con un cuerpo de bomberos propio.`,
          'Completan la red las corporaciones estatales, los servicios de salvamento de los aeropuertos, los patronatos de bomberos voluntarios y las brigadas de PEMEX, CFE y la industria. Es el mapa de quién opera, capacita y compra equipo en cada estado.',
        ]}
      />
      <CifrasDirectorio />
    </div>
  </section>

  <!-- 4 · Cómo se arma el directorio -->
  <section class="section" id="metodologia">
    <div class="container">
      <SectionHeading
        eyebrow="Cómo verificamos"
        title="Cómo verificamos cada estación de bomberos"
        duo={[
          'Publicamos un teléfono solo si lo difunde la propia corporación o una dependencia de gobierno, y revisamos que los enlaces de origen sigan vivos y limpios. Si la ubicación no es exacta, lo indicamos.',
          `Si trabajas en una estación y ves un dato desactualizado, <a href="${waUrl(WA_CORRECCION)}" target="_blank" rel="noopener nofollow">envíanos la corrección por WhatsApp</a> con el dato oficial. Revisamos cada reporte antes de publicarlo.`,
        ]}
      />
      <ol class="metodo">
        {metodo.map((m, i) => (
          <li class="metodo__item">
            <span class="metodo__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · Equipo para corporaciones (puente al catálogo, TileCard homologada) -->
  <section class="section section--alt" id="equipo">
    <div class="container">
      <SectionHeading
        eyebrow="Equipo para cuerpos de bomberos"
        title="Trajes para bomberos municipales, estatales y voluntarios"
        duo={[
          'Equipamos a corporaciones de todo el país: <a href="/trajes/estructural/">trajes estructurales</a> para incendio en edificaciones, <a href="/trajes/forestal/">trajes forestales</a> para temporada de incendios y <a href="/trajes/extricacion/">trajes de extricación</a> para rescate vehicular, más casco, monja, botas, guantes y equipo de respiración autónoma.',
          'Cotizamos con ficha técnica por partida, sobre la norma vigente —NFPA 1970, la que sustituyó a la NFPA 1971— y preparamos el expediente para licitación. Sin compra mínima: por pieza, por elemento o para toda la estación.',
        ]}
      />
      <TileGrid>
        {equipo.map((t) => <TileCard {...t} />)}
      </TileGrid>
    </div>
  </section>

  <!-- 6 · Preguntas frecuentes -->
  <section class="section" id="faq">
    <div class="container">
      <SectionHeading
        eyebrow="Preguntas frecuentes"
        title="Lo que más se pregunta sobre las estaciones de bomberos"
        duo={[
          'Las dudas más comunes sobre las estaciones de bomberos del país: cuántas hay, quién las opera, cómo verificamos los datos y a qué número llamar en una emergencia.',
          'Si tu pregunta es sobre equipo para tu corporación, LORICA te atiende por WhatsApp: envíanos el número de elementos y la operación que cubren, y te respondemos en día hábil.',
        ]}
      />
      <FAQWithContact items={faqs} />
    </div>
  </section>

</PageLayout>

<style>
  .normativa { margin-top: clamp(3rem, 5vw, 4.5rem); padding-top: clamp(3rem, 5vw, 4.5rem); border-top: var(--border); scroll-margin-top: calc(var(--sticky-offset) + 1rem); }
  .normativa__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem 1.5rem; }
  .normativa__grid a { display: block; padding: 0.55rem 0; border-bottom: 1px solid var(--color-gray-light); font-weight: 600; color: var(--color-dark); text-decoration: none; }
  .normativa__grid a:hover { color: var(--color-primary); }
  @media (max-width: 1023px) { .normativa__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 479px) { .normativa__grid { grid-template-columns: 1fr; } }
  /* Cómo se arma: 4 pasos en cards homologadas */
  .metodo {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .metodo__item {
    padding: 1.4rem 1.3rem 1.3rem;
    background: var(--color-white);
    border: 1px solid rgb(20 22 26 / 0.14);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius);
  }
  .metodo__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
  }
  .metodo__item h3 { margin: 0.8rem 0 0.5rem; font-size: 1.08rem; line-height: 1.25; }
  .metodo__item p { margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--color-gray); }

  @media (max-width: 1023px) { .metodo { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } }
  @media (max-width: 639px) { .metodo { grid-template-columns: 1fr; } }
</style>
