---
// L3 · Directorio de estaciones de bomberos por estado (32 páginas).
// Plantilla homologada con el hub y la home: PageLayout (migas + Hero
// sólido + SectionMenu) → aviso 911 → secciones con SectionHeading
// «duo» → cards con borde rojo. Orden: municipios → estaciones por
// municipio → cifras del estado → equipo → estados de la región →
// FAQ → CTA.
// Datos: lib/directorio (snapshot con fuente). Textos editoriales
// propios de cada estado: src/data/directorio-estados/<slug>.json
// (encargo D2, revisado por Claude). Cero cifras escritas a mano.
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TileGrid from '@components/home/TileGrid.astro';
import TileCard from '@components/home/TileCard.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import CTABanner from '@components/CTABanner.astro';
import Aviso911 from '@components/directorio/Aviso911.astro';
import BotonesConteo from '@components/directorio/BotonesConteo.astro';
import EstacionCard from '@components/directorio/EstacionCard.astro';
import StatsRow from '@components/directorio/StatsRow.astro';
import DataTable from '@components/directorio/DataTable.astro';
import { tilesFamilias, tileConjunto } from '@lib/catalogo/tiles';
import type { CtaPreset } from '@lib/cta-presets';
import { waUrl } from '@lib/wa';
import { SITE, CONTACT, WA_MESSAGES } from '@config/site';
import {
  BASE_DIRECTORIO, ENTIDADES, REGIONES, TIPO_DESC, SERVICIO_LABEL,
  resumenEstado, municipiosDe, serviciosDe, rutaEstado, telHref, pct, nf, enEstado, deEstado, conArticulo, unidad,
  type Entidad,
} from '@lib/directorio';

export function getStaticPaths() {
  return ENTIDADES.map((e) => ({ params: { estado: e.slug }, props: { e } }));
}

// Textos editoriales por estado (D2)
interface Editorial {
  lead: string; descRight: string[]; municipiosDuo: string[]; estacionesDuo: string[];
  coberturaDuo: string[]; equipoDuo: string[]; faqs: { q: string; a: string }[];
}
const EDITORIAL = import.meta.glob<Editorial>('../../data/directorio-estados/*.json', { eager: true, import: 'default' });

const { e } = Astro.props as { e: Entidad };
const r = resumenEstado(e);
const region = REGIONES.find((x) => x.slug === e.region)!;
const municipios = municipiosDe(e.slug);
const servicios = serviciosDe(e.slug);
const path = rutaEstado(e.slug);
const ed = EDITORIAL[`../../data/directorio-estados/${e.slug}.json`];
if (!ed) throw new Error(`[directorio] falta el editorial de ${e.slug} (src/data/directorio-estados/${e.slug}.json)`);

const EN = enEstado(e); // «en Jalisco», «en el Estado de México»
const DE = deEstado(e); // «de Jalisco», «del Estado de México»
const est = (n: number) => `${nf(n)} ${n === 1 ? 'estación' : 'estaciones'}`;
const mun = (n: number) => `${nf(n)} ${unidad(e.slug, n)}`;
const UNI = unidad(e.slug, 1); // «municipio» o «alcaldía»
const UNIS = unidad(e.slug); // plural

// Regla de las 3 keywords
const keywords = [`estaciones de bomberos ${EN}`, 'directorio', 'México'] as const;
const title = `Estaciones de bomberos ${EN} | Directorio`;
const description = `Estaciones de bomberos ${EN}: ${est(r.total)} en ${mun(r.municipios)}, con ubicación en mapa, corporación y fuente pública de cada dato.`;

const menuItems = [
  { label: UNIS.charAt(0).toUpperCase() + UNIS.slice(1), href: '#municipios' },
  { label: 'Estaciones', href: '#estaciones' },
  { label: 'Cifras', href: '#cifras' },
  { label: 'Equipo para bomberos', href: '#equipo' },
  { label: `${region.nombre}`, href: '#region' },
  { label: 'Preguntas', href: '#faq' },
];

// Equipo según los servicios declarados en el estado (estructural siempre)
const nServ = (k: string) => servicios.find(([s]) => s === k)?.[1] ?? 0;
const nTipo = (...ts: string[]) => r.porTipo.filter(([t]) => ts.includes(t)).reduce((a, [, n]) => a + n, 0);
const candidatos = [
  { href: '/trajes/forestal/', n: nServ('incendios-forestales') },
  { href: '/trajes/extricacion/', n: nServ('rescate-vehicular') },
  { href: '/trajes/aproximacion/', n: nServ('arff') },
  { href: '/trajes/hazmat/', n: nServ('hazmat') },
  { href: '/trajes/brigadista/', n: nTipo('Industrial', 'PEMEX', 'CFE') },
].filter((c) => c.n > 0).sort((a, b) => b.n - a.n).slice(0, 2).map((c) => c.href);
while (candidatos.length < 2) candidatos.push(['/trajes/extricacion/', '/trajes/forestal/'].find((h) => !candidatos.includes(h))!);
const HREFS = ['/trajes/estructural/', ...candidatos];
const familias = tilesFamilias().filter((t) => HREFS.includes(t.href)).sort((a, b) => HREFS.indexOf(a.href) - HREFS.indexOf(b.href));
const equipo = [...familias, tileConjunto(familias.length + 1)];

// Estados de la región
const vecinos = ENTIDADES.filter((x) => x.region === e.region && x.slug !== e.slug)
  .map((x) => resumenEstado(x))
  .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

// Schema
const directoryItems = municipios.map((m) => ({ name: `Bomberos en ${m.nombre}`, url: `${SITE.url}${path}#${m.slug}` }));
const estacionesSchema = municipios.flatMap((m) => m.estaciones).map((s) => ({
  name: s.nombre,
  url: `${SITE.url}${path}#${s.slug}`,
  locality: s.ciudad || s.municipio,
  region: e.nombre,
  lat: s.coordenadas.lat,
  lng: s.coordenadas.lng,
  street: s.direccion,
  telephone: s.telefono ? telHref(s.telefono) : undefined,
  sameAs: s.sitioWeb,
}));
const collection = { name: `Estaciones de bomberos ${EN}`, description, url: `${SITE.url}${path}` };

const cta: CtaPreset = {
  title: `¿Equipas a una corporación de bomberos ${EN}?`,
  text: `Cotizamos trajes y equipo para bomberos con ficha técnica por partida, expediente para licitación y factura CFDI 4.0. Sin compra mínima y con envío a ${e.slug === 'estado-de-mexico' ? 'todo el Estado de México' : e.slug === 'ciudad-de-mexico' ? 'toda la Ciudad de México' : e.nombre}.`,
  buttons: [
    { label: 'Cotizar equipo por WhatsApp', href: waUrl(WA_MESSAGES.licitacion), icon: 'wa', primary: true, external: true },
    { label: CONTACT.telefono, href: `tel:${CONTACT.telefonoHref}`, icon: 'phone' },
    { label: 'Directorio nacional de bomberos', href: BASE_DIRECTORIO, icon: 'arrow' },
  ],
};
---
<PageLayout
  pageType="directorio"
  path={path}
  title={title}
  description={description}
  keywords={keywords}
  menuItems={menuItems}
  parent={{ name: 'Estaciones de bomberos', href: BASE_DIRECTORIO }}
  crumbLabel={e.nombre}
  eyebrow={`Directorio de bomberos · ${region.nombre}`}
  h1="Estaciones de bomberos"
  h1Accent={EN}
  lead={ed.lead}
  meta={[est(r.total), mun(r.municipios), `${nf(r.conTelefono)} con teléfono`, e.iso]}
  descRight={ed.descRight}
  faqs={ed.faqs}
  directoryItems={directoryItems}
  collection={collection}
  estaciones={estacionesSchema}
>
  <Aviso911 estado={conArticulo(e)} />

  <!-- 1 · Índice de municipios -->
  <section class="section" id="municipios">
    <div class="container">
      <SectionHeading
        eyebrow={`${UNIS.charAt(0).toUpperCase() + UNIS.slice(1)} ${DE}`}
        title={`Bomberos ${EN} por ${UNI}`}
        duo={ed.municipiosDuo}
      />
      <BotonesConteo
        label={`${UNIS.charAt(0).toUpperCase() + UNIS.slice(1)} ${DE} con estaciones de bomberos`}
        items={municipios.map((m) => ({ label: m.nombre, href: `#${m.slug}`, n: m.estaciones.length, title: `Bomberos en ${m.nombre}` }))}
      />
    </div>
  </section>

  <!-- 2 · Estaciones agrupadas por municipio -->
  <section class="section section--alt" id="estaciones">
    <div class="container">
      <SectionHeading
        eyebrow="Listado de estaciones"
        title={`Estaciones de bomberos ${EN}: ${est(r.total)}`}
        duo={ed.estacionesDuo}
      />
      {municipios.map((m, i) => (
        <div class="muni" id={m.slug}>
          <header class="muni__head">
            <span class="muni__code">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="muni__title">Bomberos en {m.nombre}</h3>
            <p class="muni__meta">{est(m.estaciones.length)}</p>
          </header>
          <ul class="muni__grid">
            {m.estaciones.map((s) => <EstacionCard s={s} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- 3 · Cifras del estado -->
  <section class="section" id="cifras">
    <div class="container">
      <SectionHeading
        eyebrow={`Cifras ${DE}`}
        title={`Cobertura de bomberos ${EN}`}
        duo={ed.coberturaDuo}
      />
      <StatsRow stats={[
        { n: nf(r.total), label: r.total === 1 ? 'estación registrada' : 'estaciones registradas', note: `en ${mun(r.municipios)}` },
        { n: nf(r.conTelefono), label: 'con teléfono con fuente', note: `${pct(r.conTelefono, r.total)} de las fichas` },
        { n: nf(r.conDireccion), label: 'con dirección publicada', note: `${pct(r.conDireccion, r.total)} de las fichas` },
        { n: nf(r.coordExactas), label: 'con ubicación exacta', note: `${pct(r.coordExactas, r.total)} de las fichas` },
      ]} />
      <div class="cif-tables">
        <DataTable
          caption={`Estaciones por tipo de corporación ${EN}`}
          cols={[{ label: 'Tipo' }, { label: 'Estaciones', num: true }, { label: 'Part.', num: true }, { label: 'Quién la opera', hideMobile: true }]}
          rows={r.porTipo.map(([t, n]) => [t, n, pct(n, r.total), TIPO_DESC[t] ?? ''])}
        />
        <DataTable
          caption="Servicios declarados por las estaciones"
          cols={[{ label: 'Servicio' }, { label: 'Estaciones', num: true }, { label: 'Part.', num: true }]}
          rows={servicios.map(([s, n]) => [SERVICIO_LABEL[s] ?? s, n, pct(n, r.total)])}
        />
      </div>
    </div>
  </section>

  <!-- 4 · Equipo para corporaciones del estado -->
  <section class="section section--alt" id="equipo">
    <div class="container">
      <SectionHeading
        eyebrow="Equipo para cuerpos de bomberos"
        title={`Trajes y equipo para bomberos ${EN}`}
        duo={ed.equipoDuo}
      />
      <TileGrid>
        {equipo.map((t) => <TileCard {...t} />)}
      </TileGrid>
    </div>
  </section>

  <!-- 5 · Estados de la misma región -->
  <section class="section" id="region">
    <div class="container">
      <SectionHeading
        eyebrow={`Región ${region.nombre}`}
        title={`Estaciones de bomberos en el ${region.nombre}`}
        duo={[
          `La región ${region.nombre} del directorio agrupa ${vecinos.length + 1} estados: ${region.desc}. Cada botón lleva al listado de estaciones de bomberos del estado, ordenado por municipio.`,
          `Para el resto del país, el <a href="${BASE_DIRECTORIO}">directorio nacional de estaciones de bomberos</a> reúne los 32 estados con su índice por región y las cifras por tipo de corporación.`,
        ]}
      />
      <BotonesConteo
        cols={4}
        label={`Estados de la región ${region.nombre}`}
        items={vecinos.map((v) => ({ label: `Bomberos ${enEstado(v)}`, href: rutaEstado(v.slug), n: v.total }))}
      />
    </div>
  </section>

  <!-- 6 · Preguntas frecuentes -->
  <section class="section section--alt" id="faq">
    <div class="container">
      <SectionHeading
        eyebrow="Preguntas frecuentes"
        title={`Bomberos ${EN}: preguntas frecuentes`}
        duo={[
          `Cuántas estaciones de bomberos registra el directorio ${EN}, en qué municipios están, quién las opera y a qué número llamar en una emergencia.`,
          'Si trabajas en una estación y ves un dato desactualizado, escríbenos por WhatsApp con la fuente y lo corregimos en la siguiente revisión.',
        ]}
      />
      <FAQWithContact items={ed.faqs} />
    </div>
  </section>

  <CTABanner variant="dark" {...cta} />
</PageLayout>

<style>
  /* Bloque de municipio: barra con número, título y conteo */
  .muni { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .muni + .muni { margin-top: clamp(2.2rem, 3.5vw, 3rem); }
  .muni__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid var(--color-dark);
  }
  .muni__code {
    padding: 0.25rem 0.55rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .muni__title { margin: 0; font-size: clamp(1.15rem, 1.5vw, 1.4rem); }
  .muni__meta {
    margin: 0 0 0 auto;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gray);
  }
  .muni__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cif-tables {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 1100px) { .cif-tables { grid-template-columns: 1fr; } }
  @media (max-width: 1023px) { .muni__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } }
  @media (max-width: 640px) { .muni__meta { margin-left: 0; width: 100%; } }
  @media (max-width: 559px) { .muni__grid { grid-template-columns: 1fr; } }
</style>
