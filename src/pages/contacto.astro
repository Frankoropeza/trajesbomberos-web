---
// L2 · Contacto. WhatsApp-first (la conversión del sitio), con
// teléfono y correo como alternativas. Los datos salen del SSoT
// (CONTACT en site.ts): cuando Frank ponga los reales, esta
// página se actualiza sola. La dirección sale de DIRECCION (aprobada
// por Frank el 2026-09-29); nada de datos fabricados.
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import QuoteProcessSteps from '@components/contacto/QuoteProcessSteps.astro';
import { CONTACT, DIRECCION, SEGMENTOS, WA_MESSAGES } from '@config/site';
import { waUrl } from '@lib/wa';
import { HERO_GENERICO } from '@lib/imagenes';

const path = '/contacto/';
const keywords = ['cotizar trajes para bomberos', 'contacto', 'México'] as const;
const title = 'Cotizar trajes para bomberos por WhatsApp o teléfono';
const description =
  'Cotizar trajes para bomberos: escríbenos por WhatsApp con tu operación y tallas, o llama y te ayudamos a especificar. Cotización por escrito con ficha técnica.';

const menuItems = [
  { label: 'Canales de contacto', href: '#whatsapp' },
  { label: 'Dirección de la empresa', href: '#direccion' },
  { label: 'Qué incluir en tu mensaje', href: '#mensaje' },
  { label: 'Cómo trabajamos tu cotización', href: '#proceso' },
  { label: 'Formulario para cotizar trajes', href: '#formulario' },
  { label: 'Trajes para bomberos por familia', href: '/trajes/' },
];

const faqs = [
  {
    q: '¿Cómo pido una cotización?',
    a: 'Por WhatsApp o con el formulario de esta página. Cuéntanos quién usa el equipo, contra qué riesgo, cuántos elementos son y qué piezas necesitas. Con eso armamos la primera propuesta de especificación.',
  },
  {
    q: '¿Qué datos necesitan para cotizar tallas?',
    a: 'Para pedidos chicos, la talla comercial de cada elemento. Para pedidos de brigada o cuerpo completo conviene levantar medidas por elemento: estatura, pecho, cintura y entrepierna. Te mandamos la guía de medición.',
  },
  {
    q: '¿Atienden a particulares o solo a corporaciones?',
    a: 'Ambos. Cotizamos igual a un bombero voluntario que compra su propio chaquetón que a una dependencia que licita 200 conjuntos. El proceso es el mismo: especificación por escrito y ficha técnica por partida.',
  },
  {
    q: '¿Dan factura?',
    a: 'Sí, factura CFDI con los datos de tu organización o dependencia. Para gobierno, acompañamos la documentación del fabricante que el expediente requiera.',
  },
  {
    q: '¿Publican precios?',
    a: 'No. Cada pedido se cotiza porque el precio depende del composite, las tallas, la cantidad y el tiempo de entrega. Un precio de mostrador para un traje certificado casi siempre esconde una ficha técnica incompleta.',
  },
  {
    q: '¿Cuánto tardan en responder?',
    a: 'Por WhatsApp, en el transcurso del día hábil. La cotización formal por escrito depende de la complejidad del pedido; la fecha exacta te la confirmamos en la primera conversación.',
  },
  {
    q: '¿Pueden ayudarme a armar el pliego de una licitación?',
    a: 'Sí. Te ayudamos a redactar la especificación técnica por partida —composite, certificación, tallas y documentación— para que el pliego sea comparable y defendible. Es la parte donde más errores de compra se originan.',
  },
  {
    q: '¿Hacen envíos a todo México?',
    a: 'Sí, cotizamos con entrega en todo el país. El costo y el tiempo de envío van especificados en la cotización, no como sorpresa al final.',
  },
];
---
<PageLayout
  pageType="generic"
  faqs={faqs}
  path={path}
  title={title}
  description={description}
  keywords={keywords}
  menuItems={menuItems}
  crumbLabel="Contacto"
  eyebrow="Contacto"
  h1="Cotiza tus"
  h1Accent="trajes para bomberos"
  lead="En LORICA atendemos a corporaciones y brigadas de los 32 estados: cuéntanos tu operación y te ayudamos a especificar antes de cotizar. Respondemos por WhatsApp en el transcurso del día hábil."
  descRight={[
    'No necesitas llegar con la especificación resuelta. Dinos quién usa el equipo, contra qué riesgo y cuántos elementos son: te proponemos la familia, el composite y las piezas, con la ficha técnica de cada partida.',
    'Si ya tienes un pliego o una requisición, mándalo tal cual. Lo revisamos, te señalamos lo que falta por especificar y te cotizamos por escrito con fecha de entrega comprometida.',
  ]}
  meta={['WhatsApp en día hábil', 'Cotización por escrito', 'Envíos a todo México']}
  heroImage={HERO_GENERICO}
>
  <div class="section">
    <div class="container">
      <section id="whatsapp" class="block">
        <SectionHeading clave="whatsapp"
          eyebrow="Canales de contacto"
          title="Elige cómo cotizar tus trajes"
        />
        <div class="contacto-canales">
          <article class="canal-card canal-card--wa">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.6-4.1A8 8 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 8.5c.3 2.3 2.1 4.1 4.4 4.5l.8-1.1 1.8.7c-.2 1-.9 1.6-1.7 1.6-3.8 0-6.9-3.1-6.9-6.9 0-.8.6-1.5 1.6-1.7l.7 1.8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <p class="canal-card__label">WhatsApp</p>
            <p class="canal-card__dato">{CONTACT.telefono}</p>
            <p class="canal-card__nota">Respuesta en el transcurso del día hábil</p>
            <a href={waUrl(WA_MESSAGES.cotizar)} target="_blank" rel="noopener">Cotizar trajes por WhatsApp</a>
          </article>
          <article class="canal-card">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 3h3l2 5-2 1.5a15 15 0 0 0 6.5 6.5L16 14l5 2v3c0 1.1-.9 2-2 2C10.2 21 3 13.8 3 5c0-1.1.9-2 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <p class="canal-card__label">Teléfono</p>
            <p class="canal-card__dato">{CONTACT.telefono}</p>
            <p class="canal-card__nota">{CONTACT.horario}</p>
            <a href={`tel:${CONTACT.telefonoHref}`}>Llamar para cotizar trajes</a>
          </article>
          <article class="canal-card">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="1" stroke="currentColor" stroke-width="2"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <p class="canal-card__label">Correo</p>
            <p class="canal-card__dato canal-card__dato--email">{CONTACT.email}</p>
            <p class="canal-card__nota">Para pliegos, requisiciones y fichas técnicas</p>
            <a href={`mailto:${CONTACT.email}`}>Enviar requisición de trajes por correo</a>
          </article>
          <article class="canal-card">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
            <p class="canal-card__label">Dirección</p>
            <p class="canal-card__dato canal-card__dato--address">{DIRECCION.linea1}<br />{DIRECCION.linea2}</p>
            <p class="canal-card__nota">Visitas con cita previa</p>
            <a href={DIRECCION.mapsUrl} target="_blank" rel="noopener">Cómo llegar a LORICA en Google Maps</a>
          </article>
        </div>
      </section>
    </div>
  </div>

  <section id="direccion" class="section section--alt">
    <div class="container">
      <div class="block">
        <SectionHeading clave="direccion"
          eyebrow="Dónde estamos"
          title="Dirección de LORICA en la Ciudad de México"
        />
        <div class="ubicacion-grid">
          <address class="contacto-dir">
            <span class="contacto-dir__nombre">LORICA · Trajes para bomberos</span>
            <dl class="contacto-dir__datos">
              <div><dt>Dirección</dt><dd>{DIRECCION.linea1}</dd></div>
              <div><dt>Alcaldía y C.P.</dt><dd>{DIRECCION.alcaldia}, {DIRECCION.cp}</dd></div>
              <div><dt>Horario</dt><dd>{CONTACT.horario}</dd></div>
              <div><dt>Teléfono</dt><dd><a href={`tel:${CONTACT.telefonoHref}`}>{CONTACT.telefono}</a></dd></div>
              <div><dt>Cobertura</dt><dd>{CONTACT.cobertura}</dd></div>
            </dl>
            <a class="contacto-dir__mapa" href={DIRECCION.mapsUrl} target="_blank" rel="noopener">Cómo llegar a LORICA en Google Maps</a>
          </address>
          <iframe class="contacto-mapa" src="https://maps.google.com/maps?q=Manuel%20Caballero%20161%2C%20Obrera%2C%20Cuauht%C3%A9moc%2C%2006800%20Ciudad%20de%20M%C3%A9xico&z=16&output=embed" title="Mapa: LORICA, Manuel Caballero 161, Col. Obrera, Cuauhtémoc, CDMX" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <div class="section">
    <div class="container">
      <section id="mensaje" class="block">
        <SectionHeading clave="primer-mensaje"
          eyebrow="Para cotizar más rápido"
          title="Qué incluir en tu primer mensaje"
        />
        <ol class="mensaje-grid">
          <li class="mensaje-card"><span>01</span><p><strong>Quién usa el equipo.</strong> {SEGMENTOS.map((s) => s.titulo).join(', ')} — cada perfil especifica distinto.</p></li>
          <li class="mensaje-card"><span>02</span><p><strong>La operación.</strong> Ataque interior, conato industrial, línea forestal, rescate vehicular… la familia de traje sale de aquí.</p></li>
          <li class="mensaje-card"><span>03</span><p><strong>Cuántos elementos y qué piezas.</strong> Conjuntos completos o piezas sueltas; con tallas si ya las tienes.</p></li>
          <li class="mensaje-card"><span>04</span><p><strong>Si hay pliego o requisición, adjúntalo.</strong> Cotizamos contra documento cuando existe.</p></li>
        </ol>
      </section>
    </div>
  </div>

  <section id="proceso" class="section section--dark">
    <div class="container">
      <div class="block">
        <SectionHeading dark clave="proceso" eyebrow="Cómo trabajamos" title="De tu mensaje a la cotización por escrito" />
        <QuoteProcessSteps pasos={[
          { title: 'Nos escribes', desc: 'Por WhatsApp, teléfono, correo o el formulario, con la operación, los elementos y las piezas.' },
          { title: 'Especificamos contigo', desc: 'Proponemos la familia de traje, el composite y las piezas según el riesgo y la norma que pide tu operación.' },
          { title: 'Cotización por escrito', desc: 'Recibes la propuesta con ficha técnica por partida, tallas y condiciones de entrega.' },
          { title: 'Factura y envío', desc: 'Facturamos con CFDI 4.0 y enviamos a los 32 estados, sin compra mínima.' },
        ]} />
      </div>
    </div>
  </section>

  <div class="section">
    <div class="container">
      <section id="formulario" class="block">
        <SectionHeading clave="faq"
          eyebrow="Preguntas frecuentes"
          title="Dudas antes de escribirnos"
        />
        <FAQWithContact items={faqs} />
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .block { margin-bottom: clamp(3rem, 5vw, 4.5rem); }
  .block:last-child { margin-bottom: 0; }

  .contacto-canales, .mensaje-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap-grid); list-style: none; margin: 0; padding: 0; }
  .canal-card, .mensaje-card { display: flex; flex-direction: column; min-height: 18.5rem; padding: 1.4rem; border: var(--border); border-top: 3px solid var(--color-primary); background: var(--color-white); box-shadow: var(--shadow-sm); }
  .canal-card svg { width: 24px; height: 24px; margin-bottom: var(--space-sm); color: var(--color-primary); }
  .canal-card__label { margin: 0 0 .3rem; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h3); color: var(--color-dark); }
  .canal-card__dato { margin: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem); font-weight: 800; line-height: 1.2; color: var(--color-dark); overflow-wrap: anywhere; }
  .canal-card__dato--email { font-size: 1.02rem; }
  .canal-card__dato--address { font-size: .96rem; }
  .canal-card__nota { margin: .75rem 0 1.1rem; color: var(--color-gray); font-size: var(--fs-sm); line-height: 1.45; }
  .canal-card a { margin-top: auto; font-weight: 800; line-height: 1.35; }
  .canal-card--wa { background: var(--color-wa); border-color: var(--color-wa); color: var(--color-white); }
  .canal-card--wa svg, .canal-card--wa .canal-card__label, .canal-card--wa .canal-card__dato, .canal-card--wa .canal-card__nota, .canal-card--wa a { color: var(--color-white); }
  .canal-card--wa a { text-decoration-color: rgb(255 255 255 / .7); }

  .ubicacion-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-grid); align-items: stretch; }
  .contacto-dir { display: flex; flex-direction: column; font-style: normal; padding: 1.5rem 1.75rem; border: var(--border); border-top: 3px solid var(--color-primary); background: var(--color-white); }
  .contacto-dir__nombre { font-weight: 800; color: var(--color-dark); }
  .contacto-dir__datos { display: grid; gap: .75rem; margin: var(--space-md) 0; }
  .contacto-dir__datos div { display: grid; grid-template-columns: minmax(7.5rem, .75fr) 1.25fr; gap: .75rem; padding-bottom: .75rem; border-bottom: 1px solid var(--color-gray-light); }
  .contacto-dir__datos dt { font-size: var(--fs-sm); font-weight: 700; color: var(--color-gray); }
  .contacto-dir__datos dd { margin: 0; font-weight: 600; }
  .contacto-dir__mapa { justify-self: start; margin-top: .75rem; font-weight: 800; color: var(--color-primary); }
  .contacto-mapa { width: 100%; min-height: 340px; height: 100%; border: var(--border); background: var(--color-white); }

  .mensaje-card { min-height: 13rem; }
  .mensaje-card span { display: block; margin-bottom: var(--space-md); color: var(--color-primary); font-family: var(--font-display); font-weight: 800; font-size: 2.2rem; line-height: 1; }
  .mensaje-card p { margin: 0; line-height: 1.55; }
  .mensaje-card strong { color: var(--color-dark); }

  @media (max-width: 1023px) {
    .contacto-canales, .mensaje-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .ubicacion-grid { grid-template-columns: 1fr; }
    .contacto-mapa { height: 340px; }
  }
  @media (max-width: 560px) {
    .contacto-canales, .mensaje-grid { grid-template-columns: 1fr; }
    .canal-card { min-height: 0; }
    .contacto-dir__datos div { grid-template-columns: 1fr; gap: .15rem; }
  }
</style>
