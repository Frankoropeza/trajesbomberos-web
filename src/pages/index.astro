  descRight: [
    'Somos especialistas en una sola línea: ropa de protección para combate de incendios. Equipamos brigadas industriales obligadas por la NOM-002-STPS-2010, cuerpos de bomberos municipales que compran por licitación y unidades de protección civil en los 32 estados de la República.',
    'Cotizamos con ficha técnica desde el primer mensaje: composite declarado capa por capa, norma vigente —NFPA 1970, la que sustituyó a la NFPA 1971— y condiciones de entrega por escrito. Y si tu operación necesita otra familia de traje, te lo decimos antes de venderte.',
  ],
};

const hechos = [
  { label: 'Especialidad', value: '7 familias de traje' },
  { label: 'Cobertura', value: 'Los 32 estados' },
  { label: 'Comprobante', value: 'Factura CFDI 4.0' },
  { label: 'Compra mínima', value: 'Sin mínimo: por pieza o conjunto' },
];

// Un módulo por familia: amplía cada card del catálogo con el
// detalle técnico que el comprador necesita antes de cotizar.
// flip alterna para dar ritmo cuando hay varios seguidos.
const guiaColumns: string[] = ['Familia', 'Para qué operación', 'Construcción', 'Complementos'];
const guiaRows: string[][] = [
  ['Estructural', 'Incendio en edificaciones, ataque interior', 'Tres capas: exterior + barrera de humedad + barrera térmica', 'Casco, monja, botas, guantes, ERA'],
  ['Brigadista', 'Fuego incipiente en industria, primera respuesta', 'Menor gramaje y alcance de protección que el estructural', 'Casco, guantes, botas, escafandra'],
  ['Forestal', 'Incendio de vegetación, jornadas largas en campo', 'Una sola capa de tela ignífuga inherente, ligera y transpirable', 'Casco forestal, goggles, guantes, botas sin puntera'],
  ['Aproximación', 'Trabajo cerca de calor radiante: ARFF, refinería, colada', 'Exterior aluminizado, uso prolongado, movilidad conservada', 'Capucha aluminizada, guantes, botas'],
  ['Entrada', 'Ingreso breve a la flama: horno, incidente térmico severo', 'Aluminizado multicapa, pesado, uso corto de emergencia', 'Conjunto completo con ERA'],
  ['Extricación', 'Rescate vehicular y técnico', 'Ligero, resistente a corte y punción, barrera contra patógenos', 'Guante de extricación, casco, goggles'],
];
const guiaNote =
  'Un traje de aproximación no sirve para entrar a la flama, y uno de entrada no sirve para operación prolongada. Confundirlos es el error más peligroso del sector: si tienes duda de qué familia necesita tu operación, escríbenos antes de cotizar.';

// ------------------------------------------------------------
// Cards de categoría. TR = trajes (PRODUCT_CATEGORIES, SSoT);
// EQ = complementos. La "operación" de cada familia sale de la
// guía de selección (guiaRows) para no duplicar datos.
// ------------------------------------------------------------
const OPERACION_POR_FAMILIA: Record<string, string> = {
  estructural: guiaRows[0][1],
  brigadista: guiaRows[1][1],
  forestal: guiaRows[2][1],
  aproximacion: guiaRows[3][1],
  entrada: guiaRows[4][1],
  extricacion: guiaRows[5][1],
};
const TITULO_CARD: Record<string, string> = {
  aproximacion: 'Trajes de aproximación (aluminizados)',
  extricacion: 'Trajes de extricación y rescate',
};
// Dimensiones reales de las fotos de familia (evita CLS; medidas con sips).
const DIMENSIONES: Record<string, { width: number; height: number }> = {
  '/images/productos/traje-estructural-chaqueton-pantalon-bombero.avif': { width: 640, height: 1000 },
  '/images/productos/traje-brigadista-industrial-bombero.avif': { width: 640, height: 1000 },
  '/images/productos/traje-forestal-camisola-pantalon-bombero.avif': { width: 1200, height: 800 },
  '/images/catalogo/hazmat/tipo-traje-encapsulado-nivel-a.avif': { width: 1000, height: 1250 },
  '/images/escenas/bomberos-ataque-incendio-manguera.avif': { width: 1376, height: 768 },
};
const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;

// Cards homologadas (TileCard): imagen → título → texto → 4 subcategorías
// → botón principal con palabra clave. Las subcategorías de familia salen
// de PIEZAS (SSoT) y se validan en build: nunca se enlaza una ruta inexistente.
const RUTAS_PIEZA = new Set(PIEZAS.map((p) => `/trajes/${p.familia}/${p.slug}/`));
const RUTAS_CATALOGO = new Set([
  ...SECCIONES.map((s) => `/${s.slug}/`),
  ...TIPOS.map((t) => `/${t.seccion}/${t.slug}/`),
  ...MODELOS.filter((m) => m.seccion).map((m) => `/${m.seccion}/${m.id}/`),
]);
const rutaValida = (href: string) => RUTAS_PIEZA.has(href) || RUTAS_CATALOGO.has(href) || /^\/trajes\/[a-z-]+\/$/.test(href);
const soloValidas = (subs: TileSub[]) =>
  subs.filter((s) => {
    const ok = rutaValida(s.href);
    if (!ok) console.warn(`[index] subcategoría sin ruta: ${s.href}`);
    return ok;
  });
// Fotos de producto en retrato: se encuadran por arriba para no cortar el casco.
const POS_RETRATO = 'center 8%';
const esRetrato = (src: string) => (DIMENSIONES[src]?.height ?? 1250) > (DIMENSIONES[src]?.width ?? 1000);

