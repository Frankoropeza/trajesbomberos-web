    img: '/images/productos/monja-capucha-barrera-particulas-bombero.avif', alt: 'Monja o escafandra para bombero con barrera de partículas', pos: POS_RETRATO,
    subs: [
      { label: 'Capucha Romak over-face', href: '/capuchas/romak-cap1005/' },
      { label: 'Escafandra Sköld Nomex', href: '/capuchas/skold-fpen/' },
