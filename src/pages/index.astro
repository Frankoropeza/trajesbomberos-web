---
// L1 · Home — portada comercial con exploración por categorías.
// Orden (2026-09-29): hero → botones de sección → categorías → trajes →
// modelos → FAQ → blog → CTA final. Se retiraron por decisión de Frank
// las secciones de complementos, guía, anatomía, especificar, errores,
// segmentos, normas, vida útil, marcas, empresa y proceso.
//
// Reglas duras aplicadas (estudio de mercado jul-2026):
//  · Normas VIGENTES: NFPA 1970 (absorbió 1971), NFPA 1950
//    (absorbió 1977), NFPA 1850 (absorbió 1851 y 1852),
//    NOM-017-STPS-2024 (sustituyó a la de 2008).
//  · NO se afirma que la Ley General de Protección Civil exija
//    certificación NFPA: es FALSO (verificado en el texto vigente).
//  · Marcas SOLO como referencia técnica, sin afirmar distribución.
//  · Sin precios (decisión de negocio). Sin reseñas fabricadas.
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import QuickNav from '@components/home/QuickNav.astro';
import CategoryTiles from '@components/home/CategoryTiles.astro';
import CategorySpotlights from '@components/home/CategorySpotlights.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TileGrid from '@components/home/TileGrid.astro';
import TileCard, { type TileProps, type TileSub } from '@components/home/TileCard.astro';
import QuoteCTA from '@components/home/QuoteCTA.astro';
import ModelosGrid from '@components/ModelosGrid.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import PostCard from '@components/PostCard.astro';
import { getPosts, postUrl, readingTime } from '@lib/blog';
import { PIEZAS } from '@lib/piezas';
import { familiaPorSlug } from '@lib/familias';
import { MODELOS, SECCIONES, TIPOS } from '@lib/catalogo/data';
import {
  SITE,
  PRODUCT_CATEGORIES,
} from '@config/site';

// Metas de la home (tanda de metas P01, 2026-09-29): keyword natural,
// sin marca, sin «México», sin pipes. Datos: Ahrefs MX (trajes de bomberos 200,
// traje de bombero profesional 90, traje contra incendio 30+20, venta de trajes
// para bomberos 10 — hoy #11).
const SEO_HOME = {
  title: 'Trajes para bomberos profesionales y equipo contra incendio',
  description:
    'Venta de trajes para bomberos estructurales, forestales, de brigadista y aluminizados, con ficha técnica por pieza o conjunto completo. Cotiza en día hábil.',
  keywords: ['trajes para bomberos', 'traje de bombero profesional', 'traje contra incendio'],
} as const;

const hero = {
  eyebrow: 'Trajes y equipo de protección para bomberos',
  title: 'Trajes para bomberos',
  accent: 'profesionales con ficha técnica',
  subtitle:
    'Trajes estructurales, de brigadista, forestales, de aproximación, de entrada y de extricación: el traje contra incendio que corresponde a cada riesgo. Sumamos el casco, las botas, los guantes, la monja, los tirantes y el ERA que completan el conjunto. Ficha técnica y factura en cada cotización; envío a los 32 estados.',
  descRight: [
    'En LORICA somos especialistas en una sola línea desde hace más de 35 años: ropa de protección para combate de incendios. Equipamos brigadas industriales obligadas por la NOM-002-STPS-2010, cuerpos de bomberos municipales que compran por licitación y unidades de protección civil en los 32 estados de la República.',
    'Cotizamos con ficha técnica desde el primer mensaje: composite declarado capa por capa, norma vigente y condiciones de entrega por escrito. La referencia actual es la NFPA 1970, que sustituyó a la NFPA 1971. Y si tu operación necesita otra familia de traje, te lo decimos antes de venderte.',
  ],
};

// ------------------------------------------------------------
// Cards de categoría. TR = trajes (PRODUCT_CATEGORIES, SSoT);
// EQ = complementos. La "operación" de cada familia sale de la
// guía de selección (guiaRows) para no duplicar datos.
// ------------------------------------------------------------
const TITULO_CARD: Record<string, string> = {
  aproximacion: 'Trajes de aproximación (aluminizados)',
  extricacion: 'Trajes de extricación y rescate',
};
// Dimensiones reales de las fotos de familia (evita CLS; medidas con sips).
const DIMENSIONES: Record<string, { width: number; height: number }> = {
  '/images/productos/traje-estructural-bombero-conjunto-frente.avif': { width: 896, height: 1120 },
  '/images/productos/traje-brigadista-industrial-conjunto.avif': { width: 896, height: 1120 },
  '/images/productos/traje-forestal-camisola-pantalon-bombero.avif': { width: 1200, height: 800 },
  '/images/catalogo/hazmat/tipo-traje-encapsulado-nivel-a.avif': { width: 1000, height: 1250 },
  '/images/escenas/bomberos-ataque-incendio-manguera.avif': { width: 1376, height: 768 },
};

// Cards homologadas (TileCard): imagen → título → texto → 4 subcategorías
// → botón principal con palabra clave. Las subcategorías de familia salen
// de PIEZAS (SSoT) y se validan en build: nunca se enlaza una ruta inexistente.
const RUTAS_PIEZA = new Set(PIEZAS.map((p) => `/trajes/${p.familia}/${p.slug}/`));
const RUTAS_CATALOGO = new Set([
  ...SECCIONES.map((s) => `/${s.slug}/`),
  ...TIPOS.map((t) => `/${t.seccion}/${t.slug}/`),
  ...MODELOS.filter((m) => m.seccion).map((m) => `/${m.seccion}/${m.id}/`),
]);
const rutaValida = (href: string) => RUTAS_PIEZA.has(href) || RUTAS_CATALOGO.has(href) || /^\/trajes\/[a-z-]+\/$/.test(href);
const soloValidas = (subs: TileSub[]) =>
  subs.filter((s) => {
    const ok = rutaValida(s.href);
    if (!ok) console.warn(`[index] subcategoría sin ruta: ${s.href}`);
    return ok;
  });
// Fotos de producto en retrato: se encuadran por arriba para no cortar el casco.
const POS_RETRATO = 'center 8%';
const esRetrato = (src: string) => (DIMENSIONES[src]?.height ?? 1250) > (DIMENSIONES[src]?.width ?? 1000);

interface FamiliaTile { cta: string; subs: [string, string][] } // [label, slug de pieza]
const FAMILIA_TILE: Record<string, FamiliaTile> = {
  estructural: { cta: 'Trajes estructurales para bombero', subs: [['Chaquetón estructural', 'chaqueton'], ['Pantalonera estructural', 'pantalonera'], ['Monja antipartículas', 'monja'], ['Arnés de escape', 'arnes-escape']] },
  brigadista: { cta: 'Trajes de brigadista industrial', subs: [['Conjunto de brigada', 'conjunto'], ['Overol ignífugo', 'overol'], ['Chaquetón de brigadista', 'chaqueton'], ['Pantalonera de brigadista', 'pantalonera']] },
  forestal: { cta: 'Trajes forestales para bombero', subs: [['Camisola forestal', 'camisola'], ['Pantalón forestal', 'pantalon'], ['Chamarra forestal', 'chamarra'], ['Overol forestal', 'overol']] },
  aproximacion: { cta: 'Trajes aluminizados de aproximación', subs: [['Chaquetón aluminizado', 'chaqueton'], ['Pantalón aluminizado', 'pantalon'], ['Capucha aluminizada', 'capucha'], ['Guantes aluminizados', 'guantes']] },
  entrada: { cta: 'Trajes de entrada a la flama', subs: [['Traje de penetración', 'conjunto-corta-duracion'], ['Penetración avanzada', 'conjunto-avanzado'], ['Capucha de penetración', 'capucha'], ['Traje para hornos', 'hornos']] },
  extricacion: { cta: 'Trajes de extricación y rescate', subs: [['Chaqueta de rescate técnico', 'chaqueta'], ['Pantalón de rescate técnico', 'pantalon'], ['Conjunto de extricación', 'conjunto'], ['Overol de rescate técnico', 'overol']] },
  hazmat: { cta: 'Trajes Hazmat nivel A, B y C', subs: [['Traje encapsulado nivel A', 'traje-encapsulado-nivel-a'], ['Traje químico nivel B', 'traje-nivel-b'], ['Botas químicas', 'botas-quimicas'], ['Guantes para químicos', 'guantes-quimicos']] },
};
const subsFamilia = (slug: string) =>
  soloValidas((FAMILIA_TILE[slug]?.subs ?? []).map(([label, pieza]) => ({ label, href: `/trajes/${slug}/${pieza}/` })));

const trajesFamilias: TileProps[] = PRODUCT_CATEGORIES.map((c, i) => ({
  codigo: `TR-${String(i + 1).padStart(2, '0')}`,
  titulo: TITULO_CARD[c.slug] ?? c.nombre,
  desc: c.desc,
  href: `/trajes/${c.slug}/`,
  cta: FAMILIA_TILE[c.slug]?.cta ?? `${c.nombre} para bombero`,
  img: c.image,
  alt: c.imageAlt,
  pos: esRetrato(c.image) ? POS_RETRATO : undefined,
  subs: subsFamilia(c.slug),
}));

const hazmat = familiaPorSlug('hazmat');
const cardHazmat: TileProps[] = hazmat
  ? [{
      codigo: `TR-${String(trajesFamilias.length + 1).padStart(2, '0')}`,
      titulo: 'Trajes Hazmat (protección química)',
      desc: 'Encapsulado nivel A, químico nivel B y C, overol desechable, botas y guantes. La barrera se elige por sustancia, concentración y tarea.',
      href: '/trajes/hazmat/',
      cta: FAMILIA_TILE.hazmat.cta,
      img: hazmat.images[0].src,
      alt: hazmat.images[0].alt,
      pos: esRetrato(hazmat.images[0].src) ? POS_RETRATO : undefined,
      subs: subsFamilia('hazmat'),
    }]
  : [];

const cardConjunto: TileProps = {
  codigo: `TR-${String(trajesFamilias.length + cardHazmat.length + 1).padStart(2, '0')}`,
  titulo: 'Conjunto completo y compra por pieza',
  desc: 'El traje de bombero completo: traje, casco, monja, botas, guantes y ERA cotizados como un solo equipo compatible, o reposición de una sola prenda. Sin compra mínima.',
  href: '/kits/',
  cta: 'Kits de equipo completo para bombero',
  img: '/images/escenas/bomberos-ataque-incendio-manguera.avif',
  alt: 'Bomberos con equipo completo: traje estructural, casco y equipo de respiración autónoma',
  subs: soloValidas([
    { label: 'Kit estructural', href: '/kits/kit-estructural/' },
    { label: 'Kit brigadista', href: '/kits/kit-brigadista/' },
    { label: 'Kit forestal', href: '/kits/kit-forestal/' },
    { label: 'Tirantes para pantalonera', href: '/trajes/estructural/tirantes/' },
  ]),
};

const trajes: TileProps[] = [...trajesFamilias, ...cardHazmat, cardConjunto];

// Hubs de complementos: solo alimentan el ItemList (schema) de la home.
const complementos = [
  { titulo: 'Cascos para bombero', href: '/cascos/' },
  { titulo: 'Equipo de respiración autónoma (ERA)', href: '/equipo-de-respiracion-autonoma/' },
  { titulo: 'Botas para bombero', href: '/botas/' },
  { titulo: 'Guantes para bombero', href: '/guantes/' },
  { titulo: 'Monjas y escafandras', href: '/capuchas/' },
  { titulo: 'Tirantes y cinturones', href: '/trajes/estructural/tirantes/' },
];

const faqs = [
  {
    q: '¿Cuál es la norma vigente para trajes de bombero?',
    a: 'NFPA 1970, edición 2025. Absorbió a la NFPA 1971 junto con las normas 1975, 1981 y 1982; los requisitos del traje estructural son hoy sus capítulos 5 a 9. Muchas licitaciones todavía redactan "NFPA 1971 Edición 2018" y podemos documentar la correspondencia entre ambas.',
  },
  {
    q: '¿La ley mexicana obliga a comprar equipo certificado NFPA?',
    a: 'No. En México no existe NOM ni NMX de producto para trajes de bombero, y la Ley General de Protección Civil no exige certificación NFPA. Lo que sí es obligatorio es la NOM-017-STPS-2024, que obliga a proporcionar EPP adecuado sin costo, y la NOM-002-STPS-2010 para brigadas. NFPA se vuelve exigible cuando un pliego de licitación la incorpora al contrato.',
  },
  {
    q: '¿Qué diferencia hay entre un traje de brigadista y uno estructural?',
    a: 'El alcance de protección. El estructural lleva tres capas obligatorias (exterior, barrera de humedad y barrera térmica) y está pensado para ataque interior en edificaciones. El de brigadista está pensado para fuego incipiente en industria. Se parecen a la vista y cuestan muy distinto. Te decimos cuál corresponde a tu operación antes de cotizar.',
  },
  {
    q: '¿Qué son TPP y THL, y por qué importan?',
    a: 'TPP mide la protección térmica y THL la capacidad de disipar calor del cuerpo. Los mínimos de referencia NFPA son TPP 35 y THL 205. Buscar el TPP más alto posible es un error: si el THL queda bajo, aumenta el estrés térmico de quien trabaja dentro del traje. Por eso conviene fijar ambos valores en el pliego, medidos sobre el mismo composite.',
  },
  {
    q: '¿Cuánto dura un traje estructural?',
    a: 'Bajo NFPA 1850, el retiro es a los 10 años desde la fecha de fabricación, incluso si el traje nunca se usó. Además requiere inspección avanzada anual y dos lavados avanzados por año. Revisa siempre la fecha de fabricación en la etiqueta antes de aceptar un pedido.',
  },
  {
    q: '¿Cuánto cuesta un traje de bombero?',
    a: 'No publicamos precios porque el costo depende del composite (PBI, Nomex o Kevlar en cada capa), la norma que exige tu pliego, las tallas y si compras por pieza o el conjunto completo. Cotizamos en día hábil con ficha técnica por partida y precio por escrito, sin compra mínima. Un traje de brigadista y uno estructural certificado se parecen a la vista y cuestan muy distinto: por eso preguntamos primero por tu operación.',
  },
  {
    q: '¿Cuánto pesa un traje de bombero?',
    a: 'Depende de la familia y del modelo. En el Romak Fire Protector, la ficha declara 2.5 kg de chaquetón y 1.88 kg de pantalón: unos 4.4 kg el traje estructural sin tirantes. Con casco, monja, botas, guantes y equipo de respiración autónoma, un conjunto completo queda como referencia entre 20 y 35 kg según configuración y cilindro. El peso exacto se confirma en la ficha técnica de cada modelo.',
  },
  {
    q: '¿Qué tipos de trajes para bomberos existen?',
    a: 'Hay siete familias y no son intercambiables. Estructural para ataque interior en edificaciones, brigadista para conato en industria y forestal para incendio de vegetación. De aproximación o aluminizado para calor radiante y de entrada para un ingreso breve a la flama. De extricación para rescate vehicular y Hazmat para protección química. Cada una se elige por el riesgo de tu operación, no por el precio.',
  },
  {
    q: '¿Cómo se llama el traje de los bomberos?',
    a: 'En México se le llama traje de bombero, traje estructural, traje contra incendio o equipo de protección estructural; en el habla común, uniforme de bombero. En catálogos de importación aparece como turnout gear o bunker gear. Se compone de chaquetón y pantalonera de tres capas, y se completa con casco, monja, guantes, botas y equipo de respiración autónoma (ERA). El traje de brigadista, el forestal y el de aproximación son familias distintas, no sinónimos.',
  },
  {
    q: '¿Qué necesito para una licitación o compra de gobierno?',
    a: 'Normalmente ficha técnica en formato de licitación, certificado de laboratorio del conjunto, carta de distribuidor autorizado, CFDI 4.0 con las partidas correspondientes y acta de entrega-recepción. Preparamos el expediente y asistimos a junta de aclaraciones.',
  },
  {
    q: '¿LORICA entrega trajes para bomberos en todo México?',
    a: 'Sí. Con más de 35 años equipando bomberos, atendemos, cotizamos y entregamos en los 32 estados de la República. La cotización por WhatsApp incluye ficha técnica y CFDI; enviamos a estación o domicilio, por pieza o conjunto completo.',
  },
];

// ItemList de la home: familias + complementos con página real.
const directoryItems = [
  ...PRODUCT_CATEGORIES.map((c) => ({ name: c.nombre, url: `${SITE.url}/trajes/${c.slug}/` })),
  ...complementos.flatMap((c) => (c.href ? [{ name: c.titulo, url: `${SITE.url}${c.href}` }] : [])),
];

// Últimos 4 artículos del blog: la home enlaza al contenido que
// resuelve las dudas previas a la cotización.
const ultimosPosts = (await getPosts()).slice(0, 4);
---
<BaseLayout
  pageType="home"
  path="/"
  title={SEO_HOME.title}
  description={SEO_HOME.description}
  keywords={SEO_HOME.keywords}
  faqs={faqs}
  directoryItems={directoryItems}
>
  <Hero {...hero} solid />
  <QuickNav />

  <!-- 0 · Índice de categorías del catálogo (4 cards por fila) -->
  <section class="section" id="categorias">
    <div class="container">
      <SectionHeading
        eyebrow="Categorías de equipo para bomberos"
        title="Equipo para bomberos: trajes, cascos, botas, guantes y más"
        duo={[
          'Reunimos en un solo proveedor el equipo para bomberos completo. Empieza por los <a href="/trajes/">trajes para bomberos</a> por familia de riesgo y sigue con el <a href="/equipo-de-proteccion/">equipo de protección</a>: <a href="/cascos/">cascos</a>, <a href="/equipo-de-respiracion-autonoma/">equipo de respiración autónoma</a>, <a href="/botas/">botas</a>, <a href="/guantes/">guantes</a> y monjas. La unidad se completa con <a href="/rescate-y-herramientas/">herramientas, mangueras y equipo de rescate</a>.',
          'Elige la categoría y entra a sus tipos y modelos con ficha técnica. Cotizamos por pieza o conjunto completo, con factura CFDI 4.0, sin compra mínima y con envío a los 32 estados.',
        ]}
      />
      <CategoryTiles />
    </div>
  </section>

  <!-- 0b · Spotlights de categoría: texto comercial SEO + galería (uno por categoría) -->
  <CategorySpotlights />

  <!-- 1 · Trajes: grid principal de categorías (TR-01…) -->
  <section class="section section--alt" id="catalogo">
    <div class="container">
      <SectionHeading
        eyebrow="Trajes para bomberos"
        title="Siete familias de trajes para bomberos, una por tipo de riesgo"
        duo={[
          'Los <a href="/trajes/">trajes para bomberos</a> no son un producto único: cada familia se construye para un riesgo distinto. El estructural es para incendio en edificaciones y el de brigadista, para fuego incipiente en industria. El forestal trabaja en línea de fuego; los de aproximación y de entrada, frente a calor radiante y flama. El de extricación sirve para rescate y el Hazmat, para materiales peligrosos. No son intercambiables.',
          'Elige la categoría que corresponde a tu operación y consulta su ficha técnica: composite por capa, norma de referencia y piezas que se pueden reponer por separado.',
        ]}
      />
      <TileGrid>
        {trajes.map((c) => <TileCard {...c} />)}
      </TileGrid>

      <p class="catalogo-cta">
        <a href="/trajes/">Guía completa de familias de trajes para bomberos →</a>
      </p>

    </div>
  </section>

  <!-- 1b · Modelos reales de traje (palanca SEO del clúster «trajes de bomberos») -->
  <section class="section" id="modelos">
    <div class="container">
      <SectionHeading
        eyebrow="Modelos disponibles"
        title="Trajes de bomberos Romak Fire, Sköld y Lakeland con ficha técnica"
        duo={[
          'En LORICA cotizamos <a href="/trajes/">trajes de bombero profesional</a> de Romak Fire, Sköld y Lakeland en cuatro familias: estructural, brigadista, forestal y aproximación. Cada modelo tiene su ficha técnica, foto del fabricante y configuración por escrito antes de cotizar.',
          'Cada modelo muestra su estatus normativo tal como lo declara el fabricante: certificado UL con número, declarado, equivalente o solo materiales. Sumamos capa exterior, barreras y tallas para que compares ofertas con el mismo criterio. Nunca presentamos como certificado un modelo que no lo está.',
        ]}
      />
      <ModelosGrid />
    </div>
  </section>

  <!-- 13 · FAQ + contacto -->
  <section class="section" id="faq">
    <div class="container">
      <SectionHeading
        eyebrow="Preguntas frecuentes"
        title="Lo que conviene saber antes de cotizar"
        duo={[
          'Respuestas breves a lo que más nos preguntan al cotizar trajes de bombero: norma vigente, diferencia entre traje estructural y de brigadista, TPP y THL, vida útil y compra por pieza o conjunto.',
          'También respondemos <a href="/blog/cuanto-cuesta-un-traje-de-bombero/">cuánto cuesta un traje de bombero</a> y qué documentación pide una licitación. Si tu duda no está aquí, escríbenos por WhatsApp con tu operación y el número de elementos, y te respondemos en día hábil.',
        ]}
      />
      <FAQWithContact items={faqs} />
    </div>
  </section>

  <!-- Blog técnico: interlinking al contenido editorial -->
  <section class="section section--alt" id="blog">
    <div class="container">
      <SectionHeading
        eyebrow="Blog técnico"
        title="Lo que preguntan por teléfono, explicado a fondo"
        duo={[
          'Guías de especificación, normas vigentes, comparativas entre familias y compra pública sobre trajes para bomberos. Las escribe gente del ramo, sin copiar fichas de fabricante, para que decidas con información antes de emitir tu requisición.',
          'Empieza por <a href="/blog/como-elegir-traje-para-bomberos/">cómo elegir un traje para bomberos</a> o por <a href="/blog/nfpa-1970-que-cambio/">qué cambió con la NFPA 1970</a>. Cada guía enlaza al catálogo correspondiente y te lleva a cotizar por WhatsApp cuando ya sabes qué necesitas.',
        ]}
      />
      <div class="grid-cards grid-cards--4">
        {ultimosPosts.map((a, i) => (
          <PostCard
            href={postUrl(a)}
            title={a.data.title}
            resumen={a.data.resumen}
            categoria={a.data.categoria}
            lectura={readingTime(a.body)}
            image={a.data.imagen}
            imageAlt={a.data.imagenAlt}
            destacado={a.data.destacado}
            index={i}
          />
        ))}
      </div>
      <p class="blog-cta"><a href="/blog/">Blog técnico de trajes para bomberos: todas las guías →</a></p>
    </div>
  </section>
  <QuoteCTA id="cotizar" />
</BaseLayout>

<style>
  .blog-cta { margin: 2.2rem 0 0; }
  .blog-cta a { font-weight: 800; text-decoration: none; font-size: 1.02rem; }
  .blog-cta a:hover { text-decoration: underline; }
  .catalogo-cta { margin: 2.2rem 0 0; }
  .catalogo-cta a { font-weight: 800; text-decoration: none; font-size: 1.02rem; }
  .catalogo-cta a:hover { text-decoration: underline; }
  .marcas__nota {
    margin: 2rem 0 0;
    padding-top: 1.4rem;
    border-top: var(--border);
    font-size: 0.86rem;
    color: var(--color-gray);
    max-width: 92ch;
  }
</style>
