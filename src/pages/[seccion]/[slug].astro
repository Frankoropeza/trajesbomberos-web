---
import type { GetStaticPaths } from 'astro';
import ModeloFicha from '@components/ModeloFicha.astro';
import { SECCIONES } from '@lib/catalogo/secciones';
import { tiposDeSeccion } from '@lib/catalogo/tipos';
import { modelosDeSeccion } from '@lib/catalogo/modelos';

export const getStaticPaths = (() => SECCIONES.flatMap((seccion) => [
  ...tiposDeSeccion(seccion.slug).map((entry) => ({ params: { seccion: seccion.slug, slug: entry.slug }, props: { seccion, entry, kind: 'tipo' as const } })),
  ...modelosDeSeccion(seccion.slug).map((entry) => ({ params: { seccion: seccion.slug, slug: entry.id }, props: { seccion, entry, kind: 'modelo' as const } })),
])) satisfies GetStaticPaths;

const { seccion, entry, kind } = Astro.props;
const path = `/${seccion.slug}/${kind === 'tipo' ? entry.slug : entry.id}/`;
---
<ModeloFicha {seccion} {entry} {kind} {path} />
