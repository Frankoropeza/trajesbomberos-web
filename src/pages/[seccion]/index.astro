---
// L3 · hub de sección del catálogo (/cascos/, /botas/, …) con la plantilla CategoriaL2, igual que
// las L2. Texto: src/content/categorias/<seccion>.md (Zod estricto; sin .md, el build falla).
// Datos de catálogo: tipos (cards y enlaces), modelos (retícula, tabla e ItemList) y guías.
// Migas: Inicio › L2 de la que cuelga (l2DeSeccion) › sección.
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import CategoriaL2 from '@components/l2/CategoriaL2.astro';
import { SITE } from '@config/site';
import { SECCIONES } from '@lib/catalogo/secciones';
import { modelosDeSeccion, urlModelo } from '@lib/catalogo/modelos';
import { l2DeSeccion, tilesTipos, tilesDeTarjetas, tilesExtra, spotlightDeModulo, filaModelo, guiasL2, modelosPorId } from '@lib/l2';

export const getStaticPaths = (() => {
  // trajes y marcas tienen su propia página L2 (src/pages/trajes/, src/pages/marcas/).
  const reserved = new Set(['trajes', 'marcas', 'blog', 'empresa', 'contacto', 'productos', 'aviso-de-privacidad', 'terminos-y-condiciones', '404']);
  return SECCIONES
    .filter((seccion) => !reserved.has(seccion.slug))
    .map((seccion) => ({ params: { seccion: seccion.slug }, props: { seccion } }));
}) satisfies GetStaticPaths;

const { seccion } = Astro.props;
const entrada = await getEntry('categorias', seccion.slug);
if (!entrada) throw new Error(`[L3] Falta src/content/categorias/${seccion.slug}.md para el hub /${seccion.slug}/.`);
const d = entrada.data;
const { Content } = await render(entrada);

// Prefijo del código de card por sección (CA-01, BO-02…).
const PREFIJO_L3: Record<string, string> = { cascos: 'CA-', 'equipo-de-respiracion-autonoma': 'ER-', botas: 'BO-', guantes: 'GU-', capuchas: 'CP-', kits: 'KI-', rescate: 'RE-', herramientas: 'HE-', 'mangueras-y-accesorios': 'MA-', accesorios: 'AC-' };
const prefijo = PREFIJO_L3[seccion.slug] ?? 'SE-';
// Cards: una por tipo de la sección (o las tarjetas del .md si la sección no tiene tipos) + cierre.
const base = d.tarjetas ? tilesDeTarjetas(d, prefijo) : tilesTipos(seccion.slug, prefijo);
const tiles = [...base, ...tilesExtra(d, prefijo, base.length)];
const spotlights = d.modulos.map((modulo, index) => spotlightDeModulo(modulo, index));
const todos = modelosDeSeccion(seccion.slug);
// Retícula: modelosDestacados del .md si existen; tabla e ItemList: todos los modelos.
const modelos = d.modelosDestacados ? modelosPorId(d.modelosDestacados) : todos;
// Secciones sin tipos (capuchas): la tercera columna es el código del modelo.
const columnas = ['modelo', 'marca', todos.some((m) => m.tipo) ? 'tipo' : 'codigo', 'material', 'norma', 'estatus'] as const;
const filasModelos = todos.map((modelo) => filaModelo(modelo, columnas));
const directoryItems = [
  ...tiles.map((tile) => ({ name: tile.titulo, url: `${SITE.url}${tile.href}` })),
  ...todos.map((modelo) => ({ name: `${modelo.marca} ${modelo.nombre}`, url: `${SITE.url}${urlModelo(modelo)}` })),
];
const guias = await guiasL2(d);
---
<CategoriaL2 {d} {tiles} {spotlights} {modelos} {filasModelos} {directoryItems} {guias} parent={l2DeSeccion(seccion.slug)}><Content /></CategoriaL2>
