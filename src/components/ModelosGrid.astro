---
// ModelosGrid: modelos reales del catálogo con el diseño homologado del sitio
// (TileGrid + TileCard: imagen 4:3, título, texto, 4 subcategorías, botón con
// palabra clave). Es la palanca SEO del clúster «trajes de bomberos»: las fichas
// de modelo con foto real son lo que gana la SERP. Data-driven desde MODELOS.
import TileGrid from '@components/home/TileGrid.astro';
import TileCard from '@components/home/TileCard.astro';
import { MODELOS } from '@lib/catalogo/data';
import { tileDeModelo } from '@lib/catalogo/tiles';
import type { Modelo } from '@lib/catalogo/types';

interface Props {
  /** Lista explícita (tiene prioridad sobre los filtros). */
  modelos?: Modelo[];
  familia?: string;    // limitar a una familia de traje
  seccion?: string;    // limitar a una sección del catálogo (por defecto: trajes)
  limit?: number;
  exclude?: string;    // id del modelo actual (no autoenlazar)
  cols?: 3 | 4;        // 3 cuando la rejilla convive con un sidebar
}
const { modelos: lista, familia, seccion = 'trajes', limit, exclude, cols = 4 } = Astro.props as Props;

const ORDEN = ['estructural', 'brigadista', 'forestal', 'aproximacion', 'entrada', 'extricacion', 'hazmat'];
let modelos = lista ?? MODELOS.filter((m) => m.seccion === seccion && (seccion !== 'trajes' || m.familia));
if (!lista) {
  if (familia) modelos = modelos.filter((m) => m.familia === familia);
  if (seccion === 'trajes') modelos = [...modelos].sort((a, b) => ORDEN.indexOf(a.familia!) - ORDEN.indexOf(b.familia!));
}
modelos = modelos.filter((m) => m.id !== exclude);
if (limit) modelos = modelos.slice(0, limit);
---
{modelos.length > 0 && (
  <TileGrid {cols}>
    {modelos.map((m) => <TileCard {...tileDeModelo(m)} />)}
  </TileGrid>
)}
