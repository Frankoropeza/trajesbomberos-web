---
// StatsRow: fila de 4 indicadores del directorio (card blanca con
// borde superior rojo, cifra en display). Cifras siempre calculadas.
export interface Stat { n: string; label: string; note?: string }
interface Props { stats: Stat[] }
const { stats } = Astro.props as Props;
---
<ul class="sr">
  {stats.map((s) => (
    <li class="sr__item">
      <span class="sr__n">{s.n}</span>
      <span class="sr__label">{s.label}</span>
      {s.note && <span class="sr__note">{s.note}</span>}
    </li>
  ))}
</ul>

<style>
  .sr {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0 0 clamp(2rem, 3.5vw, 3rem);
    padding: 0;
  }
  .sr__item {
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.3rem 1.2rem;
    background: var(--color-white);
    border: 1px solid rgb(20 22 26 / 0.14);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius);
  }
  .sr__n {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3vw, 2.9rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-dark);
    font-variant-numeric: tabular-nums;
  }
  .sr__label { margin-top: 0.5rem; font-weight: 700; color: var(--color-dark); }
  .sr__note { margin-top: 0.15rem; font-size: 0.84rem; color: var(--color-gray); }
  @media (max-width: 900px) { .sr { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } }
  @media (max-width: 480px) { .sr__item { padding: 1rem; } }
</style>
