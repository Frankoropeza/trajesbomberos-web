---
// DataTable: tabla de datos del directorio (cabecera tinta con filete
// rojo, filas con borde gris). La primera celda de cada fila es <th>.
// Celdas: texto o { text, href }. Columnas numéricas alineadas a la
// derecha; `hideMobile` oculta la columna ≤640px.
export interface Col { label: string; num?: boolean; hideMobile?: boolean; accent?: boolean; nowrap?: boolean }
export type Cell = string | number | { text: string; href: string };
interface Props { caption: string; cols: Col[]; rows: Cell[][] }
const { caption, cols, rows } = Astro.props as Props;
const cls = (c: Col) => [c.num && 'num', c.hideMobile && 'hm', c.accent && 'acc', c.nowrap && 'nw'].filter(Boolean).join(' ') || undefined;
---
<figure class="dt">
  <figcaption>{caption}</figcaption>
  <div class="dt__wrap">
    <table>
      <thead><tr>{cols.map((c) => <th scope="col" class={cls(c)}>{c.label}</th>)}</tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            {r.map((cell, i) => {
              const content = typeof cell === 'object' ? <a href={cell.href}>{cell.text}</a> : cell;
              return i === 0 && !cols[0].num
                ? <th scope="row" class={cls(cols[i])}>{content}</th>
                : <td class={cls(cols[i])}>{content}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>

<style>
  .dt {
    margin: 0;
    background: var(--color-white);
    border: 1px solid rgb(20 22 26 / 0.14);
    border-radius: var(--radius);
    overflow: hidden;
  }
  figcaption {
    padding: 0.85rem 1.1rem;
    background: var(--color-ink);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    border-bottom: 3px solid var(--color-primary);
  }
  .dt__wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  thead th {
    padding: 0.6rem 1.1rem;
    background: var(--color-light);
    color: var(--color-gray);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    border-bottom: var(--border);
  }
  tbody th, tbody td {
    padding: 0.7rem 1.1rem;
    border-bottom: var(--border);
    text-align: left;
    vertical-align: top;
    color: var(--color-gray);
  }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  tbody th { font-weight: 700; color: var(--color-dark); }
  tbody a { color: var(--color-dark); font-weight: 700; text-decoration: none; }
  tbody a:hover { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
  .dt th.num, .dt td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dt td.num { font-weight: 700; color: var(--color-dark); }
  .dt td.acc, .dt th.acc { color: var(--color-primary); font-family: var(--font-display); font-weight: 700; }
  .dt .nw { white-space: nowrap; }
  @media (max-width: 640px) { .hm { display: none; } }
  @media (max-width: 480px) { tbody th, tbody td, thead th { padding-inline: 0.75rem; } }
</style>
