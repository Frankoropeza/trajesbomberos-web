---
// Header: MENU en site.ts es la única fuente para escritorio y móvil.
// Header valida cada href contra rutas.ts antes de renderizarlo: una ruta
// retirada del catálogo se omite y deja un aviso útil durante el build.
import { CONTACT, MENU, SITE, WA_MESSAGES, type MenuColumn, type MenuFeature, type MenuItem, type MenuLink } from '@config/site';
import { getCollection } from 'astro:content';
import { rutaExiste } from '@lib/rutas';
import { waUrl } from '@lib/wa';
import { responsive } from '@lib/img';

const path = Astro.url.pathname;
const posts = await getCollection('blog');
const titulosPost = new Map(posts.map((post) => [`/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`, post.data.title]));
const linkConTitulo = (link: MenuLink) => {
  const titulo = link.href ? titulosPost.get(link.href) : undefined;
  return titulo && titulo.length <= 48 ? { ...link, label: titulo } : link;
};
const rutaValida = (link: MenuLink) => {
  if (!link.href) return true;
  const existe = rutaExiste(link.href);
  if (!existe) console.warn(`[Header] ruta inexistente: ${link.href}`);
  return existe;
};
const columnasValidas = (columns: MenuColumn[]) => columns
  .map((column) => ({
    ...column,
    href: column.href && rutaValida({ label: column.title, href: column.href }) ? column.href : undefined,
    links: column.links.map(linkConTitulo).filter(rutaValida),
  }))
  .filter((column) => column.links.length > 0 || column.href);
const featureValida = (feature?: MenuFeature) => feature && rutaValida(feature.cta) ? feature : undefined;
const menu = MENU.map((item) => ({ ...item, columns: columnasValidas(item.columns), feature: featureValida(item.feature) }))
  .filter((item) => rutaValida(item.overview));
const isActive = (item: MenuItem) => item.match.some((prefix) => path.startsWith(prefix));
const current = (href?: string) => href && href === path ? 'page' : undefined;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name}, trajes para bomberos: inicio`}>
      <span class="brand-mark" aria-hidden="true"><img src="/images/marca/lorica-icono.svg" width="34" height="40" alt="" /></span>
      <span class="brand-text"><img class="brand-name" src="/images/marca/lorica-wordmark.svg" width="152" height="21" alt={SITE.name} /><span class="brand-claim">Trajes para bomberos</span></span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {menu.map((item, index) => (
          <li class:list={['nav-item', { 'nav-item--active': isActive(item) }]} data-menu={String(index)}>
            <button class="nav-trigger" type="button" aria-expanded="false" aria-controls={`mega-${index}`}>
              {item.label}<svg class="nav-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <section class:list={['mega', `mega--${index}`]} id={`mega-${index}`} aria-label={item.label}>
              <div class="mega__body"><div class="container mega__grid">
                {item.columns.map((column) => (
                  <div class="mega__column">
                    {column.href ? <a class="mega__heading mega__heading--link" href={column.href} aria-current={current(column.href)}>{column.img && <img src={column.img} {...responsive(column.img, '48px')} width="48" height="48" loading="lazy" decoding="async" alt="" />}<span>{column.title}</span><span class="mega__arrow" aria-hidden="true">→</span></a> : <p class="mega__heading">{column.img && <img src={column.img} {...responsive(column.img, '48px')} width="48" height="48" loading="lazy" decoding="async" alt="" />}<span>{column.title}</span></p>}
                    <ul class="mega__links">{column.links.map((link) => <li>{link.href ? <a href={link.href} aria-current={current(link.href)}><span>{link.label}</span>{link.desc && <small>{link.desc}</small>}</a> : <span class="mega__plain">{link.label}</span>}</li>)}</ul>
                  </div>
                ))}
                {item.feature && <aside class="mega__feature">{item.feature.img && <img src={item.feature.img} {...responsive(item.feature.img, '340px')} width="640" height="400" loading="lazy" decoding="async" alt={item.feature.alt ?? ''} />}<p>{item.feature.eyebrow}</p><p class="mega__feature-title">{item.feature.title}</p><span>{item.feature.text}</span><a class="btn mega__feature-cta" href={item.feature.cta.href}>{item.feature.cta.label}</a></aside>}
              </div></div>
              <footer class="mega__footer"><div class="container mega__footer-inner"><a class="mega__overview" href={item.overview.href}>{item.overview.label} <span aria-hidden="true">→</span></a><span class="mega__contact"><a href={waUrl(WA_MESSAGES.cotizar)} target="_blank" rel="noopener nofollow">Cotizar por WhatsApp</a><a href={`tel:${CONTACT.telefonoHref}`}>{CONTACT.telefono}</a></span></div></footer>
            </section>
          </li>
        ))}
      </ul>
      <div class="container nav-drawer__extra"><a href="/empresa/">Proveedor de trajes para bomberos</a><a href="/contacto/">Contacto para cotizar trajes</a></div>
      <div class="nav-drawer__actions"><div class="container nav-drawer__actions-inner"><div class="nav-drawer__buttons"><a class="btn btn--wa" href={waUrl(WA_MESSAGES.cotizar)} target="_blank" rel="noopener nofollow">Cotizar por WhatsApp</a><a class="btn btn--ghost" href={`tel:${CONTACT.telefonoHref}`}>Llamar {CONTACT.telefono}</a></div><p>{CONTACT.horario}</p></div></div>
    </nav>
    <div class="header-actions"><a class="header-phone" href={`tel:${CONTACT.telefonoHref}`}><span>Llámanos</span>{CONTACT.telefono}</a><a class="btn header-cta" href={waUrl(WA_MESSAGES.cotizar)} target="_blank" rel="noopener nofollow">Cotizar trajes</a></div>
    <a class="btn header-cta-mobile" href={waUrl(WA_MESSAGES.cotizar)} target="_blank" rel="noopener nofollow">Cotizar trajes</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú"><svg class="nav-toggle__open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg><svg class="nav-toggle__close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
  </div>
  <button class="mega-scrim" type="button" aria-label="Cerrar menú desplegable" hidden></button>
</header>
<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const scrim = document.querySelector<HTMLButtonElement>('.mega-scrim');
  const navItems = [...document.querySelectorAll<HTMLElement>('.nav-item')];
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const siteNav = document.getElementById('site-nav');
  const desktopQuery = window.matchMedia('(min-width: 1280px)');
  let closeTimer: number | undefined;
  let hoverOpenedAt = 0;
  // Borde inferior real del header (varía con la topbar visible): ancla del velo y del cajón.
  // Rendimiento (CWV): la variable vive en el <header>, no en :root —escribirla en :root
  // invalidaba el estilo de TODO el documento— y solo se mide cuando hay un panel abierto.
  // Antes se medía al cargar (reflow forzado de ~430 ms en PSI) y en cada evento de scroll.
  // Siempre se LEE antes de ESCRIBIR (lectura → escritura) para no forzar layout.
  let lastBottom = -1;
  let frame = 0;
  const syncBottom = () => {
    if (!header) return;
    const bottom = Math.max(0, Math.round(header.getBoundingClientRect().bottom));
    if (bottom !== lastBottom) { lastBottom = bottom; header.style.setProperty('--hdr-bottom', `${bottom}px`); }
  };
  const menuAbierto = () => toggle?.getAttribute('aria-expanded') === 'true' || navItems.some((item) => item.classList.contains('is-open'));
  const syncEnFrame = () => {
    if (frame || !menuAbierto()) return;
    frame = requestAnimationFrame(() => { frame = 0; syncBottom(); });
  };
  window.addEventListener('scroll', syncEnFrame, { passive: true });
  window.addEventListener('resize', syncEnFrame);
  // La clase «js» va en el header (solo invalida su subárbol), no en <html>.
  header?.classList.add('js');
  const closeDesktop = () => {
    window.clearTimeout(closeTimer);
    navItems.forEach((item) => { item.classList.remove('is-open'); item.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'false'); });
    if (scrim) scrim.hidden = true;
  };
  const openDesktop = (item: HTMLElement) => {
    window.clearTimeout(closeTimer);
    const wasOpen = item.classList.contains('is-open');
    if (!wasOpen) syncBottom(); // lectura antes de cualquier escritura
    closeDesktop();
    if (wasOpen) return;
    item.classList.add('is-open');
    item.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'true');
    if (scrim) scrim.hidden = false;
  };
  const closeDrawer = (restoreFocus = false) => {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú');
    header?.classList.remove('is-drawer-open');
    root.classList.remove('nav-open');
    if (restoreFocus) toggle?.focus();
  };
  const openDrawer = () => {
    if (!toggle || desktopQuery.matches) return;
    syncBottom();
    closeDesktop();
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar menú');
    header?.classList.add('is-drawer-open');
    root.classList.add('nav-open');
    navItems[0]?.querySelector<HTMLButtonElement>('.nav-trigger')?.focus();
  };
  const toggleDrawerItem = (item: HTMLElement) => {
    const open = item.classList.contains('is-open');
    navItems.forEach((other) => {
      other.classList.remove('is-open');
      other.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
    if (!open) {
      item.classList.add('is-open');
      item.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'true');
    }
  };
  navItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.nav-trigger');
    trigger?.addEventListener('click', () => {
      if (!desktopQuery.matches) {
        toggleDrawerItem(item);
        return;
      }
      // Un clic justo después de abrir por hover no debe cerrar el panel.
      if (item.classList.contains('is-open') && Date.now() - hoverOpenedAt < 600) return;
      openDesktop(item);
    });
    trigger?.addEventListener('keydown', (event) => {
      if (!desktopQuery.matches || event.key !== 'ArrowDown') return;
      event.preventDefault();
      if (!item.classList.contains('is-open')) openDesktop(item);
      item.querySelector<HTMLAnchorElement>('.mega a')?.focus();
    });
    item.addEventListener('pointerenter', (event) => {
      if (!desktopQuery.matches || event.pointerType !== 'mouse') return;
      window.clearTimeout(closeTimer);
      if (!item.classList.contains('is-open')) { openDesktop(item); hoverOpenedAt = Date.now(); }
    });
    item.addEventListener('pointerleave', (event) => { if (desktopQuery.matches && event.pointerType === 'mouse') closeTimer = window.setTimeout(closeDesktop, 180); });
  });
  document.addEventListener('click', (event) => { if (desktopQuery.matches && header && !header.contains(event.target as Node)) closeDesktop(); });
  scrim?.addEventListener('click', () => { if (desktopQuery.matches) closeDesktop(); });
  toggle?.addEventListener('click', () => toggle.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer());
  siteNav?.addEventListener('click', (event) => { if (!desktopQuery.matches && (event.target as HTMLElement).closest('a')) closeDrawer(); });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') === 'true') closeDrawer(true);
    else { const active = document.querySelector<HTMLElement>('.nav-item.is-open'); if (active) { const trigger = active.querySelector<HTMLButtonElement>('.nav-trigger'); closeDesktop(); trigger?.focus(); } }
  });
  desktopQuery.addEventListener('change', () => { closeDesktop(); closeDrawer(); });
</script>
<style>
  .site-header {
    position: relative;
    z-index: 100;
    background: rgb(255 255 255 / .98);
    border-bottom: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    min-height: var(--header-height);
    gap: clamp(.75rem,1.6vw,1.5rem);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: .65rem;
    color: var(--color-dark);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .brand-mark {
    display: flex;
  }

  .brand-mark img {
    width: 34px;
    height: 40px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    line-height: 1;
  }

  .brand-name {
    display: block;
    width: 152px;
    height: auto;
  }

  .brand-claim {
    color: var(--color-gray);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .site-nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  .nav-list {
    display: flex;
    justify-content: center;
    align-items: stretch;
    height: var(--header-height);
    gap: clamp(.55rem,1.3vw,1.45rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: flex;
  }

  .nav-trigger {
    border: 0;
    box-shadow: none;
    background: transparent;
    color: var(--color-gray);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: 0 .1rem;
    font: inherit;
    font-size: clamp(.76rem,1vw,.9rem);
    font-weight: 800;
    white-space: nowrap;
  }

  .nav-trigger[aria-expanded='true'],.nav-item--active .nav-trigger {
    color: var(--color-primary);
  }

  .nav-item--active .nav-trigger {
    box-shadow: inset 0 -3px var(--color-primary);
  }

  .nav-caret {
    flex: 0 0 auto;
  }

  .mega {
    display: none;
    position: absolute;
    inset: 100% 0 auto;
    z-index: 3;
    background: var(--color-white);
    border-top: 3px solid var(--color-primary);
    box-shadow: var(--shadow-lg);
    max-height: calc(100dvh - var(--hdr-bottom,calc(var(--header-height) + var(--topbar-height))));
    overflow-y: auto;
  }

  .mega__body {
    padding: 1.4rem 0 1.25rem;
  }

  .mega__grid {
    display: grid;
    gap: clamp(1rem,1.65vw,2rem);
    align-items: start;
  }

  .mega--0 .mega__grid {
    grid-template-columns: 1.2fr 1fr 1fr 1.15fr;
  }

  .mega--1 .mega__grid,.mega--2 .mega__grid {
    grid-template-columns: repeat(5,minmax(0,1fr));
  }

  .mega--3 .mega__grid,.mega--4 .mega__grid {
    grid-template-columns: 1fr 1fr 1fr 1.15fr;
  }

  .mega__column {
    min-width: 0;
  }

  .mega__heading {
    align-items: center;
    color: var(--color-gray-soft);
    display: flex;
    gap: .55rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    line-height: 1.2;
    margin: 0 0 .55rem;
    text-transform: uppercase;
  }

  .mega__heading--link {
    color: var(--color-dark);
    font-size: .84rem;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: none;
  }

  .mega__heading img {
    border-radius: 4px;
    flex: 0 0 48px;
    height: 48px;
    object-fit: cover;
    width: 48px;
  }

  .mega__arrow {
    color: var(--color-primary);
    font-size: 1.1rem;
  }

  .mega__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega__links a {
    border-radius: var(--radius);
    display: block;
    padding: .38rem .45rem;
    text-decoration: none;
  }

  .mega__links a>span {
    color: var(--color-dark);
    display: block;
    font-size: .92rem;
    font-weight: 700;
    line-height: 1.22;
  }

  @media (hover: hover) {
    .nav-trigger:hover,
    .mega__heading--link:hover {
      color: var(--color-primary);
    }
    .mega__links a:hover {
      background: var(--color-light);
    }
    .mega__links a:hover > span {
      color: var(--color-primary);
    }
  }

  .mega__links small {
    color: var(--color-gray-soft);
    display: block;
    font-size: .78rem;
    line-height: 1.25;
    margin-top: .12rem;
  }

  .mega__plain {
    color: var(--color-gray);
    display: block;
    font-size: .88rem;
    line-height: 1.45;
    padding: .38rem .45rem;
  }

  .mega__feature {
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .mega__feature>img {
    aspect-ratio: 16 / 10;
    display: block;
    object-fit: cover;
    width: 100%;
  }

  .mega__feature>p {
    color: var(--color-gray-soft);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    margin: .75rem .8rem .25rem;
    text-transform: uppercase;
  }

  .mega__feature .mega__feature-title {
    font-weight: 800;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-dark);
    font-size: 1rem;
    line-height: 1.18;
    margin: 0 .8rem .35rem;
  }

  .mega__feature>span {
    color: var(--color-gray);
    display: block;
    font-size: .82rem;
    line-height: 1.4;
    margin: 0 .8rem .75rem;
  }

  .mega__feature-cta {
    display: block;
    font-size: .78rem;
    line-height: 1.25;
    margin: 0 .8rem .8rem;
    padding: .65rem .75rem;
    text-align: center;
  }

  .mega__footer {
    background: var(--color-light);
    border-top: var(--border);
  }

  .mega__footer-inner {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    min-height: 48px;
    padding-block: .55rem;
  }

  .mega__overview {
    color: var(--color-primary);
    font-size: .9rem;
    font-weight: 800;
    text-decoration: none;
  }

  .mega__contact {
    display: flex;
    gap: 1rem;
    font-size: .82rem;
    font-weight: 700;
  }

  .mega__contact a {
    color: var(--color-dark);
    text-decoration: none;
  }

  .mega__contact a:first-child {
    color: var(--color-wa);
  }

  .mega-scrim {
    background: rgb(15 18 22 / .35);
    border: 0;
    cursor: default;
    inset: var(--hdr-bottom,var(--header-height)) 0 0;
    position: fixed;
    width: 100%;
    z-index: -1;
  }

  .header-actions {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    gap: 1rem;
  }

  /* El teléfono solo cabe junto al menú en escritorio amplio (≥ 1440). */
  .header-phone {
    color: var(--color-dark);
    display: none;
    flex-direction: column;
    font-size: .92rem;
    font-weight: 800;
    line-height: 1.15;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-phone span {
    color: var(--color-gray-soft);
    font-size: 0.75rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .header-cta {
    padding: .68rem 1rem;
    white-space: nowrap;
  }

  .header-cta-mobile,.nav-toggle,.nav-drawer__extra,.nav-drawer__actions {
    display: none;
  }

  .site-header:not(.js) .nav-item:focus-within .mega {
    display: block;
  }

  @media (hover: hover) {
    .site-header:not(.js) .nav-item:hover .mega {
      display: block;
    }
  }

  .site-header.js .nav-item.is-open .mega {
    display: block;
  }

  a:focus-visible,button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (min-width: 1440px) {
    .header-phone {
      display: flex;
    }
  }

  @media (max-width: 1279px) {
    .header-actions {
      display: none;
    }
    .header-inner {
      justify-content: space-between;
    }
    .header-cta-mobile {
      display: inline-block;
      font-size: .8rem;
      margin-left: auto;
      padding: .6rem .85rem;
      width: auto;
    }
    .nav-toggle {
      align-items: center;
      background: transparent;
      border: var(--border);
      border-radius: var(--radius);
      color: var(--color-dark);
      cursor: pointer;
      display: grid;
      font-size: 1.65rem;
      height: 44px;
      line-height: 1;
      padding: 0;
      place-items: center;
      width: 44px;
    }
    .nav-toggle svg {
      display: block;
    }
    .nav-toggle__close {
      display: none!important;
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__open {
      display: none;
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__close {
      display: block!important;
    }
    .site-nav {
      background: var(--color-white);
      bottom: 0;
      display: flex;
      flex-direction: column;
      inset-inline: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      position: fixed;
      top: var(--hdr-bottom,var(--header-height));
      z-index: 4;
    }
    .site-header.js:not(.is-drawer-open) .site-nav {
      display: none;
    }
    .nav-list {
      align-items: stretch;
      display: block;
      flex: 0 0 auto;
      height: auto;
      list-style: none;
      margin: 0;
      padding: .25rem max(var(--container-px), env(safe-area-inset-left)) 1rem;
    }
    .nav-item {
      border-bottom: var(--border);
      display: block;
    }
    .nav-trigger {
      align-items: center;
      background: transparent;
      border: 0;
      color: var(--color-dark);
      cursor: pointer;
      display: flex;
      font: inherit;
      font-size: 1.05rem;
      font-weight: 800;
      height: 56px;
      justify-content: space-between;
      padding: 0;
      width: 100%;
    }
    .nav-caret {
      display: none;
    }
    /* En el cajón, el ítem de la sección actual se marca solo con color: el
       subrayado inferior es del megamenú de escritorio. */
    .nav-item--active .nav-trigger {
      box-shadow: none;
    }
    .nav-trigger::after {
      color: var(--color-primary);
      font-size: 1.4rem;
      content: '+';
    }
    .nav-trigger[aria-expanded='true']::after {
      content: '−';
    }
    .mega {
      border-top: 0;
      box-shadow: none;
      max-height: none;
      overflow: visible;
