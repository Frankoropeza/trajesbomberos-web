---
// CategorySpotlights (home): sección que va justo debajo del índice de
// 12 categorías (CategoryTiles). Un módulo <CategorySpotlight> por card
// del índice, en el mismo orden; 01 = Trajes. Datos en src/lib/spotlights/
// (un archivo por tanda, para editar en paralelo sin conflicto).
// Texto comercial con keyword principal («trajes para bomberos»,
// «traje de bombero») y enlaces internos a cada familia. Solo hechos ya
// verificados en el sitio: normas vigentes, sin precios, marcas como
// referencia de modelos cotizados. Botones con palabra clave.
import CategorySpotlight from './CategorySpotlight.astro';
import { SPOTLIGHTS } from '@lib/spotlights';
---
<section class="section spotlights" id="categorias-destacadas">
  <div class="container">
    {SPOTLIGHTS.map((s, i) => <CategorySpotlight {...s} flip={i % 2 === 1} />)}
  </div>
</section>

<style>
  .spotlights { padding-top: 0; }
  .spotlights :global(.spot + .spot) {
    margin-top: var(--section-y);
    padding-top: var(--section-y);
    border-top: var(--border);
  }
</style>
