---
import { responsive, SIZES } from '@lib/img';
// TileCard: card homologada de TODO el index (categorías, familias de
// traje, complementos). Estructura fija: imagen 4:3 → título (2 líneas
// reservadas) → texto (3 líneas) → 4 subcategorías → botón principal.
// Botones siempre con palabra clave (nunca "ver", "ir", "conocer").
// Va dentro de <TileGrid> (4 por fila). Cero animaciones/transiciones.
export interface TileSub { label: string; href: string; external?: boolean }
export interface TileProps {
  codigo: string;
  titulo: string;
  desc: string;
  href: string;
  cta: string;
  img: string;
  alt: string;
  pos?: string; // object-position de la foto (retrato vs. paisaje)
  subs: TileSub[];
  /** Foto de producto sobre fondo blanco: se muestra completa (contain) en vez de recortada. */
  fit?: 'cover' | 'contain';
  /** Estatus normativo del modelo (franja superior de la imagen). */
  estado?: { label: string; tone: 'good' | 'warn' | 'neutral' };
  /** Aviso sobre la imagen (p. ej. «Imagen ilustrativa»). */
  nota?: string;
  /** Enlace externo (WhatsApp): abre en pestaña nueva con rel seguro. */
  external?: boolean;
}
const { codigo, titulo, desc, href, cta, img, alt, pos, subs, fit = 'cover', estado, nota, external = false } = Astro.props as TileProps;
const ext = external ? { target: '_blank', rel: 'noopener nofollow' } : {};
---
<li class="ct">
  <a class:list={['ct__media', { 'ct__media--contain': fit === 'contain' }]} href={href} tabindex="-1" aria-hidden="true" {...ext}>
    <img src={img} {...responsive(img, SIZES.tile)} alt={alt} style={pos ? `object-position:${pos}` : undefined} width="800" height="600" loading="lazy" decoding="async" />
    {estado && <span class={`ct__estado ct__estado--${estado.tone}`}>{estado.label}</span>}
    {nota && <span class="ct__nota">{nota}</span>}
    <span class="ct__code">{codigo}</span>
  </a>
  <div class="ct__body">
    <h3 class="ct__title"><a href={href} {...ext}>{titulo}</a></h3>
    <p class="ct__desc">{desc}</p>
    <ul class="ct__subs" aria-label={`Subcategorías de ${titulo}`}>
      {subs.map((s) => (
        <li>
          <a class="ct__sub" href={s.href} aria-label={`${s.label}, ${titulo}`} {...(s.external ? { target: '_blank', rel: 'noopener nofollow' } : {})}>
            <span>{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="ct__cta" href={href} {...ext}>{cta}</a>
  </div>
</li>

<style>
  .ct {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid rgb(20 22 26 / 0.14);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* Imagen: proporción fija para todas las cards */
  .ct__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-light);
  }
  .ct__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
  }
  /* Fotos de producto sobre fondo blanco: completas, sin recorte */
  .ct__media--contain { background: var(--color-white); }
  .ct__media--contain img { object-fit: contain; padding: 2.2rem 0.5rem 0.4rem; box-sizing: border-box; }
  .ct__estado {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 1;
    padding: 0.3rem 0.6rem;
    border-left: 3px solid currentColor;
    background: rgb(255 255 255 / 0.96);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ct__estado--good { color: #176b3a; background: #e8f4ec; }
  .ct__estado--warn { color: #805400; background: #fff2d6; }
  .ct__estado--neutral { color: var(--color-gray); }
  .ct__nota {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.3rem 0.55rem;
    background: rgb(20 22 26 / 0.82);
    color: var(--color-white);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .ct__code {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.3rem 0.65rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .ct__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.15rem 1.2rem;
  }

  /* Título: 2 líneas reservadas → todas las cards alinean */
  .ct__title {
    margin: 0 0 0.55rem;
    font-size: 1.08rem;
    line-height: 1.25;
    min-height: calc(1.08rem * 1.25 * 2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ct__title a { color: var(--color-dark); text-decoration: none; }
  .ct__title a:hover { color: var(--color-primary); }

  /* Texto: 3 líneas reservadas */
  .ct__desc {
    margin: 0 0 1rem;
    font-size: 0.87rem;
    line-height: 1.5;
    color: var(--color-gray);
    min-height: calc(0.87rem * 1.5 * 3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Subcategorías: 4 filas de igual alto */
  .ct__subs {
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
    border-top: 1px solid rgb(20 22 26 / 0.12);
  }
  .ct__subs li { border-bottom: 1px solid rgb(20 22 26 / 0.12); }
  .ct__sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 46px;
    padding: 0.35rem 0.1rem;
    color: var(--color-dark);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }
  /* Flecha en CSS (antes un <svg>+<path> por enlace: ~270 nodos menos en la home) */
  .ct__sub::after {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    margin-right: 4px;
    border-top: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    transform: rotate(45deg);
  }
  .ct__sub:hover { color: var(--color-primary); }
  .ct__sub:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .ct__sub:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }

  /* Botón principal: siempre al fondo de la card */
  .ct__cta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0.55rem 0.9rem;
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
  }
  .ct__cta:hover { background: var(--color-dark); border-color: var(--color-dark); }
  .ct__cta:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  @media (max-width: 1279px) {
      .ct__body { padding: 1rem; }
  }
  @media (max-width: 1023px) {
    }
  @media (max-width: 559px) {
      .ct__title, .ct__desc { min-height: 0; }
  }
</style>
