---
// CatalogCard (home): card de exploración por categoría — trajes
// (TR-0n) y complementos del conjunto (EQ-0n). Tres estados:
//  · con href  → toda la card es clicable (enlace "estirado" sobre
//    el H3, sin anidar <a>); los enlaces `extra` quedan por encima.
//  · sin href  → categoría sin página todavía: NO se inventa URL;
//    etiqueta «Catálogo en preparación» y CTA de WhatsApp (waUrl).
//  · sin image → placeholder explícito «Imagen pendiente».
// Regla del sitio: cero animaciones/transiciones. En móvil (<640)
// pasa a card horizontal compacta para recorrer las 12 sin fatiga.
import { WA_MESSAGES } from '@config/site';
import { waUrl } from '@lib/wa';

interface Props {
  codigo: string;
  titulo: string;
  operacion: string;
  prefijo?: 'Operación' | 'Uso';
  desc: string;
  image?: { src: string; alt: string; width: number; height: number };
  chips?: string[];
  meta?: string;
  badge?: string;
  href?: string;
  ctaLabel: 'Ver equipo' | 'Conocer la categoría' | 'Solicitar cotización';
  waNombre?: string;
  extra?: { label: string; href: string }[];
}
const {
  codigo,
  titulo,
  operacion,
  prefijo = 'Operación',
  desc,
  image,
  chips = [],
  meta,
  badge,
  href,
  ctaLabel,
  waNombre = titulo,
  extra = [],
} = Astro.props as Props;
const pendiente = !href;
const wa = waUrl(WA_MESSAGES.categoria(waNombre));
---
<article class:list={['cc', { 'cc--pendiente': pendiente }]}>
  <div class="cc__media">
    {image ? (
      <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
    ) : (
      <div class="cc__placeholder" role="img" aria-label={`Imagen pendiente de ${titulo}`}>
        <strong>{codigo}</strong>
        <span>Imagen pendiente</span>
      </div>
    )}
    <span class="cc__code" aria-hidden="true">{codigo}</span>
    {badge && <span class="cc__badge">{badge}</span>}
  </div>

  <div class="cc__body">
    <p class="cc__op"><span>{prefijo} ·</span> {operacion}</p>
    <h3>
      {href ? <a class="cc__link" href={href}>{titulo}</a> : titulo}
    </h3>
    {pendiente && <p class="cc__status">Catálogo en preparación</p>}
    <p class="cc__desc">{desc}</p>
    {chips.length > 0 && (
      <ul class="cc__chips" aria-label="Incluye">
        {chips.slice(0, 3).map((c) => <li class="chip">{c}</li>)}
      </ul>
    )}
    {meta && <p class="cc__meta">{meta}</p>}
    {extra.length > 0 && (
      <p class="cc__extra">
        <span>También:</span>
        {extra.slice(0, 2).map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
    )}
    <div class="cc__cta">
      {href ? (
        <span aria-hidden="true">{ctaLabel}</span>
      ) : (
        <a href={wa} target="_blank" rel="noopener nofollow" aria-label={`Solicitar cotización de ${titulo} por WhatsApp (se abre en otra pestaña)`}>
          {ctaLabel}
        </a>
      )}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </div>
  </div>
</article>

<style>
  .cc {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-white);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cc:hover { border-color: rgb(200 16 46 / 0.55); box-shadow: var(--shadow); }
  .cc:focus-within { outline: 3px solid var(--color-primary); outline-offset: 3px; }

  /* Media 4:3 con código técnico y franja reflejante inferior */
  .cc__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-gray-light);
    overflow: hidden;
  }
  .cc__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .cc__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: repeating-linear-gradient(115deg, var(--color-accent) 0 14px, var(--color-ink) 14px 28px);
  }
  .cc__code,
  .cc__badge {
    position: absolute;
    top: 0.7rem;
    padding: 0.3rem 0.5rem;
    font: 800 0.72rem/1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
  }
  .cc__code { left: 0.7rem; background: var(--color-ink); color: var(--color-white); }
  .cc__badge { right: 0.7rem; background: var(--color-accent); color: var(--color-ink); }
  .cc__placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    gap: 0.25rem;
    text-align: center;
    color: var(--color-gray);
    font-size: 0.8rem;
    background: repeating-linear-gradient(45deg, var(--color-light) 0 12px, var(--color-gray-light) 12px 24px);
  }
  .cc__placeholder strong { font: 800 2rem/1 var(--font-display); color: var(--color-ink); }

  .cc__body { display: flex; flex: 1; flex-direction: column; gap: 0.5rem; padding: 1.15rem 1.25rem 0; }
  .cc__op {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .cc__op span { color: var(--color-gray); }
  h3 { margin: 0; font: 800 1.28rem/1.12 var(--font-display); color: var(--color-dark); }
  .cc__link { color: inherit; text-decoration: none; }
  /* Enlace estirado: toda la card es clicable sin anidar <a> */
  .cc__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .cc__link:focus-visible { outline: none; }
  .cc__status {
    align-self: flex-start;
    margin: 0;
    padding: 0.22rem 0.5rem;
    background: var(--color-light);
    border: 1px dashed var(--color-gray-soft);
    color: var(--color-dark);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .cc__desc { margin: 0; color: var(--color-gray); font-size: 0.9rem; line-height: 1.55; }
  .cc__chips { display: flex; flex-wrap: wrap; gap: 0.32rem; margin: 0.1rem 0 0; padding: 0; list-style: none; }
  .cc__meta {
    margin: auto 0 0;
    padding-top: 0.3rem;
    color: var(--color-dark);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .cc__meta::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.45rem;
    background: var(--color-primary);
    vertical-align: 0.05em;
  }
  .cc__extra {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.8rem;
    margin: 0;
    font-size: 0.8rem;
  }
  .cc__extra span { color: var(--color-gray); }
  .cc__extra a { font-weight: 800; min-height: 32px; display: inline-flex; align-items: center; }
  .cc__cta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.6rem -1.25rem 0;
    padding: 0.85rem 1.25rem;
    border-top: var(--border);
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 800;
    min-height: 48px;
  }
  .cc__cta a { color: var(--color-primary); text-decoration: none; }
  .cc__cta a::after { content: ''; position: absolute; inset: 0; }
  .cc--pendiente .cc__cta { background: var(--color-light); margin-top: auto; }
  /* Sin fila meta: los enlaces "También" bajan al pie para alinear el CTA */
  .cc__body:not(:has(.cc__meta)) .cc__extra { margin-top: auto; }

  /* Móvil: card horizontal compacta */
  @media (max-width: 639px) {
    .cc { display: grid; grid-template-columns: 108px minmax(0, 1fr); }
    .cc__media { aspect-ratio: auto; min-height: 100%; }
    .cc__media img { position: absolute; inset: 0; }
    .cc__media::after { inset: 0 0 0 auto; width: 5px; height: auto; }
    .cc__badge { display: none; }
    .cc__code { top: 0.4rem; left: 0.4rem; font-size: 0.62rem; }
    .cc__placeholder strong { font-size: 1.3rem; }
    .cc__body { gap: 0.3rem; padding: 0.8rem 0.85rem 0; }
    .cc__op { font-size: 0.66rem; }
    h3 { font-size: 1.05rem; }
    .cc__desc {
      font-size: 0.84rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .cc__chips, .cc__extra { display: none; }
    .cc__meta { font-size: 0.72rem; }
    .cc__cta { margin: 0.4rem -0.85rem 0; padding: 0.6rem 0.85rem; min-height: 44px; font-size: 0.84rem; }
  }
</style>
