---
// TileGrid: rejilla única de cards del index — 4 por fila en escritorio,
// 2 en tablet, 1 en móvil. Los hijos son <TileCard> (elementos <li>).
interface Props { cols?: 3 | 4; }
const { cols = 4 } = Astro.props as Props;
---
<ul class:list={['ct-grid', { 'ct-grid--3': cols === 3 }]}><slot /></ul>

<style>
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ct-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1279px) { .ct-grid { gap: 1rem; } }
  @media (max-width: 1023px) { .ct-grid, .ct-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 559px) { .ct-grid, .ct-grid--3 { grid-template-columns: 1fr; } }
</style>
