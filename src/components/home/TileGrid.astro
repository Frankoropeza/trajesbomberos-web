---
// TileGrid: rejilla única de cards del index — 4 por fila en escritorio,
// 2 en tablet, 1 en móvil. Los hijos son <TileCard> (elementos <li>).
---
<ul class="ct-grid"><slot /></ul>

<style>
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 1279px) { .ct-grid { gap: 1rem; } }
  @media (max-width: 1023px) { .ct-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 559px) { .ct-grid { grid-template-columns: 1fr; } }
</style>
