---
// CategoryTiles (home): índice de las 12 categorías del catálogo.
// Diseño en <TileCard>/<TileGrid> (compartido con todo el index).
// Todos los textos de botón son palabra clave (nunca "ver", "ir").
// Cada href se valida contra las rutas reales del build: si una
// subcategoría deja de existir, se omite y se avisa en consola.
// Regla del sitio: cero animaciones/transiciones.
import { tilesCategorias } from '@lib/catalogo/categorias';
import TileGrid from './TileGrid.astro';
import TileCard from './TileCard.astro';

const items = tilesCategorias();
---
<TileGrid>
  {items.map((c) => <TileCard {...c} />)}
</TileGrid>
