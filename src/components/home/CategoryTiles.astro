---
// CategoryTiles (home): índice visual de TODAS las categorías del
// catálogo, 4 cards por fila en desktop (2 en tablet, 1 en móvil).
// Va arriba del grid de familias de traje. Solo enlaza rutas que
// existen en build (getSeccion / PRODUCT_CATEGORIES): nunca inventa
// una URL. Regla del sitio: cero animaciones/transiciones.
import { getSeccion } from '@lib/catalogo/secciones';
import { tiposDeSeccion } from '@lib/catalogo/tipos';
import { MODELOS } from '@lib/catalogo/data';
import { piezasDeFamilia } from '@lib/piezas';
import { PRODUCT_CATEGORIES } from '@config/site';

interface Def {
  titulo: string;
  desc: string;
  href: string;
  img: string;
  alt: string;
  seccion?: string; // hub del catálogo: define existencia y conteo
  meta?: string;    // conteo fijo cuando no es hub de catálogo
}

const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const piezasHazmat = piezasDeFamilia('hazmat').length;

const DEFS: Def[] = [
  { titulo: 'Trajes para bomberos', desc: 'Estructural, brigadista, forestal, aproximación, entrada y extricación.', href: '/trajes/', img: '/images/catalogo/trajes/skold-hero-pbimax-conjunto.avif', alt: 'Traje estructural para bombero de chaquetón y pantalonera', meta: plural(PRODUCT_CATEGORIES.length, 'familia', 'familias') },
  { titulo: 'Cascos para bomberos', desc: 'Estructural tradicional y europeo, forestal, rescate y brigada.', href: '/cascos/', seccion: 'cascos', img: '/images/catalogo/cascos/hero-cascos-800.avif', alt: 'Cascos para bombero estructurales, forestales y de rescate' },
  { titulo: 'Equipo de respiración autónoma', desc: 'ERA de combate, industrial y de escape, máscaras y cilindros.', href: '/equipo-de-respiracion-autonoma/', seccion: 'equipo-de-respiracion-autonoma', img: '/images/catalogo/era/hero-era-800.avif', alt: 'Equipo de respiración autónoma para bombero con máscara y cilindro' },
  { titulo: 'Botas para bomberos', desc: 'Hule o piel estructural, forestal y de brigada industrial.', href: '/botas/', seccion: 'botas', img: '/images/catalogo/botas/hero-botas-800.avif', alt: 'Botas para bombero de hule y de piel' },
  { titulo: 'Guantes para bomberos', desc: 'Estructurales, de extricación, forestales y de brigadista.', href: '/guantes/', seccion: 'guantes', img: '/images/catalogo/guantes/hero-guantes-800.avif', alt: 'Guantes para bombero estructurales y de extricación' },
  { titulo: 'Monjas y escafandras', desc: 'Protección de cabeza y cuello bajo el casco, con o sin barrera.', href: '/capuchas/', seccion: 'capuchas', img: '/images/catalogo/capuchas/hero-capuchas-800.avif', alt: 'Monjas y escafandras para bombero' },
  { titulo: 'Kits para bomberos', desc: 'Conjuntos completos estructural, brigadista y forestal.', href: '/kits/', seccion: 'kits', img: '/images/catalogo/kits/hero-kits-800.avif', alt: 'Kit completo de equipo para bombero' },
  { titulo: 'Trajes Hazmat', desc: 'Protección química niveles A, B y C, guantes y botas químicas.', href: '/trajes/hazmat/', img: '/images/catalogo/hazmat/hero-hazmat-800.avif', alt: 'Trajes de protección química Hazmat', meta: plural(piezasHazmat, 'pieza cotizable', 'piezas cotizables') },
  { titulo: 'Equipo de rescate', desc: 'Extricación hidráulica, cuerdas, arneses y rescate vertical.', href: '/rescate/', seccion: 'rescate', img: '/images/catalogo/rescate/hero-rescate-800.avif', alt: 'Equipo de rescate para bomberos: cuerdas, arneses y herramienta hidráulica' },
  { titulo: 'Herramientas para bomberos', desc: 'Entrada forzada y combate forestal: Halligan, hachas y más.', href: '/herramientas/', seccion: 'herramientas', img: '/images/catalogo/herramientas/hero-herramientas-800.avif', alt: 'Herramientas para bombero de entrada forzada' },
  { titulo: 'Mangueras y accesorios', desc: 'Manguera de ataque, pitones, conexiones y llaves de hidrante.', href: '/mangueras-y-accesorios/', seccion: 'mangueras-y-accesorios', img: '/images/catalogo/mangueras/hero-mangueras-800.avif', alt: 'Mangueras contra incendio y accesorios' },
  { titulo: 'Accesorios para bomberos', desc: 'Linternas, lámparas de casco, goggles, PASS y cámara térmica.', href: '/accesorios/', seccion: 'accesorios', img: '/images/catalogo/accesorios/hero-accesorios-800.avif', alt: 'Accesorios para bombero: linterna, goggles y cámara térmica' },
];

const items = DEFS.filter((d) => !d.seccion || getSeccion(d.seccion)).map((d, i) => {
  let meta = d.meta ?? '';
  if (d.seccion) {
    const tipos = tiposDeSeccion(d.seccion).length;
    const modelos = MODELOS.filter((m) => m.seccion === d.seccion).length;
    meta = [tipos > 0 ? plural(tipos, 'tipo', 'tipos') : '', modelos > 0 ? plural(modelos, 'modelo', 'modelos') : ''].filter(Boolean).join(' · ');
  }
  return { ...d, meta, codigo: String(i + 1).padStart(2, '0') };
});
---
<ul class="ct-grid">
  {items.map((c) => (
    <li class="ct">
      <div class="ct__media">
        <img src={c.img} alt={c.alt} width="800" height="600" loading="lazy" decoding="async" />
        <span class="ct__code" aria-hidden="true">{c.codigo}</span>
      </div>
      <div class="ct__body">
        <h3 class="ct__title"><a href={c.href}>{c.titulo}</a></h3>
        <p class="ct__desc">{c.desc}</p>
        {c.meta && <p class="ct__meta">{c.meta}</p>}
        <span class="ct__cta" aria-hidden="true">Ver categoría →</span>
      </div>
    </li>
  ))}
</ul>

<style>
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap-grid, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ct {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid rgb(20 22 26 / 0.14);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ct:hover { border-color: var(--color-primary); }
  .ct:focus-within { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .ct__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-light);
    border-bottom: 1px solid rgb(20 22 26 / 0.1);
  }
  .ct__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }
  .ct__code {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.15rem 0.45rem;
    background: var(--color-dark);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border-radius: 2px;
  }
  .ct__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    padding: 1rem 1.1rem 1.1rem;
  }
  .ct__title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .ct__title a { color: var(--color-dark); text-decoration: none; }
  /* Enlace estirado: toda la card es clicable sin anidar <a>. */
  .ct__title a::after { content: ''; position: absolute; inset: 0; }
  .ct__title a:focus-visible { outline: none; }
  .ct:hover .ct__title a { color: var(--color-primary); }
  .ct__desc {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-gray);
  }
  .ct__meta {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-dark);
  }
  .ct__cta {
    margin-top: auto;
    padding-top: 0.35rem;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--color-primary);
  }

  @media (max-width: 1023px) {
    .ct-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 479px) {
    .ct-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
