---
// BlogSidebar: columna de apoyo del blog, sin scroll propio.
//  · indice / categoria → Guías esenciales (con miniatura; prioriza
//    los artículos que NO están en la página actual) + Familias de
//    traje + tarjeta de cotización. Fluye con la página.
//  · articulo → índice numerado con scrollspy y barra de progreso
//    + cotización compacta. Sticky.
// Las categorías viven en las tabs de BlogListado, no aquí.
import { PRODUCT_CATEGORIES, CONTACT, WA_MESSAGES } from '@config/site';
import { waUrl } from '@lib/wa';
import { getPosts, postUrl, categoriaNombre } from '@lib/blog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
type Variant = 'articulo' | 'indice' | 'categoria';
interface Props {
  variant?: Variant;
  headings?: Heading[];
  currentId?: string;
  currentCategoria?: string;
  visiblePostIds?: string[];
  waMessage?: string;
}
const {
  variant = 'indice',
  headings = [],
  currentId,
  visiblePostIds = [],
  waMessage = WA_MESSAGES.cotizar,
} = Astro.props;
const esArticulo = variant === 'articulo';
const toc = esArticulo ? headings.filter((heading) => heading.depth === 2) : [];
const todos = await getPosts();
const excluidos = new Set([...visiblePostIds, ...(currentId ? [currentId] : [])]);
const destacado = todos.find((post) => post.data.destacado);
const guias = esArticulo
  ? []
  : [
      ...(destacado && !excluidos.has(destacado.id) ? [destacado] : []),
      ...todos.filter((post) => post.id !== destacado?.id && !excluidos.has(post.id)),
    ].slice(0, 4);
const quoteTitle = esArticulo
  ? '¿Cotizas equipo para tu corporación o brigada?'
  : '¿Cotizas equipo para tu corporación o brigada?';
---

<aside
  class:list={['sidebar', esArticulo ? 'sidebar--sticky' : 'sidebar--flow']}
  aria-label="Navegación del blog"
>
  {toc.length > 0 && (
    <nav class="sb-block sb-block--toc" aria-label="Índice del artículo">
      <div class="sb-progress" aria-hidden="true">
        <span data-reading-progress></span>
      </div>
      <p class="sb-title">En este artículo</p>
      <ol class="sb-anchors" id="blog-toc">
        {toc.map((heading, index) => (
          <li>
            <a href={`#${heading.slug}`} data-toc={heading.slug}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
  {guias.length > 0 && (
    <nav class="sb-block" aria-label="Guías esenciales">
      <p class="sb-title">Guías esenciales</p>
      <ul class="sb-posts">
        {guias.map((post) => (
          <li>
            <a href={postUrl(post)}>
              <img src={post.data.imagen} alt="" width="72" height="54" loading="lazy" decoding="async" />
              <span>
                <span class="sb-posts__cat">{categoriaNombre(post.data.categoria)}</span>
                <span class="sb-posts__title">{post.data.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {!esArticulo && (
    <nav class="sb-block" aria-label="Familias de traje">
      <p class="sb-title">Familias de traje</p>
      <ul class="sb-familias">
        {PRODUCT_CATEGORIES.map((category) => (
          <li>
            <a href={`/trajes/${category.slug}/`}>
              <span>{category.nombre}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="sb-more" href="/trajes/">
        Comparar trajes para bomberos →
      </a>
    </nav>
  )}
  <div class:list={['sb-quote', { 'sb-quote--compact': esArticulo }]}>
    <p class="sb-quote__title">{quoteTitle}</p>
    <p class="sb-quote__text">Te mandamos ficha técnica con partidas y condiciones de entrega por escrito.</p>
    {!esArticulo && (
      <ul class="sb-quote__list">
        <li>Ficha técnica por partida</li>
        <li>Expediente para licitación</li>
        <li>Envío a todo México</li>
      </ul>
    )}
    <a class="sb-quote__wa" href={waUrl(waMessage)} target="_blank" rel="noopener nofollow">
      Cotizar trajes por WhatsApp
    </a>
    <a class="sb-quote__tel" href={`tel:${CONTACT.telefonoHref}`}>
      {CONTACT.telefono}
    </a>
    <p class="sb-quote__horario">{CONTACT.horario}</p>
  </div>
</aside>

<style>
  .sidebar {
    display: grid;
    gap: 1.35rem;
    align-self: start;
    min-width: 0;
  }
  .sidebar--sticky {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }
  .sb-block {
    padding: 0;
    border: 0;
    background: transparent;
  }
  .sb-title {
    margin: 0 0 0.75rem;
    padding-bottom: 0.55rem;
    border-bottom: var(--border);
    color: var(--color-gray-soft);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .sb-posts,
  .sb-familias,
  .sb-anchors {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sb-posts li + li,
  .sb-familias li + li {
    border-top: var(--border);
  }
  .sb-posts a {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.65rem 0;
    color: var(--color-dark);
    text-decoration: none;
  }
  .sb-posts li:first-child a {
    padding-top: 0;
  }
  .sb-posts li:last-child a {
    padding-bottom: 0;
  }
  .sb-posts img {
    width: 72px;
    height: 54px;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .sb-posts a > span {
    display: grid;
    align-content: center;
    gap: 0.16rem;
    min-width: 0;
  }
  .sb-posts__cat {
    color: var(--color-primary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .sb-posts__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .sb-posts a:hover .sb-posts__title {
    color: var(--color-primary);
  }
  .sb-familias a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: 0.5rem;
    color: var(--color-dark);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .sb-familias a:hover,
  .sb-more:hover {
    color: var(--color-primary);
  }
  .sb-more {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-primary);
    font-size: var(--fs-sm);
    font-weight: 800;
    text-decoration: none;
  }
  .sb-progress {
    height: 3px;
    margin-bottom: 0.75rem;
    overflow: hidden;
    background: var(--color-gray-light);
  }
  .sb-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-primary);
  }
  .sb-anchors {
    counter-reset: toc;
    max-height: min(36vh, 330px);
    overflow-y: auto;
    scrollbar-width: thin;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 1.2rem), transparent);
  }
  .sb-anchors a {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.35rem;
    min-height: 40px;
    padding: 0.42rem 0.25rem 0.42rem 0.6rem;
    border-left: 2px solid var(--color-gray-light);
    color: var(--color-gray);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }
  .sb-anchors a > span {
    color: var(--color-gray-soft);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
  }
  .sb-anchors a:hover,
  .sb-anchors a.is-reading {
    border-left-color: var(--color-primary);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }
  .sb-quote {
    position: relative;
    overflow: hidden;
    padding: 1.35rem 1.2rem;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
  }
  .sb-quote::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-primary);
    content: '';
  }
  .sb-quote__title {
    margin: 0.35rem 0 0.45rem;
    color: var(--color-white);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.16;
  }
  .sb-quote__text {
    margin: 0 0 0.85rem;
    color: #b9bec5;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .sb-quote__list {
    display: grid;
    gap: 0.38rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    color: #d7dbe0;
    font-size: var(--fs-xs);
  }
  .sb-quote__list li::before {
    margin-right: 0.45rem;
    color: var(--color-accent);
    content: '✓';
    font-weight: 800;
  }
  .sb-quote__wa {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.65rem;
    border-radius: var(--radius);
    background: var(--color-wa);
    color: var(--color-white);
    font-size: var(--fs-sm);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }
  .sb-quote__wa:hover {
    background: var(--color-wa-dark);
  }
  .sb-quote__tel {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-accent);
    font-size: 0.95rem;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }
  .sb-quote__horario {
    margin: 0.2rem 0 0;
    color: #b9bec5;
    font-size: var(--fs-xs);
    text-align: center;
  }
  .sb-quote--compact {
    padding: 1.1rem;
  }
  @media (max-width: 1024px) {
    .sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sidebar--sticky {
      position: static;
    }
    .sb-quote {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toc = document.getElementById('blog-toc');
  const article = document.getElementById('articulo');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[data-toc]').forEach((link) => {
      if (link.dataset.toc) links.set(link.dataset.toc, link);
    });
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((node): node is HTMLElement => Boolean(node));
    let active = '';
    const mark = (id: string) => {
      if (id !== active) {
        active = id;
        links.forEach((link, key) => link.classList.toggle('is-reading', key === id));
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible?.target.id) mark(visible.target.id);
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
    );
    targets.forEach((target) => observer.observe(target));
  }
  if (article && !reduceMotion) {
    const bars = document.querySelectorAll<HTMLElement>('[data-reading-progress]');
    let queued = false;
    const update = () => {
      queued = false;
      const rect = article.getBoundingClientRect();
      const range = Math.max(1, article.offsetHeight - window.innerHeight * 0.45);
      const value = Math.min(100, Math.max(0, ((-rect.top + window.innerHeight * 0.2) / range) * 100));
      bars.forEach((bar) => {
        bar.style.width = `${value}%`;
      });
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    request();
  }
</script>
