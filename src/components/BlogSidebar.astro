---
import { responsive, SIZES } from '@lib/img';
// BlogSidebar: columna de apoyo del blog, sin scroll propio.
//  · indice / categoria → Buscar, Guías esenciales, Temas, comprador,
//    cotización, norma, equipo y familias. Fluye con la página.
//  · articulo → cotización, más guías, equipo, norma e índice al final.
//    Solo el índice sticky en escritorio; se oculta en pantallas bajas.
import { CONTACT, MARCA, PRODUCT_CATEGORIES, WA_MESSAGES } from '@config/site';
import { waUrl } from '@lib/wa';
import { categoriasConConteo, categoriaNombre, getPosts, postUrl, type Post } from '@lib/blog';
import {
  anclaCorta,
  equipoCatalogo,
  equipoDeArticulo,
  guiasPorComprador,
  guiasPorNorma,
} from '@lib/blog-enlaces';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  variant?: 'articulo' | 'indice' | 'categoria' | 'legal'; // legal: índice sticky + cotización (aviso y términos)
  headings?: Heading[];
  currentId?: string;
  currentCategoria?: string;
  post?: Post;
  relatedPosts?: Post[];
  visiblePostIds?: string[];
  waMessage?: string;
  tocTitle?: string;
}
const {
  variant = 'indice',
  headings = [],
  currentId,
  currentCategoria,
  post,
  relatedPosts = [],
  visiblePostIds = [],
  waMessage = WA_MESSAGES.cotizar,
  tocTitle = 'En este artículo',
} = Astro.props;
const esArticulo = variant === 'articulo' || variant === 'legal';
const todos = await getPosts();
const categorias = await categoriasConConteo();
const categoriaActual = currentCategoria ?? Astro.url.pathname.match(/\/categoria\/([^/]+)/)?.[1];
const excluidos = new Set([...visiblePostIds, ...(currentId ? [currentId] : [])]);
const destacado = todos.find((item) => item.data.destacado);
const esenciales = esArticulo
  ? []
  : [
      ...(destacado && !excluidos.has(destacado.id) ? [destacado] : []),
      ...todos.filter((item) => item.id !== destacado?.id && !excluidos.has(item.id)),
    ].slice(0, 4);
const mismas = post
  ? todos.filter((item) => item.id !== post.id && item.data.categoria === post.data.categoria)
  : [];
const masGuias = [...mismas, ...relatedPosts.filter((item) => item.id !== currentId)]
  .filter((item, index, list) => list.findIndex((other) => other.id === item.id) === index)
  .slice(0, 4);
const normas = guiasPorNorma(todos).filter(({ post: item }) => item.id !== currentId);
const compradores = guiasPorComprador(todos).map(({ segmento, posts }) => ({
  segmento,
  posts: posts.filter((item) => item.id !== currentId),
}));
const equipo = post ? equipoDeArticulo(post) : [];
const toc = esArticulo ? headings.filter((heading) => heading.depth === 2) : [];
---

<aside class:list={['sidebar', esArticulo && 'sidebar--article']} aria-label="Navegación del blog">
  <!-- Buscar en el blog. -->
  {!esArticulo && (
    <nav class="sb-block" aria-label="Buscar en el blog">
      <p class="sb-title">Buscar en el blog</p>
      <label for="blog-search">Busca una guía técnica</label>
      <input id="blog-search" type="search" placeholder="Casco, NFPA 1970, licitación…" />
      <p data-search-status aria-live="polite"></p>
      <ul data-search-results hidden>
        {todos.map((item) => (
          <li
            data-search-item
            data-search={`${item.data.title} ${item.data.resumen} ${item.data.keywords.join(' ')}`}
          >
            <a href={postUrl(item)}>
              {item.data.title}
              <small>{categoriaNombre(item.data.categoria)}</small>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- Guías esenciales o más guías de la categoría. -->
  {(esArticulo ? masGuias : esenciales).length > 0 && (
    <nav class="sb-block" aria-label={esArticulo ? 'Más guías del tema' : 'Guías esenciales'}>
      <p class="sb-title">
        {esArticulo ? `Más guías de ${categoriaNombre(post?.data.categoria ?? '')}` : 'Guías esenciales'}
      </p>
      <ul class="sb-posts">
        {(esArticulo ? masGuias : esenciales).map((item) => (
          <li>
            <a href={postUrl(item)}>
              <img src={item.data.imagen} {...responsive(item.data.imagen, SIZES.thumb)} alt="" width="72" height="54" loading="lazy" decoding="async" />
              <span>
                <small>{categoriaNombre(item.data.categoria)}</small>
                {item.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- Temas del blog. -->
  {!esArticulo && (
    <nav class="sb-block" aria-label="Temas del blog">
      <p class="sb-title">Temas del blog</p>
      <ul class="sb-rows">
        {categorias.map((categoria) => (
          <li>
            <a
              href={`/blog/categoria/${categoria.slug}/`}
              aria-current={categoria.slug === categoriaActual ? 'page' : undefined}
            >
              <span>
                <strong>{categoria.nombre}</strong>
                <small>{categoria.desc}</small>
              </span>
              <b>{categoria.total}</b>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- Guías por tipo de comprador. -->
  {!esArticulo && (
    <nav class="sb-block" aria-label="Guías por tipo de comprador">
      <p class="sb-title">Guías por tipo de comprador</p>
      {compradores.map(
        ({ segmento, posts }) =>
          posts.length > 0 && (
            <section class="sb-buyer">
              <p>{segmento.titulo}</p>
              <ul class="sb-links">
                {posts.map((item) => (
                  <li>
                    <a href={postUrl(item)}>
                      {anclaCorta(item)} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ),
      )}
    </nav>
  )}

  <!-- Tarjeta de cotización. -->
  <div class="sb-quote">
    <p>¿Cotizas equipo para tu corporación o brigada?</p>
    <small>{MARCA.nombre} suma {MARCA.experiencia} de experiencia y manda ficha técnica con partidas y condiciones de entrega por escrito.</small>
    {!esArticulo && (
      <ul>
        <li>Ficha técnica por partida</li>
        <li>Expediente para licitación</li>
        <li>Entrega en los 32 estados</li>
      </ul>
    )}
    <a class="sb-wa" href={waUrl(waMessage)} target="_blank" rel="noopener nofollow">
      Cotizar trajes por WhatsApp
    </a>
    <a class="sb-tel" href={`tel:${CONTACT.telefonoHref}`}>
      {CONTACT.telefono}
    </a>
    <small>{CONTACT.horario}</small>
  </div>

  <!-- Guías por norma y material. -->
  <nav class="sb-block" aria-label="Guías por norma y material">
    <p class="sb-title">Guías por norma y material</p>
    <ul class="sb-rows">
      {normas.slice(0, esArticulo ? 3 : undefined).map((guia) => (
        <li>
          <a href={postUrl(guia.post)}>
            <span>
              <strong>{guia.etiqueta}</strong>
              <small>{guia.desc}</small>
            </span>
            <b aria-hidden="true">→</b>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Equipo de esta guía. -->
  {esArticulo && equipo.length > 0 && (
    <nav class="sb-block" aria-label="Equipo de esta guía">
      <p class="sb-title">Equipo de esta guía</p>
      <ul class="sb-links">
        {equipo.map((item) => (
          <li>
            <a href={item.href}>
              {item.nombre} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- Equipo para bomberos. -->
  {!esArticulo && (
    <nav class="sb-block" aria-label="Equipo para bomberos">
      <p class="sb-title">Equipo para bomberos</p>
      <ul class="sb-links">
        {equipoCatalogo().map((item) => (
          <li>
            <a href={item.href}>
              {item.nombre} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="sb-more" href="/marcas/">
        Marcas de equipo para bomberos →
      </a>
    </nav>
  )}

  <!-- Familias de traje. -->
  {!esArticulo && (
    <nav class="sb-block" aria-label="Familias de traje">
      <p class="sb-title">Familias de traje</p>
      <ul class="sb-links">
        {PRODUCT_CATEGORIES.map((item) => (
          <li>
            <a href={`/trajes/${item.slug}/`}>
              {item.nombre} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="sb-more" href="/trajes/">
        Comparar trajes para bomberos →
      </a>
    </nav>
  )}

  <!-- Índice del artículo: último bloque y único sticky. -->
  {toc.length > 0 && (
    <nav class="sb-block sb-toc" aria-label="Índice del artículo">
      <div class="sb-progress">
        <span data-reading-progress></span>
      </div>
      <p class="sb-title">{tocTitle}</p>
      <ol id="blog-toc">
        {toc.map((heading, index) => (
          <li>
            <a href={`#${heading.slug}`} data-toc={heading.slug}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
</aside>

<style>
  .sidebar {
    display: grid;
    gap: 1.35rem;
    align-self: start;
    min-width: 0;
  }
  .sb-title {
    margin: 0 0 0.75rem;
    padding-bottom: 0.55rem;
    border-bottom: var(--border);
    color: var(--color-gray-soft);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .sidebar ul,
  .sidebar ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sidebar li + li {
    border-top: var(--border);
  }
  /* El atributo hidden debe ganarle a los display de las listas. */
  /* Descripción de cada tema en una sola línea: el bloque no crece. */
  .sb-rows small {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  .sidebar [hidden] {
    display: none !important;
  }
  .sidebar label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-gray);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  input {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.7rem;
    border: var(--border);
    border-radius: var(--radius);
    font: inherit;
  }
  input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  [data-search-status] {
    min-height: 1.25rem;
    margin: 0.5rem 0 0;
    color: var(--color-gray);
    font-size: var(--fs-xs);
  }
  [data-search-results] a {
    display: grid;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0.55rem 0;
  }
  .sidebar a {
    color: var(--color-dark);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .sidebar a:hover,
  .sb-more:hover {
    color: var(--color-primary);
  }
  .sidebar small {
    color: var(--color-gray);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.35;
  }
  .sb-posts a {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 0.7rem;
    min-height: 67px;
    padding: 0.65rem 0;
  }
  .sb-posts img {
    width: 72px;
    height: 54px;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .sb-posts a > span {
    display: grid;
    align-content: center;
    gap: 0.16rem;
  }
  .sb-posts small {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .sb-rows a,
  .sb-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: 0.65rem;
  }
  .sb-rows a > span {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }
  .sb-rows b,
  .sb-links span {
    color: var(--color-primary);
  }
  .sb-rows a[aria-current='page'] {
    border-left: 3px solid var(--color-primary);
    padding-left: 0.55rem;
    color: var(--color-primary);
  }
  .sb-buyer + .sb-buyer {
    margin-top: 0.85rem;
  }
  .sb-buyer > p {
    margin: 0;
    color: var(--color-gray-soft);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sb-more {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-primary);
    font-size: var(--fs-sm);
    font-weight: 800;
  }
  .sb-quote {
    position: relative;
    overflow: hidden;
    padding: 1.35rem 1.2rem;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
  }
  .sb-quote::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-primary);
    content: '';
  }
  .sb-quote > p {
    margin: 0.35rem 0 0.45rem;
    color: var(--color-white);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.16;
  }
  .sb-quote > small,
  .sb-quote li {
    display: block;
    color: #b9bec5;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .sb-quote li + li {
    border-top: 0;
  }
  .sb-quote ul {
    gap: 0.38rem;
    margin: 0.85rem 0;
  }
  .sb-quote li::before {
    margin-right: 0.45rem;
    color: var(--color-accent);
    content: '✓';
  }
  .sb-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.65rem;
    border-radius: var(--radius);
    background: var(--color-wa);
    color: var(--color-white) !important;
    text-align: center;
  }
  .sb-tel {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-accent) !important;
    text-align: center;
  }
  .sb-progress {
    height: 3px;
    margin-bottom: 0.75rem;
    overflow: hidden;
    background: var(--color-gray-light);
  }
  .sb-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-primary);
  }
  .sb-toc a {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.35rem;
    min-height: 34px;
    padding: 0.32rem 0.25rem 0.32rem 0.6rem;
    border-left: 2px solid var(--color-gray-light);
    color: var(--color-gray);
    line-height: 1.35;
  }
  .sb-toc a > span {
    color: var(--color-gray);  /* 6:1 también sobre el fondo rosa del activo */
    font-size: 0.75rem;
  }
  .sb-toc a:hover,
  .sb-toc a.is-reading {
    border-left-color: var(--color-primary);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }
  @media (min-width: 1024px) {
    .sidebar--article {
      display: flex;
      flex-direction: column;
      align-self: stretch;
    }
    .sidebar--article .sb-toc {
      position: sticky;
      top: calc(var(--sticky-offset) + 1.5rem);
    }
  }
  @media (max-width: 1023px) {
    .sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sidebar--article .sb-toc {
      display: none;
    }
    .sb-quote {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 639px) {
    .sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  const input = document.querySelector<HTMLInputElement>('#blog-search');
  const results = document.querySelector<HTMLUListElement>('[data-search-results]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const items = [...document.querySelectorAll<HTMLLIElement>('[data-search-item]')];
  const clear = () => {
    if (input) input.value = '';
    if (results) results.hidden = true;
    if (status) status.textContent = '';
    items.forEach((item) => {
      item.hidden = false;
    });
  };
  input?.addEventListener('input', () => {
    const query = normalize(input.value.trim());
    if (query.length < 2) return clear();
    const matches = items.filter((item) => normalize(item.dataset.search ?? '').includes(query));
    // Máximo 6 visibles, contados sobre las coincidencias (no sobre la lista completa).
    const visibles = new Set(matches.slice(0, 6));
    items.forEach((item) => {
      item.hidden = !visibles.has(item);
    });
    if (results) results.hidden = false;
    if (status)
      status.textContent = matches.length
        ? `${Math.min(matches.length, 6)} resultado${matches.length === 1 ? '' : 's'}`
        : 'Sin resultados: prueba con “traje estructural”';
  });
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') clear();
  });
  const toc = document.getElementById('blog-toc');
  const article = document.getElementById('articulo');
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[data-toc]').forEach((link) => {
      if (link.dataset.toc) links.set(link.dataset.toc, link);
    });
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((node): node is HTMLElement => Boolean(node));
    // Scrollspy: la sección activa es el último H2 que ya cruzó el 30 %
    // superior de la pantalla. Por posición y no por IntersectionObserver
    // para que un salto largo (clic en el índice, tecla Fin) no deje
    // marcada una sección vieja.
    let spyQueued = false;
    const spy = () => {
      spyQueued = false;
      const limite = window.innerHeight * 0.3;
      const actual = targets.filter((target) => target.getBoundingClientRect().top <= limite).pop();
      const id = actual?.id ?? targets[0]?.id;
      links.forEach((link, key) => link.classList.toggle('is-reading', key === id));
    };
    const requestSpy = () => {
      if (!spyQueued) {
        spyQueued = true;
        requestAnimationFrame(spy);
      }
    };
    window.addEventListener('scroll', requestSpy, { passive: true });
    window.addEventListener('resize', requestSpy, { passive: true });
    requestSpy();
  }
  if (article && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const bars = document.querySelectorAll<HTMLElement>('[data-reading-progress]');
    const update = () => {
      const rect = article.getBoundingClientRect();
      const range = Math.max(1, article.offsetHeight - window.innerHeight * 0.45);
      const value = Math.min(100, Math.max(0, ((-rect.top + window.innerHeight * 0.2) / range) * 100));
      bars.forEach((bar) => {
        bar.style.width = `${value}%`;
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
