---
import { responsive, SIZES } from '@lib/img';
// PostCard: tarjeta de artículo. Mismo lenguaje que TileCard
// (imagen 4:3 a sangre con código BL-NN, acento rojo superior,
// título y resumen a 3 líneas, botón rojo al pie). Botón en una
// línea: «Guía: {ancla}» (frontmatter `ancla`, o el título antes
// de «:»). Sin fecha: blog atemporal. NO emite schema (regla B3).
// Variante "wide": destacado, imagen + panel a dos columnas.
import { categoriaNombre } from '@lib/blog';
import { anclaCorta } from '@lib/blog-enlaces';

interface Props {
  href: string;
  title: string;
  resumen: string;
  categoria: string;
  lectura: number;
  fecha?: Date;
  image?: string;
  imageAlt?: string;
  destacado?: boolean;
  wide?: boolean;
  index?: number;
  ancla?: string;
}

const {
  href,
  title,
  resumen,
  categoria,
  lectura,
  image,
  imageAlt = '',
  destacado = false,
  wide = false,
  index = 0,
  ancla,
} = Astro.props;
const ctaAncla = anclaCorta({ data: { ancla, title } });
const ctaCompleto = `Guía: ${ctaAncla}`;
---

<a
  class:list={['post-card', { 'post-card--wide': wide }]}
  href={href}
  title={ctaCompleto}
>
  {image && (
    <span class="post-card__media">
      <img
        class="post-card__image"
        src={image}
        {...responsive(image, SIZES.tile)}
        alt={imageAlt}
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
      />
      {!wide && (
        <span class="post-card__code" aria-hidden="true">
          BL-{String(index + 1).padStart(2, '0')}
        </span>
      )}
    </span>
  )}
  <span class="post-card__content">
    <span class="post-card__head">
      <span class="post-card__cat">{categoriaNombre(categoria)}</span>
      {destacado && <span class="post-card__badge">Destacado</span>}
    </span>
    <span class="post-card__title">{title}</span>
    <span class="post-card__resumen">{resumen}</span>
    <span class="post-card__foot">
      <span class="post-card__meta">{lectura} min de lectura</span>
      <span class="post-card__cta">
        <span>{ctaCompleto}</span>
        <span aria-hidden="true">→</span>
      </span>
    </span>
  </span>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-white);
    border: var(--border);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius);
    color: var(--color-dark);
    overflow: hidden;
    text-decoration: none;
  }
  .post-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-light);
    overflow: hidden;
  }
  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
  }
  .post-card__code {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.3rem 0.65rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
  }
  .post-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1rem 1.15rem 1.2rem;
    min-width: 0;
  }
  .post-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-card__cat {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
  }
  .post-card__badge {
    padding: 0.14rem 0.5rem;
    border-radius: 2px;
    background: var(--color-accent);
    color: var(--color-dark);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-card__title {
    display: -webkit-box;
    min-height: calc(1.08rem * 1.25 * 3);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .post-card__resumen {
    display: -webkit-box;
    flex: 1;
    min-height: calc(0.87rem * 1.5 * 3);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-gray);
    font-size: 0.87rem;
    line-height: 1.5;
  }
  .post-card__foot {
    display: grid;
    gap: 0.9rem;
    margin-top: auto;
  }
  .post-card__meta {
    display: flex;
    align-items: center;
    min-height: 44px;
    border-top: var(--border);
    border-bottom: var(--border);
    color: var(--color-gray);
    font-size: 0.76rem;
    font-weight: 600;
  }
  .post-card__cta {
    display: flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    min-height: 46px;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }
  .post-card__cta > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .post-card:hover .post-card__title {
    color: var(--color-primary);
  }
  .post-card:hover .post-card__cta {
    background: var(--color-dark);
    border-color: var(--color-dark);
  }
  .post-card--wide {
    display: grid;
    grid-template-columns: minmax(0, 1.38fr) minmax(0, 1fr);
  }
  .post-card--wide .post-card__media {
    aspect-ratio: auto;
    min-height: 100%;
  }
  .post-card--wide .post-card__content {
    padding: clamp(1.4rem, 2.4vw, 2.4rem);
    background: var(--color-ink);
  }
  .post-card--wide .post-card__cat {
    color: var(--color-accent);
  }
  .post-card--wide .post-card__title {
    display: block;
    min-height: 0;
    color: var(--color-white);
    font-size: clamp(1.6rem, 2.4vw, 2.25rem);
    line-height: 1.08;
  }
  .post-card--wide .post-card__resumen {
    display: block;
    min-height: 0;
    color: #b9bec5;
    font-size: 0.95rem;
  }
  .post-card--wide .post-card__meta {
    border-color: rgb(255 255 255 / 0.2);
    color: #b9bec5;
  }
  .post-card--wide .post-card__cta {
    background: var(--color-primary);
  }
  .post-card--wide:hover .post-card__cta {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
  }
  @media (max-width: 1023px) {
    .post-card--wide {
      grid-template-columns: 1fr;
    }
    .post-card--wide .post-card__media {
      aspect-ratio: 16 / 9;
    }
  }
</style>
