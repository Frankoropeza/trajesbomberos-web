---
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import SpecTable from '@components/SpecTable.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import CTABanner from '@components/CTABanner.astro';
import NormaBadge from '@components/NormaBadge.astro';
import { tiposDeSeccion } from '@lib/catalogo/tipos';
import { modelosDeFamilia, modelosDeSeccion, modelosDeTipo, urlModelo } from '@lib/catalogo/modelos';
import { MODELOS } from '@lib/catalogo/data';
import type { Modelo, Seccion, Tipo } from '@lib/catalogo/types';
import { waUrl } from '@lib/wa';
import { FAMILIAS } from '@lib/familias';
import { piezasDeFamilia } from '@lib/piezas';

interface Props { seccion: Seccion; entry: Tipo | Modelo; kind: 'tipo' | 'modelo'; path: string; parent?: { name: string; href: string } | { name: string; href: string }[]; heroImage?: { src: string; alt: string }; }
const { seccion, entry, kind, path, parent, heroImage = seccion.hero } = Astro.props;
const isTipo = kind === 'tipo';
const tipo = entry as Tipo;
const modelo = entry as Modelo;
const nombre = isTipo ? tipo.nombre : `${modelo.marca} ${modelo.nombre}`;
const rows = isTipo ? (tipo.especificacion ?? []) : [
  { campo: 'Marca', valor: modelo.marca }, { campo: 'Fabricante', valor: modelo.fabricante },
  ...(modelo.codigo ? [{ campo: 'Código', valor: modelo.codigo }] : []), ...(modelo.codigoNota ? [{ campo: 'Código', valor: modelo.codigoNota }] : []),
  ...(modelo.tipo ? [{ campo: 'Tipo', valor: tiposDeSeccion(seccion.slug).find((item) => item.slug === modelo.tipo)?.nombre ?? modelo.tipo }] : []),
  ...(modelo.material || modelo.capaExterior ? [{ campo: 'Material / capa exterior', valor: modelo.material ?? modelo.capaExterior! }] : []), ...(modelo.barreras ? [{ campo: 'Barreras', valor: modelo.barreras }] : []),
  ...(modelo.colores ? [{ campo: 'Colores', valor: modelo.colores }] : []), ...(modelo.tallas ? [{ campo: 'Tallas', valor: modelo.tallas }] : []), ...(modelo.peso ? [{ campo: 'Peso', valor: modelo.peso }] : []),
  ...(modelo.norma ? [{ campo: 'Norma declarada', valor: modelo.norma }] : []), { campo: 'Estatus', valor: ({ 'certificado-ul': 'Certificado por laboratorio UL', declarado: 'Declarado por el fabricante', equivalente: 'Equivalente declarado, no certificado', materiales: 'Materiales conformes a la norma', niosh: 'Certificación NIOSH (uso industrial)', 'sin-norma': 'Sin norma publicada', 'no-aplica': 'No aplica' } as Record<string, string>)[modelo.estatusNorma] ?? modelo.estatusNorma }, ...(modelo.certificacion ? [{ campo: 'Certificación', valor: modelo.certificacion }] : [])
];
const image = isTipo ? tipo.imagen : modelo.imagen;
const extras = isTipo ? [] : modelo.imagenesExtra ?? [];
const related = !isTipo ? (modelo.familia ? modelosDeFamilia(modelo.familia).filter((item) => item.id !== modelo.id) : modelo.tipo ? modelosDeTipo(modelo.tipo).filter((item) => item.id !== modelo.id) : []) : [];
const modelosMarca = isTipo && seccion.slug === 'marcas' ? MODELOS.filter((item) => item.marca === tipo.nombre) : [];
const familiaModelo = !isTipo && modelo.familia ? FAMILIAS.find((familia) => familia.slug === modelo.familia) : undefined;
const piezasFamilia = familiaModelo ? piezasDeFamilia(familiaModelo.slug) : [];
const modelosSidebar = familiaModelo ? modelosDeFamilia(familiaModelo.slug) : modelosDeSeccion(seccion.slug);
const primeraFrase = (texto: string) => texto.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() ?? texto;
const recortarPalabras = (texto: string, limite: number) => texto.length <= limite ? texto : texto.slice(0, limite + 1).replace(/\s+\S*$/, '').trim();
const tituloModeloBase = isTipo ? '' : `${modelo.marca} ${modelo.nombre} | ${seccion.nombre}`;
const tituloModelo = isTipo ? '' : modelo.title ?? (tituloModeloBase.length <= 60 ? tituloModeloBase : `${modelo.marca} ${modelo.nombre} | TrajesBombero`);
const llamadaCotizacion = 'Cotiza por WhatsApp con envío a todo México.';
const descripcionModelo = isTipo ? '' : modelo.description ?? recortarPalabras(`${recortarPalabras(primeraFrase(modelo.resumen?.[0] ?? modelo.descripcion[0]), 160 - llamadaCotizacion.length - 1)} ${llamadaCotizacion}`, 160);
const modeloPorId = (id: string) => MODELOS.find((item) => item.id === id)!;
const componentesKit = isTipo && seccion.slug === 'kits' ? {
  'kit-estructural': [
    { nombre: 'Bullard LTX', href: urlModelo(modeloPorId('bullard-ltx')) }, { nombre: 'Croydon Filtrex', href: urlModelo(modeloPorId('croydon-filtrex')) }, { nombre: 'Veridian Fire Pro II', href: urlModelo(modeloPorId('veridian-fire-pro-ii')) }, { nombre: 'Majestic PAC II', href: urlModelo(modeloPorId('majestic-pac-ii')) },
  ],
  'kit-brigadista': [
    { nombre: 'Bullard LTX', href: urlModelo(modeloPorId('bullard-ltx')) }, { nombre: 'Romak CAP1005', href: urlModelo(modeloPorId('romak-cap1005')) }, { nombre: 'Romak Firemax VI', href: urlModelo(modeloPorId('romak-firemax-vi')) }, { nombre: 'Romak Workman Fire', href: urlModelo(modeloPorId('romak-workman-fire')) },
  ],
  'kit-forestal': [
    { nombre: 'Fire Ranger Explorer', href: urlModelo(modeloPorId('romak-fire-ranger-explorer')) }, { nombre: 'Romak BOMW1002', href: urlModelo(modeloPorId('romak-bomw1002')) }, { nombre: 'Bullard Wildland FH911H', href: urlModelo(modeloPorId('bullard-fh911h')) }, { nombre: 'ESS Striketeam XTO', href: urlModelo(modeloPorId('ess-striketeam-xto')) },
  ],
}[tipo.slug] ?? [] : [];
// Keyword del clúster en eyebrow y H1 de los modelos de traje:
// «Romak Fire Protector · traje de bombero estructural».
const KW_FAMILIA: Record<string, string> = { estructural: 'traje de bombero estructural', brigadista: 'traje de bombero brigadista', forestal: 'traje de bombero forestal', aproximacion: 'traje de bombero de aproximación', entrada: 'traje de bombero de entrada', extricacion: 'traje de extricación y rescate', hazmat: 'traje hazmat' };
const kwFamilia = familiaModelo ? KW_FAMILIA[familiaModelo.slug] : undefined;
const eyebrowFicha = isTipo ? `Tipo · ${seccion.nombre}` : kwFamilia ? `Modelo · ${kwFamilia}` : `Modelo · ${seccion.nombre}`;
const h1Accent = !isTipo && kwFamilia ? `· ${kwFamilia}` : undefined;
const copy = isTipo ? tipo.bloques : [{ h2: `Acerca de ${nombre}`, parrafos: modelo.descripcion, lista: modelo.caracteristicas }];
const waMessage = `Hola, quiero cotizar ${nombre}${!isTipo && modelo.codigo ? ` ${modelo.codigo}` : ''}.`;
const waFicha = `Hola, quiero la ficha técnica de ${nombre}${!isTipo && modelo.codigo ? ` ${modelo.codigo}` : ''}.`;
// Ficha rápida del modelo (arriba, junto a la foto): lo que el comprador compara primero.
const rapida = isTipo ? [] : [
  ['Marca', modelo.marca],
  ...(modelo.codigo ? [['Código', modelo.codigo]] : modelo.codigoNota ? [['Código', modelo.codigoNota]] : []),
  ...(modelo.material || modelo.capaExterior ? [['Capa exterior / material', modelo.material ?? modelo.capaExterior!]] : []),
  ...(modelo.barreras ? [['Barreras', modelo.barreras]] : []),
  ...(modelo.colores ? [['Colores', modelo.colores]] : []),
  ...(modelo.tallas ? [['Tallas', modelo.tallas]] : []),
  ...(modelo.peso ? [['Peso', modelo.peso]] : []),
] as [string, string][];
const resumenExtra = !isTipo && modelo.resumen ? modelo.resumen.slice(1) : [];
---
<PageLayout pageType="producto" path={path} title={isTipo ? tipo.title : tituloModelo} description={isTipo ? tipo.description : descripcionModelo} crumbLabel={nombre} parent={parent ?? { name: seccion.nombre, href: `/${seccion.slug}/` }} eyebrow={eyebrowFicha} h1={nombre} h1Accent={h1Accent} lead={isTipo ? tipo.lead : modelo.resumen?.[0] ?? modelo.descripcion[0]} descRight={isTipo ? tipo.resumen ?? [] : []} heroImage={heroImage} faqs={isTipo ? tipo.faq : modelo.faq} item={{ name: nombre, description: isTipo ? tipo.description : descripcionModelo, image: image?.src, category: seccion.nombre, url: path }} menuItems={[{ label: 'A fondo', href: '#a-fondo' }, { label: 'Especificación', href: '#ficha' }, { label: 'Preguntas', href: '#faq' }]}>
  {!isTipo && <Fragment slot="hero-badge"><NormaBadge estatus={modelo.estatusNorma} norma={modelo.norma} certificacion={modelo.certificacion} /></Fragment>}
  {!isTipo && (
    <div class="section producto"><div class="container">
      <div class="producto__grid">
        <div class="producto__galeria">
          {image ? (
            <figure class="producto__foto"><img src={image.src} alt={image.alt} width={'width' in image ? image.width : undefined} height={'height' in image ? image.height : undefined} loading="eager" fetchpriority="high" decoding="async" />
              <figcaption>{image.origen === 'proveedor' ? 'Imagen del fabricante. La configuración exacta se confirma por escrito en la cotización.' : (seccion.leyendaImagenIlustrativa ?? 'Imagen ilustrativa. Marca, modelo y configuración exactos se confirman por escrito en la cotización.')}</figcaption>
            </figure>
          ) : (
            <div class="producto__pendiente" role="img" aria-label={`Imagen pendiente de ${nombre}`}>Imagen pendiente</div>
          )}
          {extras.length > 0 && <div class="producto__extras">{extras.map((extra) => <img src={extra.src} alt={extra.alt} width={extra.width} height={extra.height} loading="lazy" decoding="async" />)}</div>}
        </div>
        <aside class="producto__panel" aria-label="Ficha rápida">
          <p class="eyebrow">Ficha rápida</p>
          <NormaBadge estatus={modelo.estatusNorma} norma={modelo.norma} certificacion={modelo.certificacion} />
          <dl class="producto__datos">{rapida.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          {resumenExtra.map((p) => <p class="producto__nota">{p}</p>)}
          <div class="producto__cta">
            <a class="producto__wa" href={waUrl(waMessage)} target="_blank" rel="noopener nofollow"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z" /></svg>Cotizar por WhatsApp</a>
            <a class="producto__ficha" href={waUrl(waFicha)} target="_blank" rel="noopener nofollow">Pedir ficha técnica</a>
          </div>
          <p class="producto__aviso">Sin compra mínima · Factura CFDI 4.0 · Envío a los 32 estados</p>
        </aside>
      </div>
    </div></div>
  )}
  <div class="section"><div class="container layout"><main>
    <section class="block first" id="a-fondo"><div class:list={['detail', { 'detail--solo': !isTipo }]}>
      <div class="copy"><p class="eyebrow">{isTipo ? 'Qué es' : 'Modelo y configuración'}</p>{copy.slice(0, 1).map((block) => <><h2>{block.h2}</h2>{block.parrafos.map((paragraph) => <p>{paragraph}</p>)}{block.lista && <ul>{block.lista.map((item) => <li>{item}</li>)}</ul>}</>)}</div>
      {isTipo && image && <div class="gallery"><figure><img src={image.src} alt={image.alt} width={'width' in image ? image.width : undefined} height={'height' in image ? image.height : undefined} />{image.origen === 'proveedor' ? <figcaption>Imagen del fabricante. La configuración exacta se confirma por escrito en la cotización.</figcaption> : <figcaption>{seccion.leyendaImagenIlustrativa ?? 'Imagen ilustrativa. Marca, modelo y configuración exactos se confirman por escrito en la cotización.'}</figcaption>}</figure>{extras.map((extra) => <figure><img src={extra.src} alt={extra.alt} width={extra.width} height={extra.height} loading="lazy" /><figcaption>Imagen del fabricante. La configuración exacta se confirma por escrito en la cotización.</figcaption></figure>)}</div>}
    </div>{copy.slice(1).map((block) => <div class="prose"><h2>{block.h2}</h2>{block.parrafos.map((paragraph) => <p>{paragraph}</p>)}{block.lista && <ul>{block.lista.map((item) => <li>{item}</li>)}</ul>}</div>)}</section>
    <section class="block" id="ficha"><SectionHeading eyebrow="Ficha técnica" title={isTipo ? 'Datos para tu requisición' : 'Especificación disponible'} /><SpecTable grupos={[{ grupo: isTipo ? 'Tipo' : 'Modelo', filas: rows }]} />{isTipo && tipo.normas?.map((norma) => <p class="norma"><strong>{norma.norma}</strong> — {norma.alcance}</p>)}</section>
    {!isTipo && <section class="block"><SectionHeading eyebrow="Configuración" title={`Características de ${nombre}`} /><ul class="features">{modelo.caracteristicas.map((item) => <li>{item}</li>)}</ul></section>}
    {isTipo && tipo.errores && <section class="block"><SectionHeading eyebrow="Antes de comprar" title="Errores que conviene evitar" /><ul class="features">{tipo.errores.map((item) => <li>{item}</li>)}</ul></section>}
    {!isTipo && seccion.checklistCompra && <p class="text">{modelo.notaCompra ?? <><strong>Antes de ordenar:</strong> revisa la lista de verificación de <a href={`/${seccion.slug}/#antes-de-ordenar`}>{seccion.nombre.toLowerCase()}</a> para que la cotización llegue completa.</>}</p>}
    {related.length > 0 && <section class="block"><SectionHeading eyebrow={modelo.familia ? 'Misma familia' : 'Mismo tipo'} title="Otros modelos disponibles" /><div class="cards">{related.map((item) => <a href={urlModelo(item)}><img src={item.imagen?.src} alt={item.imagen?.alt} width={item.imagen?.width} height={item.imagen?.height} loading="lazy" /><h2>{item.marca} {item.nombre}</h2><NormaBadge estatus={item.estatusNorma} norma={item.norma} certificacion={item.certificacion} /></a>)}</div></section>}
    {modelosMarca.length > 0 && <section class="block"><SectionHeading eyebrow="Modelos publicados" title={`Modelos ${tipo.nombre} disponibles`} /><div class="cards">{modelosMarca.map((item) => <a href={urlModelo(item)}><img src={item.imagen?.src} alt={item.imagen?.alt} width={item.imagen?.width} height={item.imagen?.height} loading="lazy" /><h2>{item.marca} {item.nombre}</h2><NormaBadge estatus={item.estatusNorma} norma={item.norma} certificacion={item.certificacion} /></a>)}</div></section>}
    {componentesKit.length > 0 && <section class="block"><SectionHeading eyebrow="Componentes de referencia" title="Modelos que integran este kit" /><ul class="features">{componentesKit.map((item) => <li><a href={item.href}>{item.nombre}</a></li>)}</ul></section>}
    <section class="block" id="faq"><SectionHeading eyebrow="Preguntas frecuentes" title={`Dudas sobre ${nombre}`} /><FAQWithContact items={isTipo ? tipo.faq : modelo.faq} /></section>
  </main><aside>{familiaModelo ? <><p class="side-title">{familiaModelo.nombreWa}</p><nav><a href={`/trajes/${familiaModelo.slug}/`}>Ver familia</a>{piezasFamilia.map((pieza) => <a href={`/trajes/${familiaModelo.slug}/${pieza.slug}/`}>{pieza.nombreCard}</a>)}{modelosSidebar.map((item) => <a class:list={{ active: item.id === modelo.id }} href={urlModelo(item)}>{item.marca} {item.nombre}</a>)}</nav></> : <><p class="side-title">{seccion.nombre}</p><nav><a href={`/${seccion.slug}/`}>Ver catálogo</a>{tiposDeSeccion(seccion.slug).map((item) => <a class:list={{ active: isTipo ? item.slug === tipo.slug : item.slug === modelo.tipo }} href={`/${seccion.slug}/${item.slug}/`}>{item.nombreCard}</a>)}{modelosSidebar.map((item) => <a class:list={{ active: !isTipo && item.id === modelo.id }} href={urlModelo(item)}>{item.marca} {item.nombre}</a>)}</nav></>}</aside></div></div>
  <CTABanner variant="dark" title={`Cotiza ${nombre}`} text="Indica operación, número de elementos y accesorios para confirmar por escrito la configuración." buttons={[{ label: 'Cotizar por WhatsApp', href: waUrl(waMessage), icon: 'wa', primary: true, external: true }, { label: `Volver a ${seccion.nombre.toLowerCase()}`, href: `/${seccion.slug}/`, icon: 'catalog' }]} />
</PageLayout>
<style>
 .producto{padding-block:clamp(1.6rem,3vw,2.6rem) 0}.producto__grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:clamp(1.5rem,3vw,3rem);align-items:start}.producto__foto{margin:0;background:var(--color-light);border:var(--border);border-radius:var(--radius-lg);overflow:hidden}.producto__foto img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:contain;background:#fff}.producto__foto figcaption{padding:.6rem .9rem;font-size:.78rem;color:var(--color-gray);border-top:var(--border)}.producto__pendiente{display:grid;place-content:center;aspect-ratio:4/5;border:1px dashed var(--color-gray-soft);color:var(--color-gray);font-weight:700}.producto__extras{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin-top:.6rem}.producto__extras img{width:100%;aspect-ratio:1;object-fit:contain;background:#fff;border:var(--border);border-radius:var(--radius)}.producto__panel{position:sticky;top:calc(var(--header-height) + 1rem);padding:1.3rem 1.4rem 1.4rem;background:var(--color-white);border:var(--border);border-top:4px solid var(--color-primary);border-radius:var(--radius-lg)}.producto__panel .norma-badge{margin-top:.4rem}.producto__datos{display:grid;margin:1rem 0 0;border-top:var(--border)}.producto__datos div{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.6fr);gap:.8rem;padding:.55rem 0;border-bottom:var(--border)}.producto__datos dt{margin:0;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:var(--color-gray)}.producto__datos dd{margin:0;font-size:.9rem;color:var(--color-dark)}.producto__nota{margin:.9rem 0 0;font-size:.86rem;color:var(--color-gray);line-height:1.55}.producto__cta{display:grid;gap:.6rem;margin-top:1.1rem}.producto__cta a{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:50px;padding:.7rem 1.2rem;border-radius:var(--radius);font-weight:800;text-decoration:none}.producto__cta .producto__wa{background:var(--color-wa);color:#fff}.producto__cta .producto__wa:hover{background:var(--color-wa-dark)}.producto__cta .producto__ficha{border:2px solid var(--color-primary);color:var(--color-primary)}.producto__ficha:hover{background:var(--color-primary-light)}.producto__aviso{margin:.8rem 0 0;font-size:.76rem;color:var(--color-gray);text-align:center}.detail--solo{grid-template-columns:1fr}.detail--solo .copy p{max-width:78ch}@media(max-width:900px){.producto__grid{grid-template-columns:1fr}.producto__panel{position:static}}.layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:clamp(2rem,4vw,4rem)}.block{padding-block:2.8rem;border-top:var(--border)}.first{padding-top:0;border-top:0}.detail{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:2rem}.copy p,.prose p,.text{color:var(--color-gray);line-height:1.72}.copy li,.prose li,.features li{color:var(--color-gray);line-height:1.6;margin-block:.55rem}.eyebrow,.side-title{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:var(--tracking-wide);color:var(--color-primary)}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;align-content:start}.gallery figure:first-child{grid-column:1/-1}.gallery figure+figure figcaption{display:none}.gallery figure+figure img{aspect-ratio:1/1;border:var(--border)}.gallery figure{margin:0}.gallery img{width:100%;aspect-ratio:4/5;object-fit:cover;background:var(--color-light);border-radius:var(--radius)}figcaption,.norma{font-size:.8rem;color:var(--color-gray);line-height:1.45}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.cards a{border:var(--border);border-radius:var(--radius);overflow:hidden;color:var(--color-dark);text-decoration:none;padding-bottom:1rem}.cards img{width:100%;aspect-ratio:4/3;object-fit:cover}.cards h2,.cards .norma-badge{margin-inline:1rem}.cards h2{font-size:1rem}aside{position:sticky;top:calc(var(--header-height) + 1rem);height:max-content}aside nav{display:grid;border-top:var(--border)}aside a{padding:.6rem .7rem;color:var(--color-dark);text-decoration:none;border-bottom:var(--border);font-size:.88rem}aside a.active{border-left:3px solid var(--color-primary);color:var(--color-primary);font-weight:800;background:var(--color-primary-light)}.layout>*,.detail>*,.gallery,.gallery figure{min-width:0}.gallery img,.cards img{max-width:100%;height:auto}@media(max-width:900px){.layout{grid-template-columns:1fr}.detail{grid-template-columns:1fr}.gallery{order:-1}.cards{grid-template-columns:1fr}aside{position:static;order:2}}
</style>
