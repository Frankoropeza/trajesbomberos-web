---
// SectionMenu: franja de navegación bajo el hero. Data-driven desde
// NAV (misma fuente del Header). El último botón es el CTA de
// conversión (WhatsApp): "el hero presenta, la franja convierte".
import { WA_MESSAGES } from '@config/site';
import { waUrl } from '@lib/wa';

interface Props {
  items?: { label: string; href: string }[];
  cta?: { label: string; mensaje: string };  // botón propio de la página; por defecto, el genérico
}
const { items, cta } = Astro.props;
---
{items && items.length > 0 && <nav class="section-menu" aria-label="Navegación de página">
  <div class="container section-menu__inner">
    <ul class="section-menu__list">
      {items.map((item) => (
        <li><a href={item.href} data-section-link={item.href.startsWith('#') ? item.href.slice(1) : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <a class="section-menu__cta" href={waUrl(cta?.mensaje ?? WA_MESSAGES.cotizar)} target="_blank" rel="noopener nofollow">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.6.2-.8l.4-.5c.1-.2.1-.3.2-.5s0-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.9.9-1.2 2-.8 3.2a11.4 11.4 0 0 0 4.3 5.2c1.6 1 2.8 1.4 3.8 1.2.8-.1 1.7-.7 2-1.4.2-.6.2-1.2.1-1.3-.1-.2-.3-.2-.7-.4z"/></svg>
      <span>{cta?.label ?? 'Cotizar por WhatsApp'}</span>
    </a>
  </div>
</nav>}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
  const sections = links
    .map((link) => ({ link, target: document.getElementById(link.dataset.sectionLink ?? '') }))
    .filter((entry): entry is { link: HTMLAnchorElement; target: HTMLElement } => Boolean(entry.target));

  if (sections.length > 0) {
    const updateActive = (id?: string) => sections.forEach(({ link, target }) => {
      const active = target.id === id;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) updateActive((visible.target as HTMLElement).id);
    }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
    sections.forEach(({ target }) => observer.observe(target));
  }
</script>

<style>
  .section-menu {
    background: var(--color-white);
    border-bottom: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .section-menu__inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 56px;
  }
  .section-menu__list {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .section-menu__list li { display: flex; }
  .section-menu__list a {
    display: flex;
    align-items: center;
    padding: 0 1.1rem;
    text-decoration: none;
    color: var(--color-gray);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    border-bottom: 3px solid transparent;
    min-height: 44px;
    white-space: nowrap;
  }
  .section-menu__list li:first-child a { padding-left: 0; }
  .section-menu__list a.is-active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .section-menu__list::-webkit-scrollbar { display: none; }
  .section-menu__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    padding: 0.65rem 1rem;
    margin-block: 0.35rem;
    background: var(--color-wa);
    color: #fff;
    text-decoration: none;
    border-radius: var(--radius);
    flex-shrink: 0;
  }
  @media (hover: hover) {
    .section-menu__list a:hover { color: var(--color-primary); }
    .section-menu__cta:hover { background: var(--color-wa-dark); }
  }
  .section-menu__cta span { white-space: nowrap; font-size: 0.9rem; font-weight: 800; }

  @media (max-width: 1023px) {
    .section-menu__inner { gap: 0; }
    .section-menu__cta { display: none; }
  }
</style>
