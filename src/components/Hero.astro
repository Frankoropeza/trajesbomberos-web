---
// Hero canónico del sitio — idéntico en L1, L2 y L3.
// Dos columnas al 50/50: izquierda title + accent (H1 ÚNICO, con la kw
// principal), subtitle y fila de datos duros; derecha descRight[]
// como panel de contexto. Los CTA no viven aquí: "el hero
// presenta, la franja convierte" (van en SectionMenu, debajo).
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  subtitle: string;
  descRight: string[];
  meta?: string[];
  image?: { src: string; alt: string };
  /** Fondo de color sólido: sin imagen, sin degradados y sin banda reflejante. */
  solid?: boolean;
}
const { eyebrow, title, accent, subtitle, descRight, meta = [], image, solid = false } = Astro.props;
---
<section class:list={['hero', { 'hero--solid': solid }]}>
  {image && <img class="hero__bg" src={image.src} srcset={`${image.src.replace(/\.avif$/, '-800.avif')} 800w, ${image.src} 1600w`} sizes="100vw" alt={image.alt} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />}
  {image && <div class="hero__veil" aria-hidden="true"></div>}
  {!solid && <div class="hero__stripes" aria-hidden="true"></div>}
  <div class:list={['container hero-grid', { 'hero-grid--single': descRight.length === 0 }]}>
    <div class="hero-left">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1>{title}{accent && <> <span class="hero-accent">{accent}</span></>}</h1>
      <slot name="badge" />
      <p class="hero-subtitle">{subtitle}</p>
      {meta.length > 0 && (
        <ul class="hero-meta">
          {meta.map((m) => <li>{m}</li>)}
        </ul>
      )}<slot name="actions" />
    </div>
    {descRight.length > 0 && (
      <div class="hero-right">
        <div class="hero-panel">
          {descRight.map((p) => <p>{p}</p>)}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 82% 0%, rgba(200, 16, 46, 0.28) 0%, transparent 62%),
      linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
    color: var(--color-white);
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }
  .hero--solid { background: var(--color-ink); }
  .hero__bg, .hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__bg { object-fit: cover; object-position: center right; }
  .hero__veil {
    background:
      radial-gradient(120% 100% at 82% 0%, rgba(200, 16, 46, 0.28) 0%, transparent 62%),
      linear-gradient(90deg, rgba(15, 18, 22, .94) 0%, rgba(15, 18, 22, .86) 42%, rgba(15, 18, 22, .62) 100%);
  }
  /* Banda reflectante de alta visibilidad (código visual bombero) */
  .hero__stripes {
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: repeating-linear-gradient(
      115deg,
      var(--color-accent) 0 26px,
      var(--color-ink-soft) 26px 52px
    );
    opacity: 0.9;
    z-index: 2;
  }
  /* Dos columnas al 50 % exacto del ancho útil. El separador vive
     en el centro del gap (no pegado al texto) para que ambas
     mitades pesen lo mismo visualmente. */
  .hero-grid {
    --hero-gap: clamp(3rem, 7vw, 8rem);
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--hero-gap);
    align-items: center;
    z-index: 1;
  }
  .hero-grid--single { grid-template-columns: minmax(0, 1fr); max-width: 60rem; }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font-size: var(--fs-xs);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }
  .hero__eyebrow::before {
    content: '';
    width: 28px;
    height: 3px;
    background: var(--color-accent);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }
  .hero-accent { color: var(--color-accent); }
  .hero-subtitle {
    font-size: var(--fs-lead);
    color: #c8ccd2;
    margin: 0;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1.5rem;
    list-style: none;
    margin: 1.7rem 0 0;
    padding: 1.2rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #d6dae0;
  }
  .hero-meta li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-left .hero-subtitle { max-width: none; }
  .hero-right { position: relative; align-self: stretch; display: flex; align-items: center; }
  .hero-right::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--hero-gap) / -2);
    width: 1px;
    background: linear-gradient(180deg, transparent 0%, rgb(255 255 255 / 0.16) 18%, rgb(255 255 255 / 0.16) 82%, transparent 100%);
  }
  /* Acento rojo centrado sobre el separador (sustituye el borde
     izquierdo del panel: un solo divisor, no dos). */
  .hero-right::after {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--hero-gap) / -2 - 1px);
    width: 3px;
    height: 4.5rem;
    transform: translateY(-50%);
    background: var(--color-primary);
  }
  .hero-panel { padding: 0; }
  .hero-subtitle, .hero-panel p { text-wrap: pretty; }
  .hero-panel p {
    color: #c3c8cf;
    font-size: var(--fs-lead);
    line-height: 1.65;
    margin: 0 0 1.15rem;
  }
  .hero-panel p:last-child { margin-bottom: 0; }

  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-right::before, .hero-right::after { display: none; }
    .hero-panel { border-left: 0; border-top: 3px solid var(--color-primary); padding: 1.2rem 0 0; }
    .hero-panel p { font-size: var(--fs-body); }
  }
  @media (max-width: 767px) { .hero__veil { background: rgba(15, 18, 22, .88); } }
</style>
