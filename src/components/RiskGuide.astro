---
// RiskGuide: tabla de guía de selección (3–4 filas) con nota y CTA.
// Encabezados configurables vía prop columns. Responsive con
// scroll horizontal en móvil. Oro para SEO de cola larga y para
// calificar al prospecto antes de cotizar.
import { WA_MESSAGES } from '@config/site';
import { waUrl } from '@lib/wa';

interface Props {
  columns: string[];
  rows: (string | { texto: string; href?: string })[][];
  note?: string;
  ctaLabel?: string;
  caption?: string;
  ariaLabel?: string;
  waMensaje?: string;
  sinCta?: boolean;
}
const { columns, rows, note, ctaLabel = 'Cotizar trajes por WhatsApp', caption, ariaLabel = 'Guía de selección', waMensaje = WA_MESSAGES.cotizar, sinCta = false } = Astro.props;
const contenidoCelda = (cell: Props['rows'][number][number]) => typeof cell === 'string' ? cell : cell.texto;
const enlaceCelda = (cell: Props['rows'][number][number]) => typeof cell === 'string' ? undefined : cell.href;
---
<div class="riskguide">
  <div class="riskguide__scroll table-scroll" tabindex="0" role="region" aria-label={ariaLabel}>
    <table>
      {caption && <caption class="riskguide__caption">{caption}</caption>}
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.map((cell, i) => {
              const href = enlaceCelda(cell);
              const contenido = href ? <a href={href}>{contenidoCelda(cell)}</a> : contenidoCelda(cell);
              return i === 0 ? <th scope="row">{contenido}</th> : <td>{contenido}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="riskguide__note">{note}</p>}
  {!sinCta && <a class="btn btn--wa" href={waUrl(waMensaje)} target="_blank" rel="noopener nofollow">{ctaLabel}</a>}
</div>

<style>
  .riskguide__scroll { overflow-x: auto; margin-bottom: 1.4rem; border: var(--border); border-radius: var(--radius-lg); }
  table { width: 100%; border-collapse: collapse; min-width: 720px; background: var(--color-white); }
  th, td { padding: 1.05rem 1.3rem; text-align: left; border-bottom: var(--border); font-size: 0.92rem; vertical-align: top; }
  thead th {
    background: var(--color-ink);
    color: var(--color-white);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-weight: 800;
  }
  tbody th { color: var(--color-primary); font-weight: 800; white-space: nowrap; font-size: 1rem; }
  th a, td a { color: var(--color-primary); font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
  .riskguide__caption { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (hover: hover) { tbody tr:hover { background: var(--color-light); } }
  td { color: var(--color-gray); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  .riskguide__note { color: var(--color-gray); font-size: 0.88rem; margin: 0 0 1.4rem; max-width: 68ch; }
</style>
